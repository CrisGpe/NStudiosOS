3 rounded-xl border border-zinc-800/80 flex items-center justify-between text-xs hover:border-zinc-700 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-2 h-2 rounded-full bg-indigo-500 shrink-0\" />\n                <div>\n                  <span className=\"font-bold text-zinc-200\">{log.action}</span>\n                  <span className=\"text-zinc-400 ml-2 font-mono text-[11px]\">{log.entity}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-4 text-zinc-400 text-[11px]\">\n                <span>Por: <strong className=\"text-zinc-300\">{log.performedBy}</strong></span>\n                <span className=\"font-mono text-zinc-500\">{log.timestamp}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
