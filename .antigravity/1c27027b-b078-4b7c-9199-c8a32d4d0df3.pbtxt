    end_line: 422
    content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Deliverable,\n  TechnicalGuide,\n  ShotItem,\n} from \'../types\';\nimport {\n  Film,\n  Camera,\n  Layers,\n  Sparkles,\n  Sliders,\n  Volume2,\n  Sun,\n  Tv,\n  CheckCircle2,\n  AlertCircle,\n  Plus,\n  Trash2,\n  Edit3,\n  FileCheck2,\n} from \'lucide-react\';\n\ninterface TechnicalGuideViewerProps {\n  deliverable: Deliverable;\n  onUpdate?: (guide: TechnicalGuide) => void;\n}\n\nexport const TechnicalGuideViewer: React.FC<TechnicalGuideViewerProps> = ({\n  deliverable,\n  onUpdate,\n}) => {\n  const { updateTechnicalGuide, currentUser, brands, openAiModalWithContext } = useApp();\n  const [guide, setGuide] = useState<TechnicalGuide>(deliverable.technicalGuide);\n  const [isEditingShotlist, setIsEditingShotlist] = useState(false);\n\n  // New shot form state\n  const [newShotDesc, setNewShotDesc] = useState(\'\');\n  const [newShotAngle, setNewShotAngle] = useState(\'Medium Shot\');\n  const [newShotMovement, setNewShotMovement] = useState(\'Est\303\241tico\');\n  const [newShotDuration, setNewShotDuration] = useState(3);\n  const [newShotAudio, setNewShotAudio] = useState(\'\');\n\n  const brand = brands.find((b) => b.id === deliverable.brandId);\n  const isDirector = currentUser.role === \'director\' || currentUser.role === \'webadmin\';\n\n  const handleAddShot = () => {\n    if (!newShotDesc.trim()) return;\n\n    const newShot: ShotItem = {\n      shotNumber: (guide.shotlist?.length || 0) + 1,\n      description: newShotDesc,\n      cameraAngle: newShotAngle,\n      movement: newShotMovement,\n      durationSec: Number(newShotDuration),\n      audioNote: newShotAudio,\n    };\n\n    const updatedGuide: TechnicalGuide = {\n      ...guide,\n      shotlist: [...(guide.shotlist || []), newShot],\n    };\n\n    setGuide(updatedGuide);\n    updateTechnicalGuide(deliverable.id, updatedGuide);\n    if (onUpdate) onUpdate(updatedGuide);\n\n    setNewShotDesc(\'\');\n    setNewShotAudio(\'\');\n    setIsEditingShotlist(false);\n  };\n\n  const handleRemoveShot = (index: number) => {\n    const updatedShots = guide.shotlist.filter((_, i) => i !== index).map((s, idx) => ({ ...s, shotNumber: idx + 1 }));\n    const updatedGuide: TechnicalGuide = {\n      ...guide,\n      shotlist: updatedShots,\n    };\n    setGuide(updatedGuide);\n    updateTechnicalGuide(deliverable.id, updatedGuide);\n    if (onUpdate) onUpdate(updatedGuide);\n  };\n\n  const handleDirectorSignOff = () => {\n    if (!isDirector) {\n      alert(\'Solo el Director de Proyecto o WebAdmin pueden firmar formalmente la Gu\303\255a T\303\251cnica.\');\n      return;\n    }\n\n    const updatedGuide: TechnicalGuide = {\n      ...guide,\n      directorSignOff: {\n        approved: true,\n        approvedBy: currentUser.name,\n        approvedAt: new Date().toISOString().replace(\'T\', \' \').substring(0, 16),\n        notes: \'Gu\303\255a t\303\251cnica validada para el plan de rodaje y kit de equipamiento.\',\n      },\n    };\n\n    setGuide(updatedGuide);\n    updateTechnicalGuide(deliverable.id, updatedGuide);\n    if (onUpdate) onUpdate(updatedGuide);\n  };\n\n  return (\n    <div className=\"space-y-6 text-xs text-zinc-200\">\n      \n      {/* Header with Title and AI Generator trigger */}\n      <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-mono text-indigo-400 font-bold\">[{deliverable.code}]</span>\n            <h3 className=\"text-sm font-bold text-white\">{deliverable.title}</h3>\n          </div>\n          <p className=\"text-[11px] text-zinc-400 mt-0.5\">\n            Especificaci\303\263n T\303\251cnica Audiovisual y Matriz de Rodaje\n          </p>\n        </div>\n\n        <button\n          onClick={() =>\n            openAiModalWithContext({\n              action: \'techGuide\',\n              deliverable,\n            })\n          }\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold shadow-md border border-purple-400/30\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          <span>Compilar con Gemini AI (Thinking Mode)</span>\n        </button>\n      </div>\n\n      {/* Grid: 4 Technical Pillars */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        \n        {/* Pillar 1: Formato & Color */}\n        <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100 border-b border-zinc-800 pb-2\">\n            <Film className=\"w-4 h-4 text-indigo-400\" />\n            <span>Relaci\303\263n de Aspecto & Espacio de Color</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-1\">Ratios de Aspecto:</span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {guide.aspectRatios?.map((ratio, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-2.5 py-1 rounded bg-indigo-500/15 border border-indigo-500/40 text-indigo-300 font-mono font-bold\"\n                  >\n                    {ratio}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-0.5\">Velocidad de Cuadros (Frame Rate):</span>\n              <span className=\"font-semibold text-zinc-200\">{guide.frameRate || \'24fps\'}</span>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-0.5\">Espacio de Color / Log Profile:</span>\n              <span className=\"font-mono text-zinc-200 bg-zinc-950 px-2 py-0.5 rounded border border-zinc-800 inline-block\">\n                {guide.colorSpace || \'Rec.709\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Pillar 2: Audio & Iluminaci\303\263n */}\n        <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100 border-b border-zinc-800 pb-2\">\n            <Sun className=\"w-4 h-4 text-amber-400\" />\n            <span>Audio Specs & Esquema de Iluminaci\303\263n</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block flex items-center gap-1\">\n                <Volume2 className=\"w-3 h-3 text-zinc-500\" />\n                Especificaci\303\263n de Audio:\n              </span>\n              <p className=\"text-zinc-200 leading-snug bg-zinc-950 p-2 rounded border border-zinc-800/80\">\n                {guide.audioSpecs || \'Captura 32-bit Float (-18dB target)\'}\n              </p>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block flex items-center gap-1\">\n                <Sun className=\"w-3 h-3 text-zinc-500\" />\n                Esquema de Iluminaci\303\263n Sugerido:\n              </span>\n              <p className=\"text-zinc-200 leading-snug bg-zinc-950 p-2 rounded border border-zinc-800/80\">\n                {guide.lightingScheme || \'3-Point Lighting (Key 5600K, Rim azul)\'}\n              </p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Shotlist Table */}\n      <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n        <div className=\"flex items-center justify-between border-b border-zinc-800 pb-2\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100\">\n            <Layers className=\"w-4 h-4 text-emerald-400\" />\n            <span>Shotlist & Desglose de Planos ({guide.shotlist?.length || 0})</span>\n          </div>\n\n          <button\n            onClick={() => setIsEditingShotlist(!isEditingShotlist)}\n            className=\"flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium text-xs\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Agregar Plano</span>\n          </button>\n        </div>\n\n        {/* Add Shot Inline Form */}\n        {isEditingShotlist && (\n          <div className=\"bg-zinc-950 p-3 rounded-xl border border-indigo-500/40 space-y-3 animate-in fade-in\">\n            <div className=\"font-semibold text-indigo-300\">Nuevo Plano al Shotlist:</div>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">\303\201ngulo de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotAngle}\n                  onChange={(e) => setNewShotAngle(e.target.value)}\n                  placeholder=\"Ej: Extreme Close-Up Macro\"\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">Movimiento de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotMovement}\n                  onChange={(e) => setNewShotMovement(e.target.value)}\n                  placeholder=\"Ej: Push-in lento / Gimbal Orbit\"\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">Duraci\303\263n (segundos)</label>\n                <input\n                  type=\"number\"\n                  min={1}\n                  max={60}\n                  value={newShotDuration}\n                  onChange={(e) => setNewShotDuration(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-zinc-400 block mb-1\">Descripci\303\263n de la Acci\303\263n *</label>\n              <input\n                type=\"text\"\n                value={newShotDesc}\n                onChange={(e) => setNewShotDesc(e.target.value)}\n                placeholder=\"Ej: Plano detalle de gota cayendo en slow motion sobre p\303\263mulo...\"\n                className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-zinc-400 block mb-1\">Nota de Audio / Dise\303\261o Sonoro</label>\n              <input\n                type=\"text\"\n                value={newShotAudio}\n                onChange={(e) => setNewShotAudio(e.target.value)}\n                placeholder=\"Ej: Sonido ASMR n\303\255tido de apertura de gotero...\"\n                className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEditingShotlist(false)}\n                className=\"px-3 py-1 rounded bg-zinc-800 text-zinc-400\"\n              >\n                Cancelar\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleAddShot}\n                className=\"px-4 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-semibold\"\n              >\n                Guardar Plano\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Shots List Table */}\n        {(!guide.shotlist || guide.shotlist.length === 0) ? (\n          <div className=\"py-6 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-lg\">\n            No hay planos registrados en el shotlist. Compila con IA o agrega manualmente.\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"border-b border-zinc-800 text-zinc-500 text-[10px] uppercase font-semibold\">\n                  <th className=\"py-2 px-2\">#</th>\n                  <th className=\"py-2 px-3\">Descripci\303\263n</th>\n                  <th className=\"py-2 px-2\">\303\201ngulo</th>\n                  <th className=\"py-2 px-2\">Movimiento</th>\n                  <th className=\"py-2 px-2\">Duraci\303\263n</th>\n                  <th className=\"py-2 px-2\">Audio</th>\n                  <th className=\"py-2 px-1 text-right\">Acci\303\263n</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-zinc-800/60\">\n                {guide.shotlist.map((shot, sIdx) => (\n                  <tr key={sIdx} className=\"hover:bg-zinc-950/60 transition-colors\">\n                    <td className=\"py-2 px-2 font-mono font-bold text-indigo-400\">\n                      #{shot.shotNumber || sIdx + 1}\n                    </td>\n                    <td className=\"py-2 px-3 text-zinc-200 font-medium\">\n                      {shot.description}\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-400 font-mono text-[11px]\">\n                      {shot.cameraAngle}\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-400 text-[11px]\">\n                      {shot.movement}\n                    </td>\n                    <td className=\"py-2 px-2 font-mono text-amber-300\">\n                      {shot.durationSec}s\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-500 italic text-[11px]\">\n                      {shot.audioNote || \'-\'}\n                    </td>\n                    <td className=\"py-2 px-1 text-right\">\n                      <button\n                        onClick={() => handleRemoveShot(sIdx)}\n                        className=\"text-zinc-600 hover:text-red-400 p-1\"\n                        title=\"Eliminar plano\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* Target Export Platforms */}\n      <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-2\">\n        <span className=\"text-[11px] text-zinc-400 block font-semibold flex items-center gap-1.5\">\n          <Tv className=\"w-3.5 h-3.5 text-teal-400\" />\n          Destinos de Exportaci\303\263n & Masters:\n        </span>\n        <div className=\"flex flex-wrap gap-2\">\n          {(guide.exportTargets || [\'Master ProRes 422HQ\', \'Instagram Reels 1080x1920\', \'TikTok HQ\']).map(\n            (target, tIdx) => (\n              <span\n                key={tIdx}\n                className=\"px-2.5 py-1 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-300 font-mono text-[11px]\"\n              >\n                {target}\n              </span>\n            )\n          )}\n        </div>\n      </div>\n\n      {/* Director Sign-Off Block */}\n      <div\n        className={`p-4 rounded-xl border flex flex-wrap items-center justify-between gap-4 ${\n          guide.directorSignOff?.approved\n            ? \'bg-emerald-500/10 border-emerald-500/30\'\n            : \'bg-zinc-950 border-zinc-800\'\n        }`}\n      >\n        <div className=\"flex items-center gap-3\">\n          {guide.directorSignOff?.approved ? (\n            <CheckCircle2 className=\"w-6 h-6 text-emerald-400 shrink-0\" />\n          ) : (\n            <FileCheck2 className=\"w-6 h-6 text-zinc-500 shrink-0\" />\n          )}\n          <div>\n            <div className=\"font-bold text-white\">\n              {guide.directorSignOff?.approved\n                ? \'Gu\303\255a T\303\251cnica Firmada & Aprobada por Direcci\303\263n\'\n                : \'Pendiente de Visto Bueno del Director de Proyecto\'}\n            </div>\n            <p className=\"text-[11px] text-zinc-400\">\n              {guide.directorSignOff?.approved\n                ? `Firmado por ${guide.directorSignOff.approvedBy} el ${guide.directorSignOff.approvedAt}`\n                : \'Requerido antes de habilitar la fase de Rodaje activo.\'}\n            </p>\n          </div>\n        </div>\n\n        {!guide.directorSignOff?.approved && isDirector && (\n          <button\n            onClick={handleDirectorSignOff}\n            className=\"px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-md transition-all\"\n          >\n            Firmar & Aprobar Gu\303\255a T\303\251cnica\n          </button>\n        )}\n      </div>\n\n    </div>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Deliverable,\n  TechnicalGuide,\n  ShotItem,\n} from \'../types\';\nimport {\n  Film,\n  Camera,\n  Layers,\n  Sparkles,\n  Sliders,\n  Volume2,\n  Sun,\n  Tv,\n  CheckCircle2,\n  AlertCircle,\n  Plus,\n  Trash2,\n  Edit3,\n  FileCheck2,\n} from \'lucide-react\';\n\ninterface TechnicalGuideViewerProps {\n  deliverable: Deliverable;\n  onUpdate?: (guide: TechnicalGuide) => void;\n}\n\nexport const TechnicalGuideViewer: React.FC<TechnicalGuideViewerProps> = ({\n  deliverable,\n  onUpdate,\n}) => {\n  const { updateTechnicalGuide, currentUser, brands, openAiModalWithContext } = useApp();\n  const [guide, setGuide] = useState<TechnicalGuide>(deliverable.technicalGuide);\n  const [isEditingShotlist, setIsEditingShotlist] = useState(false);\n\n  // New shot form state\n  const [newShotDesc, setNewShotDesc] = useState(\'\');\n  const [newShotAngle, setNewShotAngle] = useState(\'Medium Shot\');\n  const [newShotMovement, setNewShotMovement] = useState(\'Est\303\241tico\');\n  const [newShotDuration, setNewShotDuration] = useState(3);\n  const [newShotAudio, setNewShotAudio] = useState(\'\');\n\n  const brand = brands.find((b) => b.id === deliverable.brandId);\n  const isDirector = currentUser.role === \'director\' || currentUser.role === \'webadmin\';\n\n  const handleAddShot = () => {\n    if (!newShotDesc.trim()) return;\n\n    const newShot: ShotItem = {\n      shotNumber: (guide.shotlist?.length || 0) + 1,\n      description: newShotDesc,\n      cameraAngle: newShotAngle,\n      movement: newShotMovement,\n      durationSec: Number(newShotDuration),\n      audioNote: newShotAudio,\n    };\n\n    const updatedGuide: TechnicalGuide = {\n      ...guide,\n      shotlist: [...(guide.shotlist || []), newShot],\n    };\n\n    setGuide(updatedGuide);\n    updateTechnicalGuide(deliverable.id, updatedGuide);\n    if (onUpdate) onUpdate(updatedGuide);\n\n    setNewShotDesc(\'\');\n    setNewShotAudio(\'\');\n    setIsEditingShotlist(false);\n  };\n\n  const handleRemoveShot = (index: number) => {\n    const updatedShots = guide.shotlist.filter((_, i) => i !== index).map((s, idx) => ({ ...s, shotNumber: idx + 1 }));\n    const updatedGuide: TechnicalGuide = {\n      ...guide,\n      shotlist: updatedShots,\n    };\n    setGuide(updatedGuide);\n    updateTechnicalGuide(deliverable.id, updatedGuide);\n    if (onUpdate) onUpdate(updatedGuide);\n  };\n\n  const handleDirectorSignOff = () => {\n    if (!isDirector) {\n      alert(\'Solo el Director de Proyecto o WebAdmin pueden firmar formalmente la Gu\303\255a T\303\251cnica.\');\n      return;\n    }\n\n    const updatedGuide: TechnicalGuide = {\n      ...guide,\n      directorSignOff: {\n        approved: true,\n        approvedBy: currentUser.name,\n        approvedAt: new Date().toISOString().replace(\'T\', \' \').substring(0, 16),\n        notes: \'Gu\303\255a t\303\251cnica validada para el plan de rodaje y kit de equipamiento.\',\n      },\n    };\n\n    setGuide(updatedGuide);\n    updateTechnicalGuide(deliverable.id, updatedGuide);\n    if (onUpdate) onUpdate(updatedGuide);\n  };\n\n  return (\n    <div className=\"space-y-6 text-xs text-zinc-200\">\n      \n      {/* Header with Title and AI Generator trigger */}\n      <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-mono text-indigo-400 font-bold\">[{deliverable.code}]</span>\n            <h3 className=\"text-sm font-bold text-white\">{deliverable.title}</h3>\n          </div>\n          <p className=\"text-[11px] text-zinc-400 mt-0.5\">\n            Especificaci\303\263n T\303\251cnica Audiovisual y Matriz de Rodaje\n          </p>\n        </div>\n\n        <button\n          onClick={() =>\n            openAiModalWithContext({\n              action: \'techGuide\',\n              deliverable,\n            })\n          }\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold shadow-md border border-purple-400/30\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          <span>Compilar con Gemini AI (Thinking Mode)</span>\n        </button>\n      </div>\n\n      {/* Grid: 4 Technical Pillars */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        \n        {/* Pillar 1: Formato & Color */}\n        <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100 border-b border-zinc-800 pb-2\">\n            <Film className=\"w-4 h-4 text-indigo-400\" />\n            <span>Relaci\303\263n de Aspecto & Espacio de Color</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-1\">Ratios de Aspecto:</span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {guide.aspectRatios?.map((ratio, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-2.5 py-1 rounded bg-indigo-500/15 border border-indigo-500/40 text-indigo-300 font-mono font-bold\"\n                  >\n                    {ratio}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-0.5\">Velocidad de Cuadros (Frame Rate):</span>\n              <span className=\"font-semibold text-zinc-200\">{guide.frameRate || \'24fps\'}</span>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-0.5\">Espacio de Color / Log Profile:</span>\n              <span className=\"font-mono text-zinc-200 bg-zinc-950 px-2 py-0.5 rounded border border-zinc-800 inline-block\">\n                {guide.colorSpace || \'Rec.709\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Pillar 2: Audio & Iluminaci\303\263n */}\n        <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100 border-b border-zinc-800 pb-2\">\n            <Sun className=\"w-4 h-4 text-amber-400\" />\n            <span>Audio Specs & Esquema de Iluminaci\303\263n</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block flex items-center gap-1\">\n                <Volume2 className=\"w-3 h-3 text-zinc-500\" />\n                Especificaci\303\263n de Audio:\n              </span>\n              <p className=\"text-zinc-200 leading-snug bg-zinc-950 p-2 rounded border border-zinc-800/80\">\n                {guide.audioSpecs || \'Captura 32-bit Float (-18dB target)\'}\n              </p>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block flex items-center gap-1\">\n                <Sun className=\"w-3 h-3 text-zinc-500\" />\n                Esquema de Iluminaci\303\263n Sugerido:\n              </span>\n              <p className=\"text-zinc-200 leading-snug bg-zinc-950 p-2 rounded border border-zinc-800/80\">\n                {guide.lightingScheme || \'3-Point Lighting (Key 5600K, Rim azul)\'}\n              </p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Shotlist Table */}\n      <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n        <div className=\"flex items-center justify-between border-b border-zinc-800 pb-2\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100\">\n            <Layers className=\"w-4 h-4 text-emerald-400\" />\n            <span>Shotlist & Desglose de Planos ({guide.shotlist?.length || 0})</span>\n          </div>\n\n          <button\n            onClick={() => setIsEditingShotlist(!isEditingShotlist)}\n            className=\"flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium text-xs\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Agregar Plano</span>\n          </button>\n        </div>\n\n        {/* Add Shot Inline Form */}\n        {isEditingShotlist && (\n          <div className=\"bg-zinc-950 p-3 rounded-xl border border-indigo-500/40 space-y-3 animate-in fade-in\">\n            <div className=\"font-semibold text-indigo-300\">Nuevo Plano al Shotlist:</div>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">\303\201ngulo de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotAngle}\n                  onChange={(e) => setNewShotAngle(e.target.value)}\n                  placeholder=\"Ej: Extreme Close-Up Macro\"\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">Movimiento de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotMovement}\n                  onChange={(e) => setNewShotMovement(e.target.value)}\n                  placeholder=\"Ej: Push-in lento / Gimbal Orbit\"\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">Duraci\303\263n (segundos)</label>\n                <input\n                  type=\"number\"\n                  min={1}\n                  max={60}\n                  value={newShotDuration}\n                  onChange={(e) => setNewShotDuration(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-zinc-400 block mb-1\">Descripci\303\263n de la Acci\303\263n *</label>\n              <input\n                type=\"text\"\n                value={newShotDesc}\n                onChange={(e) => setNewShotDesc(e.target.value)}\n                placeholder=\"Ej: Plano detalle de gota cayendo en slow motion sobre p\303\263mulo...\"\n                className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-zinc-400 block mb-1\">Nota de Audio / Dise\303\261o Sonoro</label>\n              <input\n                type=\"text\"\n                value={newShotAudio}\n                onChange={(e) => setNewShotAudio(e.target.value)}\n                placeholder=\"Ej: Sonido ASMR n\303\255tido de apertura de gotero...\"\n                className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEditingShotlist(false)}\n                className=\"px-3 py-1 rounded bg-zinc-800 text-zinc-400\"\n              >\n                Cancelar\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleAddShot}\n                className=\"px-4 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-semibold\"\n              >\n                Guardar Plano\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Shots List Table */}\n        {(!guide.shotlist || guide.shotlist.length === 0) ? (\n          <div className=\"py-6 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-lg\">\n            No hay planos registrados en el shotlist. Compila con IA o agrega manualmente.\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"border-b border-zinc-800 text-zinc-500 text-[10px] uppercase font-semibold\">\n                  <th className=\"py-2 px-2\">#</th>\n                  <th className=\"py-2 px-3\">Descripci\303\263n</th>\n                  <th className=\"py-2 px-2\">\303\201ngulo</th>\n                  <th className=\"py-2 px-2\">Movimiento</th>\n                  <th className=\"py-2 px-2\">Duraci\303\263n</th>\n                  <th className=\"py-2 px-2\">Audio</th>\n                  <th className=\"py-2 px-1 text-right\">Acci\303\263n</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-zinc-800/60\">\n                {guide.shotlist.map((shot, sIdx) => (\n                  <tr key={sIdx} className=\"hover:bg-zinc-950/60 transition-colors\">\n                    <td className=\"py-2 px-2 font-mono font-bold text-indigo-400\">\n                      #{shot.shotNumber || sIdx + 1}\n                    </td>\n                    <td className=\"py-2 px-3 text-zinc-200 font-medium\">\n                      {shot.description}\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-400 font-mono text-[11px]\">\n                      {shot.cameraAngle}\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-400 text-[11px]\">\n                      {shot.movement}\n                    </td>\n                    <td className=\"py-2 px-2 font-mono text-amber-300\">\n                      {shot.durationSec}s\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-500 italic text-[11px]\">\n                      {shot.audioNote || \'-\'}\n                    </td>\n                    <td className=\"py-2 px-1 text-right\">\n                      <button\n                        onClick={() => handleRemoveShot(sIdx)}\n                        className=\"text-zinc-600 hover:text-red-400 p-1\"\n                        title=\"Eliminar plano\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* Target Export Platforms */}\n      <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-2\">\n        <span className=\"text-[11px] text-zinc-400 block font-semibold flex items-center gap-1.5\">\n          <Tv className=\"w-3.5 h-3.5 text-teal-400\" />\n          Destinos de Exportaci\303\263n & Masters:\n        </span>\n        <div className=\"flex flex-wrap gap-2\">\n          {(guide.exportTargets || [\'Master ProRes 422HQ\', \'Instagram Reels 1080x1920\', \'TikTok HQ\']).map(\n            (target, tIdx) => (\n              <span\n                key={tIdx}\n                className=\"px-2.5 py-1 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-300 font-mono text-[11px]\"\n              >\n                {target}\n              </span>\n            )\n          )}\n        </div>\n      </div>\n\n      {/* Director Sign-Off Block */}\n      <div\n        className={`p-4 rounded-xl border flex flex-wrap items-center justify-between gap-4 ${\n          guide.directorSignOff?.approved\n            ? \'bg-emerald-500/10 border-emerald-500/30\'\n            : \'bg-zinc-950 border-zinc-800\'\n        }`}\n      >\n        <div className=\"flex items-center gap-3\">\n          {guide.directorSignOff?.approved ? (\n            <CheckCircle2 className=\"w-6 h-6 text-emerald-400 shrink-0\" />\n          ) : (\n            <FileCheck2 className=\"w-6 h-6 text-zinc-500 shrink-0\" />\n          )}\n          <div>\n            <div className=\"font-bold text-white\">\n              {guide.directorSignOff?.approved\n                ? \'Gu\303\255a T\303\251cnica Firmada & Aprobada por Direcci\303\263n\'\n                : \'Pendiente de Visto Bueno del Director de Proyecto\'}\n            </div>\n            <p className=\"text-[11px] text-zinc-400\">\n              {guide.directorSignOff?.approved\n                ? `Firmado por ${guide.directorSignOff.approvedBy} el ${guide.directorSignOff.approvedAt}`\n                : \'Requerido antes de habilitar la fase de Rodaje activo.\'}\n            </p>\n          </div>\n        </div>\n\n        {!guide.directorSignOff?.approved && isDirector && (\n          <button\n            onClick={handleDirectorSignOff}\n            className=\"px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-md transition-all\"\n          >\n            Firmar & Aprobar Gu\303\255a T\303\251cnica\n          </button>\n        )}\n      </div>\n\n    </div>\n  );\n};\n"
    num_lines: 423
    num_bytes: 16573
  }
}
