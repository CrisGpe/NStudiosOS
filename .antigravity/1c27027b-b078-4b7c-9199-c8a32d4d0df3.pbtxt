        lines {
          text: "                <button"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  type=\"submit\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  className=\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-md\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  className=\"px-3 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
