          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            : \'bg-zinc-950 border-zinc-800\'"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            ? \'bg-emerald-50 border-emerald-200\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            : \'bg-slate-50 border-slate-200\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }`}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"flex items-center gap-3\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        <div className=\"flex items-center gap-2.5\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {guide.directorSignOff?.approved ? ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <CheckCircle2 className=\"w-6 h-6 text-emerald-400 shrink-0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ) : ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <FileCheck2 className=\"w-6 h-6 text-zinc-500 shrink-0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <FileCheck2 className=\"w-5 h-5 text-slate-400 shrink-0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          )}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <div className=\"font-bold text-white\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <div className=\"font-bold text-slate-900 text-xs\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              {guide.directorSignOff?.approved"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ? \'Gu\303\255a T\303\251cnica Firmada & Aprobada por Direcci\303\263n\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                : \'Pendiente de Visto Bueno del Director de Proyecto\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <p className=\"text-[11px] text-zinc-400\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            <p className=\"text-[10px] text-slate-500\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              {guide.directorSignOff?.approved"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ? `Firmado por ${guide.directorSignOff.approvedBy} el ${guide.directorSignOff.approvedAt}`"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                : \'Requerido antes de habilitar la fase de Rodaje activo.\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        {!guide.directorSignOff?.approved && isDirector && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <button"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            onClick={handleDirectorSignOff}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            className=\"px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-md transition-all\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            className=\"px-3 py-1.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs shadow-xs cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            Firmar & Aprobar Gu\303\255a T\303\251cnica"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        )}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Apply High Density light-mode styling to TechnicalGuideViewer"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6 text-xs text-zinc-200\">\n      \n      {/* Header with Title and AI Generator trigger */}\n      <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-mono text-indigo-400 font-bold\">[{deliverable.code}]</span>\n            <h3 className=\"text-sm font-bold text-white\">{deliverable.title}</h3>\n          </div>\n          <p className=\"text-[11px] text-zinc-400 mt-0.5\">\n            Especificaci\303\263n T\303\251cnica Audiovisual y Matriz de Rodaje\n          </p>\n        </div>\n\n        <button\n          onClick={() =>\n            openAiModalWithContext({\n              action: \'techGuide\',\n              deliverable,\n            })\n          }\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold shadow-md border border-purple-400/30\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          <span>Compilar con Gemini AI (Thinking Mode)</span>\n        </button>\n      </div>\n\n      {/* Grid: 4 Technical Pillars */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        \n        {/* Pillar 1: Formato & Color */}\n        <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100 border-b border-zinc-800 pb-2\">\n            <Film className=\"w-4 h-4 text-indigo-400\" />\n            <span>Relaci\303\263n de Aspecto & Espacio de Color</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-1\">Ratios de Aspecto:</span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {guide.aspectRatios?.map((ratio, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-2.5 py-1 rounded bg-indigo-500/15 border border-indigo-500/40 text-indigo-300 font-mono font-bold\"\n                  >\n                    {ratio}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-0.5\">Velocidad de Cuadros (Frame Rate):</span>\n              <span className=\"font-semibold text-zinc-200\">{guide.frameRate || \'24fps\'}</span>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block mb-0.5\">Espacio de Color / Log Profile:</span>\n              <span className=\"font-mono text-zinc-200 bg-zinc-950 px-2 py-0.5 rounded border border-zinc-800 inline-block\">\n                {guide.colorSpace || \'Rec.709\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Pillar 2: Audio & Iluminaci\303\263n */}\n        <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100 border-b border-zinc-800 pb-2\">\n            <Sun className=\"w-4 h-4 text-amber-400\" />\n            <span>Audio Specs & Esquema de Iluminaci\303\263n</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block flex items-center gap-1\">\n                <Volume2 className=\"w-3 h-3 text-zinc-500\" />\n                Especificaci\303\263n de Audio:\n              </span>\n              <p className=\"text-zinc-200 leading-snug bg-zinc-950 p-2 rounded border border-zinc-800/80\">\n                {guide.audioSpecs || \'Captura 32-bit Float (-18dB target)\'}\n              </p>\n            </div>\n\n            <div>\n              <span className=\"text-[11px] text-zinc-400 block flex items-center gap-1\">\n                <Sun className=\"w-3 h-3 text-zinc-500\" />\n                Esquema de Iluminaci\303\263n Sugerido:\n              </span>\n              <p className=\"text-zinc-200 leading-snug bg-zinc-950 p-2 rounded border border-zinc-800/80\">\n                {guide.lightingScheme || \'3-Point Lighting (Key 5600K, Rim azul)\'}\n              </p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Shotlist Table */}\n      <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-3\">\n        <div className=\"flex items-center justify-between border-b border-zinc-800 pb-2\">\n          <div className=\"flex items-center gap-2 font-bold text-zinc-100\">\n            <Layers className=\"w-4 h-4 text-emerald-400\" />\n            <span>Shotlist & Desglose de Planos ({guide.shotlist?.length || 0})</span>\n          </div>\n\n          <button\n            onClick={() => setIsEditingShotlist(!isEditingShotlist)}\n            className=\"flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium text-xs\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Agregar Plano</span>\n          </button>\n        </div>\n\n        {/* Add Shot Inline Form */}\n        {isEditingShotlist && (\n          <div className=\"bg-zinc-950 p-3 rounded-xl border border-indigo-500/40 space-y-3 animate-in fade-in\">\n            <div className=\"font-semibold text-indigo-300\">Nuevo Plano al Shotlist:</div>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">\303\201ngulo de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotAngle}\n                  onChange={(e) => setNewShotAngle(e.target.value)}\n                  placeholder=\"Ej: Extreme Close-Up Macro\"\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">Movimiento de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotMovement}\n                  onChange={(e) => setNewShotMovement(e.target.value)}\n                  placeholder=\"Ej: Push-in lento / Gimbal Orbit\"\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-zinc-400 block mb-1\">Duraci\303\263n (segundos)</label>\n                <input\n                  type=\"number\"\n                  min={1}\n                  max={60}\n                  value={newShotDuration}\n                  onChange={(e) => setNewShotDuration(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-zinc-400 block mb-1\">Descripci\303\263n de la Acci\303\263n *</label>\n              <input\n                type=\"text\"\n                value={newShotDesc}\n                onChange={(e) => setNewShotDesc(e.target.value)}\n                placeholder=\"Ej: Plano detalle de gota cayendo en slow motion sobre p\303\263mulo...\"\n                className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-zinc-400 block mb-1\">Nota de Audio / Dise\303\261o Sonoro</label>\n              <input\n                type=\"text\"\n                value={newShotAudio}\n                onChange={(e) => setNewShotAudio(e.target.value)}\n                placeholder=\"Ej: Sonido ASMR n\303\255tido de apertura de gotero...\"\n                className=\"w-full bg-zinc-900 border border-zinc-800 rounded px-2.5 py-1.5 text-zinc-200\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEditingShotlist(false)}\n                className=\"px-3 py-1 rounded bg-zinc-800 text-zinc-400\"\n              >\n                Cancelar\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleAddShot}\n                className=\"px-4 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-semibold\"\n              >\n                Guardar Plano\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Shots List Table */}\n        {(!guide.shotlist || guide.shotlist.length === 0) ? (\n          <div className=\"py-6 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-lg\">\n            No hay planos registrados en el shotlist. Compila con IA o agrega manualmente.\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"border-b border-zinc-800 text-zinc-500 text-[10px] uppercase font-semibold\">\n                  <th className=\"py-2 px-2\">#</th>\n                  <th className=\"py-2 px-3\">Descripci\303\263n</th>\n                  <th className=\"py-2 px-2\">\303\201ngulo</th>\n                  <th className=\"py-2 px-2\">Movimiento</th>\n                  <th className=\"py-2 px-2\">Duraci\303\263n</th>\n                  <th className=\"py-2 px-2\">Audio</th>\n                  <th className=\"py-2 px-1 text-right\">Acci\303\263n</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-zinc-800/60\">\n                {guide.shotlist.map((shot, sIdx) => (\n                  <tr key={sIdx} className=\"hover:bg-zinc-950/60 transition-colors\">\n                    <td className=\"py-2 px-2 font-mono font-bold text-indigo-400\">\n                      #{shot.shotNumber || sIdx + 1}\n                    </td>\n                    <td className=\"py-2 px-3 text-zinc-200 font-medium\">\n                      {shot.description}\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-400 font-mono text-[11px]\">\n                      {shot.cameraAngle}\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-400 text-[11px]\">\n                      {shot.movement}\n                    </td>\n                    <td className=\"py-2 px-2 font-mono text-amber-300\">\n                      {shot.durationSec}s\n                    </td>\n                    <td className=\"py-2 px-2 text-zinc-500 italic text-[11px]\">\n                      {shot.audioNote || \'-\'}\n                    </td>\n                    <td className=\"py-2 px-1 text-right\">\n                      <button\n                        onClick={() => handleRemoveShot(sIdx)}\n                        className=\"text-zinc-600 hover:text-red-400 p-1\"\n                        title=\"Eliminar plano\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* Target Export Platforms */}\n      <div className=\"bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-2\">\n        <span className=\"text-[11px] text-zinc-400 block font-semibold flex items-center gap-1.5\">\n          <Tv className=\"w-3.5 h-3.5 text-teal-400\" />\n          Destinos de Exportaci\303\263n & Masters:\n        </span>\n        <div className=\"flex flex-wrap gap-2\">\n          {(guide.exportTargets || [\'Master ProRes 422HQ\', \'Instagram Reels 1080x1920\', \'TikTok HQ\']).map(\n            (target, tIdx) => (\n              <span\n                key={tIdx}\n                className=\"px-2.5 py-1 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-300 font-mono text-[11px]\"\n              >\n                {target}\n              </span>\n            )\n          )}\n        </div>\n      </div>\n\n      {/* Director Sign-Off Block */}\n      <div\n        className={`p-4 rounded-xl border flex flex-wrap items-center justify-between gap-4 ${\n          guide.directorSignOff?.approved\n            ? \'bg-emerald-500/10 border-emerald-500/30\'\n            : \'bg-zinc-950 border-zinc-800\'\n        }`}\n      >\n        <div className=\"flex items-center gap-3\">\n          {guide.directorSignOff?.approved ? (\n            <CheckCircle2 className=\"w-6 h-6 text-emerald-400 shrink-0\" />\n          ) : (\n            <FileCheck2 className=\"w-6 h-6 text-zinc-500 shrink-0\" />\n          )}\n          <div>\n            <div className=\"font-bold text-white\">\n              {guide.directorSignOff?.approved\n                ? \'Gu\303\255a T\303\251cnica Firmada & Aprobada por Direcci\303\263n\'\n                : \'Pendiente de Visto Bueno del Director de Proyecto\'}\n            </div>\n            <p className=\"text-[11px] text-zinc-400\">\n              {guide.directorSignOff?.approved\n                ? `Firmado por ${guide.directorSignOff.approvedBy} el ${guide.directorSignOff.approvedAt}`\n                : \'Requerido antes de habilitar la fase de Rodaje activo.\'}\n            </p>\n          </div>\n        </div>\n\n        {!guide.directorSignOff?.approved && isDirector && (\n          <button\n            onClick={handleDirectorSignOff}\n            className=\"px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-md transition-all\"\n          >\n            Firmar & Aprobar Gu\303\255a T\303\251cnica\n          </button>\n        )}\n      </div>\n\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"space-y-4 text-xs text-slate-700\">\n      \n      {/* Header with Title and AI Generator trigger */}\n      <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"font-mono text-indigo-700 font-bold text-[11px]\">[{deliverable.code}]</span>\n            <h3 className=\"text-xs font-bold text-slate-900\">{deliverable.title}</h3>\n          </div>\n          <p className=\"text-[10px] text-slate-500 mt-0.5\">\n            Especificaci\303\263n T\303\251cnica Audiovisual y Matriz de Rodaje\n          </p>\n        </div>\n\n        <button\n          onClick={() =>\n            openAiModalWithContext({\n              action: \'techGuide\',\n              deliverable,\n            })\n          }\n          className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 font-semibold text-xs cursor-pointer shadow-2xs\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5 text-purple-600\" />\n          <span>Compilar con Gemini AI</span>\n        </button>\n      </div>\n\n      {/* Grid: 2 Technical Pillars */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n        \n        {/* Pillar 1: Formato & Color */}\n        <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2.5\">\n          <div className=\"flex items-center gap-1.5 font-bold text-slate-800 border-b border-slate-200 pb-1.5 text-xs\">\n            <Film className=\"w-3.5 h-3.5 text-indigo-600\" />\n            <span>Relaci\303\263n de Aspecto & Espacio de Color</span>\n          </div>\n\n          <div className=\"space-y-1.5 text-xs\">\n            <div>\n              <span className=\"text-[10px] text-slate-500 block mb-0.5 font-medium\">Ratios de Aspecto:</span>\n              <div className=\"flex flex-wrap gap-1\">\n                {guide.aspectRatios?.map((ratio, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-1.5 py-0.5 rounded bg-indigo-50 border border-indigo-200 text-indigo-700 font-mono font-bold text-[10px]\"\n                  >\n                    {ratio}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <span className=\"text-[10px] text-slate-500 block font-medium\">Velocidad de Cuadros (Frame Rate):</span>\n              <span className=\"font-semibold text-slate-800 text-[11px]\">{guide.frameRate || \'24fps\'}</span>\n            </div>\n\n            <div>\n              <span className=\"text-[10px] text-slate-500 block font-medium\">Espacio de Color / Log Profile:</span>\n              <span className=\"font-mono text-slate-800 bg-white px-1.5 py-0.5 rounded border border-slate-200 inline-block text-[10px]\">\n                {guide.colorSpace || \'Rec.709\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Pillar 2: Audio & Iluminaci\303\263n */}\n        <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2.5\">\n          <div className=\"flex items-center gap-1.5 font-bold text-slate-800 border-b border-slate-200 pb-1.5 text-xs\">\n            <Sun className=\"w-3.5 h-3.5 text-amber-600\" />\n            <span>Audio Specs & Esquema de Iluminaci\303\263n</span>\n          </div>\n\n          <div className=\"space-y-1.5 text-xs\">\n            <div>\n              <span className=\"text-[10px] text-slate-500 block flex items-center gap-1 font-medium\">\n                <Volume2 className=\"w-3 h-3 text-slate-400\" />\n                Especificaci\303\263n de Audio:\n              </span>\n              <p className=\"text-slate-800 leading-snug bg-white p-1.5 rounded border border-slate-200 text-[11px]\">\n                {guide.audioSpecs || \'Captura 32-bit Float (-18dB target)\'}\n              </p>\n            </div>\n\n            <div>\n              <span className=\"text-[10px] text-slate-500 block flex items-center gap-1 font-medium\">\n                <Sun className=\"w-3 h-3 text-slate-400\" />\n                Esquema de Iluminaci\303\263n Sugerido:\n              </span>\n              <p className=\"text-slate-800 leading-snug bg-white p-1.5 rounded border border-slate-200 text-[11px]\">\n                {guide.lightingScheme || \'3-Point Lighting (Key 5600K, Rim azul)\'}\n              </p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Shotlist Table */}\n      <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2.5\">\n        <div className=\"flex items-center justify-between border-b border-slate-200 pb-1.5\">\n          <div className=\"flex items-center gap-1.5 font-bold text-slate-800 text-xs\">\n            <Layers className=\"w-3.5 h-3.5 text-emerald-600\" />\n            <span>Shotlist & Desglose de Planos ({guide.shotlist?.length || 0})</span>\n          </div>\n\n          <button\n            onClick={() => setIsEditingShotlist(!isEditingShotlist)}\n            className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 font-medium text-[11px] cursor-pointer\"\n          >\n            <Plus className=\"w-3 h-3\" />\n            <span>Agregar Plano</span>\n          </button>\n        </div>\n\n        {/* Add Shot Inline Form */}\n        {isEditingShotlist && (\n          <div className=\"bg-white p-3 rounded-lg border border-indigo-200 space-y-2.5 animate-in fade-in\">\n            <div className=\"font-semibold text-indigo-900 text-xs\">Nuevo Plano al Shotlist:</div>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\">\n              <div>\n                <label className=\"text-slate-500 block mb-0.5 text-[10px]\">\303\201ngulo de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotAngle}\n                  onChange={(e) => setNewShotAngle(e.target.value)}\n                  placeholder=\"Ej: Close-Up\"\n                  className=\"w-full bg-slate-50 border border-slate-300 rounded px-2 py-1 text-slate-800 text-xs\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-slate-500 block mb-0.5 text-[10px]\">Movimiento de C\303\241mara</label>\n                <input\n                  type=\"text\"\n                  value={newShotMovement}\n                  onChange={(e) => setNewShotMovement(e.target.value)}\n                  placeholder=\"Ej: Push-in\"\n                  className=\"w-full bg-slate-50 border border-slate-300 rounded px-2 py-1 text-slate-800 text-xs\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-slate-500 block mb-0.5 text-[10px]\">Duraci\303\263n (segundos)</label>\n                <input\n                  type=\"number\"\n                  min={1}\n                  max={60}\n                  value={newShotDuration}\n                  onChange={(e) => setNewShotDuration(Number(e.target.value))}\n                  className=\"w-full bg-slate-50 border border-slate-300 rounded px-2 py-1 text-slate-800 text-xs\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-slate-500 block mb-0.5 text-[10px]\">Descripci\303\263n de la Acci\303\263n *</label>\n              <input\n                type=\"text\"\n                value={newShotDesc}\n                onChange={(e) => setNewShotDesc(e.target.value)}\n                placeholder=\"Ej: Plano detalle de gota cayendo...\"\n                className=\"w-full bg-slate-50 border border-slate-300 rounded px-2 py-1 text-slate-800 text-xs\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-slate-500 block mb-0.5 text-[10px]\">Nota de Audio / Dise\303\261o Sonoro</label>\n              <input\n                type=\"text\"\n                value={newShotAudio}\n                onChange={(e) => setNewShotAudio(e.target.value)}\n                placeholder=\"Ej: Sonido ASMR n\303\255tido...\"\n                className=\"w-full bg-slate-50 border border-slate-300 rounded px-2 py-1 text-slate-800 text-xs\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-end gap-1.5 pt-1\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEditingShotlist(false)}\n                className=\"px-2.5 py-1 rounded bg-slate-100 text-slate-600 text-xs cursor-pointer\"\n              >\n                Cancelar\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleAddShot}\n                className=\"px-3 py-1 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs cursor-pointer shadow-2xs\"\n              >\n                Guardar Plano\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Shots List Table */}\n        {(!guide.shotlist || guide.shotlist.length === 0) ? (\n          <div className=\"py-4 text-center text-slate-500 border border-dashed border-slate-200 rounded-md text-xs\">\n            No hay planos registrados en el shotlist. Compila con IA o agrega manualmente.\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse text-xs\">\n              <thead>\n                <tr className=\"border-b border-slate-200 text-slate-500 text-[10px] uppercase font-semibold\">\n                  <th className=\"py-1.5 px-2\">#</th>\n                  <th className=\"py-1.5 px-2.5\">Descripci\303\263n</th>\n                  <th className=\"py-1.5 px-2\">\303\201ngulo</th>\n                  <th className=\"py-1.5 px-2\">Movimiento</th>\n                  <th className=\"py-1.5 px-2\">Duraci\303\263n</th>\n                  <th className=\"py-1.5 px-2\">Audio</th>\n                  <th className=\"py-1.5 px-1 text-right\">Acci\303\263n</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-200\">\n                {guide.shotlist.map((shot, sIdx) => (\n                  <tr key={sIdx} className=\"hover:bg-slate-100/70 transition-colors\">\n                    <td className=\"py-1.5 px-2 font-mono font-bold text-indigo-700\">\n                      #{shot.shotNumber || sIdx + 1}\n                    </td>\n                    <td className=\"py-1.5 px-2.5 text-slate-900 font-medium\">\n                      {shot.description}\n                    </td>\n                    <td className=\"py-1.5 px-2 text-slate-600 font-mono text-[11px]\">\n                      {shot.cameraAngle}\n                    </td>\n                    <td className=\"py-1.5 px-2 text-slate-600 text-[11px]\">\n                      {shot.movement}\n                    </td>\n                    <td className=\"py-1.5 px-2 font-mono text-amber-700 font-bold\">\n                      {shot.durationSec}s\n                    </td>\n                    <td className=\"py-1.5 px-2 text-slate-500 italic text-[11px]\">\n                      {shot.audioNote || \'-\'}\n                    </td>\n                    <td className=\"py-1.5 px-1 text-right\">\n                      <button\n                        onClick={() => handleRemoveShot(sIdx)}\n                        className=\"text-slate-400 hover:text-red-600 p-0.5 cursor-pointer\"\n                        title=\"Eliminar plano\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* Target Export Platforms */}\n      <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-1.5\">\n        <span className=\"text-[10px] text-slate-500 block font-semibold flex items-center gap-1.5\">\n          <Tv className=\"w-3 h-3 text-teal-600\" />\n          Destinos de Exportaci\303\263n & Masters:\n        </span>\n        <div className=\"flex flex-wrap gap-1.5\">\n          {(guide.exportTargets || [\'Master ProRes 422HQ\', \'Instagram Reels 1080x1920\', \'TikTok HQ\']).map(\n            (target, tIdx) => (\n              <span\n                key={tIdx}\n                className=\"px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-700 font-mono text-[10px]\"\n              >\n                {target}\n              </span>\n            )\n          )}\n        </div>\n      </div>\n\n      {/* Director Sign-Off Block */}\n      <div\n        className={`p-3 rounded-lg border flex flex-wrap items-center justify-between gap-3 ${\n          guide.directorSignOff?.approved\n            ? \'bg-emerald-50 border-emerald-200\'\n            : \'bg-slate-50 border-slate-200\'\n        }`}\n      >\n        <div className=\"flex items-center gap-2.5\">\n          {guide.directorSignOff?.approved ? (\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n          ) : (\n            <FileCheck2 className=\"w-5 h-5 text-slate-400 shrink-0\" />\n          )}\n          <div>\n            <div className=\"font-bold text-slate-900 text-xs\">\n              {guide.directorSignOff?.approved\n                ? \'Gu\303\255a T\303\251cnica Firmada & Aprobada por Direcci\303\263n\'\n                : \'Pendiente de Visto Bueno del Director de Proyecto\'}\n            </div>\n            <p className=\"text-[10px] text-slate-500\">\n              {guide.directorSignOff?.approved\n                ? `Firmado por ${guide.directorSignOff.approvedBy} el ${guide.directorSignOff.approvedAt}`\n                : \'Requerido antes de habilitar la fase de Rodaje activo.\'}\n            </p>\n          </div>\n        </div>\n\n        {!guide.directorSignOff?.approved && isDirector && (\n          <button\n            onClick={handleDirectorSignOff}\n            className=\"px-3 py-1.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs shadow-xs cursor-pointer\"\n          >\n            Firmar & Aprobar Gu\303\255a T\303\251cnica\n          </button>\n        )}\n      </div>\n\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
