    end_line: 311
    content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Film,\n  Users,\n  Calendar,\n  Layers,\n  Camera,\n  FileCode,\n  ShieldCheck,\n  Sparkles,\n  Search,\n  CheckCircle2,\n  ChevronDown,\n  Building2,\n  AlertTriangle,\n} from \'lucide-react\';\nimport { UserRole } from \'../types\';\n\nexport const Navbar: React.FC = () => {\n  const {\n    currentUser,\n    setCurrentUser,\n    users,\n    brands,\n    selectedBrandId,\n    setSelectedBrandId,\n    activeTab,\n    setActiveTab,\n    searchQuery,\n    setSearchQuery,\n    openAiModalWithContext,\n    validateBrandTerritories,\n  } = useApp();\n\n  const [isRoleDropdownOpen, setIsRoleDropdownOpen] = useState(false);\n\n  const getRoleBadgeColor = (role: UserRole) => {\n    switch (role) {\n      case \'webadmin\':\n        return \'bg-purple-500/10 text-purple-400 border-purple-500/30\';\n      case \'director\':\n        return \'bg-amber-500/10 text-amber-400 border-amber-500/30\';\n      case \'colaborador\':\n        return \'bg-blue-500/10 text-blue-400 border-blue-500/30\';\n      case \'cliente\':\n        return \'bg-emerald-500/10 text-emerald-400 border-emerald-500/30\';\n    }\n  };\n\n  // Check if any brand has less than 3 territories\n  const invalidBrands = brands.filter((b) => !validateBrandTerritories(b.id).isValid);\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-zinc-950/90 backdrop-blur-md border-b border-zinc-800/80\">\n      {/* Top Warning Banner if territory business rule is broken */}\n      {invalidBrands.length > 0 && (\n        <div className=\"bg-amber-500/15 border-b border-amber-500/30 px-4 py-1.5 text-xs text-amber-300 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-400 shrink-0\" />\n            <span>\n              <strong>Alerta de Regla de Negocio:</strong> {invalidBrands.length} marca(s) tienen menos de 3 territorios activos ({invalidBrands.map((b) => b.name).join(\', \')}).\n            </span>\n          </div>\n          <button\n            onClick={() => setActiveTab(\'brands\')}\n            className=\"underline font-medium hover:text-amber-200\"\n          >\n            Gestionar Territorios\n          </button>\n        </div>\n      )}\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-4\">\n          \n          {/* Logo & Platform Name */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/20 ring-1 ring-white/20\">\n              <Film className=\"w-5 h-5 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-bold text-white text-base tracking-tight\">CineFlow</span>\n                <span className=\"text-[10px] uppercase font-semibold px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700\">\n                  Studio OS\n                </span>\n              </div>\n              <p className=\"text-[11px] text-zinc-400 hidden sm:block\">Plataforma de Producci\303\263n Audiovisual & RBAC</p>\n            </div>\n          </div>\n\n          {/* Global Search Bar */}\n          <div className=\"flex-1 max-w-md hidden md:block\">\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Buscar entregables, equipos, marcas o c\303\263digos (e.g. CF-APX)...\"\n                className=\"w-full bg-zinc-900/80 border border-zinc-800 rounded-lg pl-9 pr-4 py-1.5 text-xs text-zinc-200 placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-all\"\n              />\n              {searchQuery && (\n                <button\n                  onClick={() => setSearchQuery(\'\')}\n                  className=\"absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 text-xs\"\n                >\n                  \342\234\225\n                </button>\n              )}\n            </div>\n          </div>\n\n          {/* Brand Filter Selector */}\n          <div className=\"hidden lg:flex items-center gap-2\">\n            <Building2 className=\"w-4 h-4 text-zinc-500\" />\n            <select\n              value={selectedBrandId}\n              onChange={(e) => setSelectedBrandId(e.target.value)}\n              className=\"bg-zinc-900 border border-zinc-800 text-xs text-zinc-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n            >\n              <option value=\"all\">Todas las Marcas (6 en Demo)</option>\n              {brands.map((b) => (\n                <option key={b.id} value={b.id}>\n                  {b.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Right Controls: AI Copilot & Role Switcher */}\n          <div className=\"flex items-center gap-3\">\n            \n            {/* AI Studio Copilot Button */}\n            <button\n              onClick={() => openAiModalWithContext({ brandId: selectedBrandId !== \'all\' ? selectedBrandId : brands[0].id })}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold shadow-md shadow-purple-600/20 transition-all border border-purple-400/30\"\n              title=\"Asistente de Producci\303\263n con Gemini AI\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Copilot AI</span>\n            </button>\n\n            {/* Role Switcher Dropdown (Interactive Persona Simulator) */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setIsRoleDropdownOpen(!isRoleDropdownOpen)}\n                className=\"flex items-center gap-2 p-1.5 rounded-lg bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 transition-all text-left\"\n                title=\"Cambiar rol activo para probar permisos\"\n              >\n                <img\n                  src={currentUser.avatar}\n                  alt={currentUser.name}\n                  className=\"w-7 h-7 rounded-full object-cover ring-1 ring-zinc-700\"\n                />\n                <div className=\"hidden xl:block\">\n                  <div className=\"text-xs font-medium text-zinc-200 flex items-center gap-1\">\n                    <span>{currentUser.name}</span>\n                    <span className={`text-[10px] px-1.5 py-0.2 rounded border font-semibold uppercase ${getRoleBadgeColor(currentUser.role)}`}>\n                      {currentUser.role}\n                    </span>\n                  </div>\n                  <div className=\"text-[10px] text-zinc-500 truncate max-w-[150px]\">\n                    {currentUser.roleTitle}\n                  </div>\n                </div>\n                <ChevronDown className=\"w-3.5 h-3.5 text-zinc-400\" />\n              </button>\n\n              {/* Persona Selector Menu */}\n              {isRoleDropdownOpen && (\n                <div className=\"absolute right-0 mt-2 w-80 rounded-xl bg-zinc-900 border border-zinc-800 shadow-2xl p-2 z-50 animate-in fade-in slide-in-from-top-2\">\n                  <div className=\"px-3 py-2 border-b border-zinc-800 mb-1\">\n                    <div className=\"text-xs font-semibold text-zinc-200\">Simulador de Roles (RBAC)</div>\n                    <div className=\"text-[11px] text-zinc-400\">\n                      Selecciona un usuario para explorar la aplicaci\303\263n desde su perspectiva y permisos.\n                    </div>\n                  </div>\n\n                  <div className=\"max-h-80 overflow-y-auto space-y-1 py-1\">\n                    {users.map((u) => {\n                      const isSelected = u.id === currentUser.id;\n                      return (\n                        <button\n                          key={u.id}\n                          onClick={() => {\n                            setCurrentUser(u);\n                            setIsRoleDropdownOpen(false);\n                          }}\n                          className={`w-full flex items-start gap-2.5 p-2 rounded-lg text-left transition-all ${\n                            isSelected\n                              ? \'bg-indigo-600/20 border border-indigo-500/40 text-white\'\n                              : \'hover:bg-zinc-800/60 text-zinc-300\'\n                          }`}\n                        >\n                          <img\n                            src={u.avatar}\n                            alt={u.name}\n                            className=\"w-8 h-8 rounded-full object-cover shrink-0 mt-0.5\"\n                          />\n                          <div className=\"flex-1 min-w-0\">\n                            <div className=\"flex items-center justify-between gap-1\">\n                              <span className=\"text-xs font-medium truncate\">{u.name}</span>\n                              <span\n                                className={`text-[9px] px-1 py-0.2 rounded border uppercase font-bold ${getRoleBadgeColor(\n                                  u.role\n                                )}`}\n                              >\n                                {u.role}\n                              </span>\n                            </div>\n                            <div className=\"text-[10px] text-zinc-400 truncate\">{u.roleTitle}</div>\n                            {u.quotaSlot && (\n                              <div className=\"text-[9px] text-indigo-400 font-mono mt-0.5\">{u.quotaSlot}</div>\n                            )}\n                          </div>\n                          {isSelected && <CheckCircle2 className=\"w-4 h-4 text-indigo-400 shrink-0 mt-1\" />}\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n              )}\n            </div>\n\n          </div>\n\n        </div>\n\n        {/* Navigation Tabs */}\n        <nav className=\"flex items-center gap-1 overflow-x-auto py-2 border-t border-zinc-800/60 text-xs no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'kanban\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'kanban\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>Tablero Kanban</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'calendar\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'calendar\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Calendar className=\"w-3.5 h-3.5 text-blue-400\" />\n            <span>Calendarios (Producci\303\263n & Lanzamiento)</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'brands\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'brands\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Building2 className=\"w-3.5 h-3.5 text-pink-400\" />\n            <span>Marcas, Territorios & Activos</span>\n            {invalidBrands.length > 0 && (\n              <span className=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'equipment\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'equipment\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Camera className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>Equipamiento & Reservas</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'specs\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'specs\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <FileCode className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Especificaciones & ERD</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'admin\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'admin\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <ShieldCheck className=\"w-3.5 h-3.5 text-purple-400\" />\n            <span>Gobernanza & WebAdmin</span>\n          </button>\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Film,\n  Users,\n  Calendar,\n  Layers,\n  Camera,\n  FileCode,\n  ShieldCheck,\n  Sparkles,\n  Search,\n  CheckCircle2,\n  ChevronDown,\n  Building2,\n  AlertTriangle,\n} from \'lucide-react\';\nimport { UserRole } from \'../types\';\n\nexport const Navbar: React.FC = () => {\n  const {\n    currentUser,\n    setCurrentUser,\n    users,\n    brands,\n    selectedBrandId,\n    setSelectedBrandId,\n    activeTab,\n    setActiveTab,\n    searchQuery,\n    setSearchQuery,\n    openAiModalWithContext,\n    validateBrandTerritories,\n  } = useApp();\n\n  const [isRoleDropdownOpen, setIsRoleDropdownOpen] = useState(false);\n\n  const getRoleBadgeColor = (role: UserRole) => {\n    switch (role) {\n      case \'webadmin\':\n        return \'bg-purple-500/10 text-purple-400 border-purple-500/30\';\n      case \'director\':\n        return \'bg-amber-500/10 text-amber-400 border-amber-500/30\';\n      case \'colaborador\':\n        return \'bg-blue-500/10 text-blue-400 border-blue-500/30\';\n      case \'cliente\':\n        return \'bg-emerald-500/10 text-emerald-400 border-emerald-500/30\';\n    }\n  };\n\n  // Check if any brand has less than 3 territories\n  const invalidBrands = brands.filter((b) => !validateBrandTerritories(b.id).isValid);\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-zinc-950/90 backdrop-blur-md border-b border-zinc-800/80\">\n      {/* Top Warning Banner if territory business rule is broken */}\n      {invalidBrands.length > 0 && (\n        <div className=\"bg-amber-500/15 border-b border-amber-500/30 px-4 py-1.5 text-xs text-amber-300 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-400 shrink-0\" />\n            <span>\n              <strong>Alerta de Regla de Negocio:</strong> {invalidBrands.length} marca(s) tienen menos de 3 territorios activos ({invalidBrands.map((b) => b.name).join(\', \')}).\n            </span>\n          </div>\n          <button\n            onClick={() => setActiveTab(\'brands\')}\n            className=\"underline font-medium hover:text-amber-200\"\n          >\n            Gestionar Territorios\n          </button>\n        </div>\n      )}\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-4\">\n          \n          {/* Logo & Platform Name */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/20 ring-1 ring-white/20\">\n              <Film className=\"w-5 h-5 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-bold text-white text-base tracking-tight\">CineFlow</span>\n                <span className=\"text-[10px] uppercase font-semibold px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700\">\n                  Studio OS\n                </span>\n              </div>\n              <p className=\"text-[11px] text-zinc-400 hidden sm:block\">Plataforma de Producci\303\263n Audiovisual & RBAC</p>\n            </div>\n          </div>\n\n          {/* Global Search Bar */}\n          <div className=\"flex-1 max-w-md hidden md:block\">\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Buscar entregables, equipos, marcas o c\303\263digos (e.g. CF-APX)...\"\n                className=\"w-full bg-zinc-900/80 border border-zinc-800 rounded-lg pl-9 pr-4 py-1.5 text-xs text-zinc-200 placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-all\"\n              />\n              {searchQuery && (\n                <button\n                  onClick={() => setSearchQuery(\'\')}\n                  className=\"absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 text-xs\"\n                >\n                  \342\234\225\n                </button>\n              )}\n            </div>\n          </div>\n\n          {/* Brand Filter Selector */}\n          <div className=\"hidden lg:flex items-center gap-2\">\n            <Building2 className=\"w-4 h-4 text-zinc-500\" />\n            <select\n              value={selectedBrandId}\n              onChange={(e) => setSelectedBrandId(e.target.value)}\n              className=\"bg-zinc-900 border border-zinc-800 text-xs text-zinc-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n            >\n              <option value=\"all\">Todas las Marcas (6 en Demo)</option>\n              {brands.map((b) => (\n                <option key={b.id} value={b.id}>\n                  {b.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Right Controls: AI Copilot & Role Switcher */}\n          <div className=\"flex items-center gap-3\">\n            \n            {/* AI Studio Copilot Button */}\n            <button\n              onClick={() => openAiModalWithContext({ brandId: selectedBrandId !== \'all\' ? selectedBrandId : brands[0].id })}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold shadow-md shadow-purple-600/20 transition-all border border-purple-400/30\"\n              title=\"Asistente de Producci\303\263n con Gemini AI\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Copilot AI</span>\n            </button>\n\n            {/* Role Switcher Dropdown (Interactive Persona Simulator) */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setIsRoleDropdownOpen(!isRoleDropdownOpen)}\n                className=\"flex items-center gap-2 p-1.5 rounded-lg bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 transition-all text-left\"\n                title=\"Cambiar rol activo para probar permisos\"\n              >\n                <img\n                  src={currentUser.avatar}\n                  alt={currentUser.name}\n                  className=\"w-7 h-7 rounded-full object-cover ring-1 ring-zinc-700\"\n                />\n                <div className=\"hidden xl:block\">\n                  <div className=\"text-xs font-medium text-zinc-200 flex items-center gap-1\">\n                    <span>{currentUser.name}</span>\n                    <span className={`text-[10px] px-1.5 py-0.2 rounded border font-semibold uppercase ${getRoleBadgeColor(currentUser.role)}`}>\n                      {currentUser.role}\n                    </span>\n                  </div>\n                  <div className=\"text-[10px] text-zinc-500 truncate max-w-[150px]\">\n                    {currentUser.roleTitle}\n                  </div>\n                </div>\n                <ChevronDown className=\"w-3.5 h-3.5 text-zinc-400\" />\n              </button>\n\n              {/* Persona Selector Menu */}\n              {isRoleDropdownOpen && (\n                <div className=\"absolute right-0 mt-2 w-80 rounded-xl bg-zinc-900 border border-zinc-800 shadow-2xl p-2 z-50 animate-in fade-in slide-in-from-top-2\">\n                  <div className=\"px-3 py-2 border-b border-zinc-800 mb-1\">\n                    <div className=\"text-xs font-semibold text-zinc-200\">Simulador de Roles (RBAC)</div>\n                    <div className=\"text-[11px] text-zinc-400\">\n                      Selecciona un usuario para explorar la aplicaci\303\263n desde su perspectiva y permisos.\n                    </div>\n                  </div>\n\n                  <div className=\"max-h-80 overflow-y-auto space-y-1 py-1\">\n                    {users.map((u) => {\n                      const isSelected = u.id === currentUser.id;\n                      return (\n                        <button\n                          key={u.id}\n                          onClick={() => {\n                            setCurrentUser(u);\n                            setIsRoleDropdownOpen(false);\n                          }}\n                          className={`w-full flex items-start gap-2.5 p-2 rounded-lg text-left transition-all ${\n                            isSelected\n                              ? \'bg-indigo-600/20 border border-indigo-500/40 text-white\'\n                              : \'hover:bg-zinc-800/60 text-zinc-300\'\n                          }`}\n                        >\n                          <img\n                            src={u.avatar}\n                            alt={u.name}\n                            className=\"w-8 h-8 rounded-full object-cover shrink-0 mt-0.5\"\n                          />\n                          <div className=\"flex-1 min-w-0\">\n                            <div className=\"flex items-center justify-between gap-1\">\n                              <span className=\"text-xs font-medium truncate\">{u.name}</span>\n                              <span\n                                className={`text-[9px] px-1 py-0.2 rounded border uppercase font-bold ${getRoleBadgeColor(\n                                  u.role\n                                )}`}\n                              >\n                                {u.role}\n                              </span>\n                            </div>\n                            <div className=\"text-[10px] text-zinc-400 truncate\">{u.roleTitle}</div>\n                            {u.quotaSlot && (\n                              <div className=\"text-[9px] text-indigo-400 font-mono mt-0.5\">{u.quotaSlot}</div>\n                            )}\n                          </div>\n                          {isSelected && <CheckCircle2 className=\"w-4 h-4 text-indigo-400 shrink-0 mt-1\" />}\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n              )}\n            </div>\n\n          </div>\n\n        </div>\n\n        {/* Navigation Tabs */}\n        <nav className=\"flex items-center gap-1 overflow-x-auto py-2 border-t border-zinc-800/60 text-xs no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'kanban\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'kanban\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>Tablero Kanban</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'calendar\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'calendar\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Calendar className=\"w-3.5 h-3.5 text-blue-400\" />\n            <span>Calendarios (Producci\303\263n & Lanzamiento)</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'brands\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'brands\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Building2 className=\"w-3.5 h-3.5 text-pink-400\" />\n            <span>Marcas, Territorios & Activos</span>\n            {invalidBrands.length > 0 && (\n              <span className=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'equipment\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'equipment\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Camera className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>Equipamiento & Reservas</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'specs\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'specs\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <FileCode className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Especificaciones & ERD</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'admin\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all shrink-0 ${\n              activeTab === \'admin\'\n                ? \'bg-zinc-800 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <ShieldCheck className=\"w-3.5 h-3.5 text-purple-400\" />\n            <span>Gobernanza & WebAdmin</span>\n          </button>\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 312
    num_bytes: 13612
  }
}
