        }
        lines {
          text: "                  className=\"px-4 py-1.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-xs cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
