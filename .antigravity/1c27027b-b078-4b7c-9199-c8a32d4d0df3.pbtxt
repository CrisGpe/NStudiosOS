          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        className={`p-4 rounded-xl border flex flex-wrap items-center justify-between gap-4 ${"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        className={`p-3 rounded-lg border flex flex-wrap items-center justify-between gap-3 ${"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          guide.directorSignOff?.approved"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
