    end_line: 234
    content: "import React from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  ShieldCheck,\n  Users,\n  Building2,\n  Camera,\n  Activity,\n  Server,\n  Database,\n  Lock,\n  Layers,\n  Sparkles,\n  CheckCircle2,\n  AlertTriangle,\n  Clock,\n} from \'lucide-react\';\n\nexport const WebAdminDashboard: React.FC = () => {\n  const {\n    users,\n    brands,\n    equipment,\n    deliverables,\n    auditLogs,\n    reservations,\n    validateBrandTerritories,\n    currentUser,\n  } = useApp();\n\n  const activeReservationsCount = equipment.filter((e) => e.status !== \'available\').length;\n  const hardwareUtilizationRate = Math.round((activeReservationsCount / equipment.length) * 100);\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header */}\n      <div className=\"bg-zinc-900/70 border border-zinc-800 rounded-2xl p-6 shadow-xl flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 shadow-md\">\n            <ShieldCheck className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <h2 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <span>Panel de Gobernanza & WebAdmin</span>\n              <span className=\"text-xs font-mono font-semibold px-2 py-0.5 rounded bg-purple-950/60 text-purple-300 border border-purple-500/30\">\n                Control Global RBAC\n              </span>\n            </h2>\n            <p className=\"text-xs text-zinc-400\">\n              Monitoreo de infraestructura, matriz de permisos, cuotas de colaboradores y registro de auditor\303\255a.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <span className=\"flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n            <span>Infraestructura Operativa</span>\n          </span>\n        </div>\n      </div>\n\n      {/* 4 Health Stats */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        \n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Marcas Activas</span>\n            <Building2 className=\"w-4 h-4 text-pink-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">{brands.length}</div>\n          <div className=\"text-[10px] text-emerald-400\">\n            6 de 6 marcas con territorios validados\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Cupos de Colaborador</span>\n            <Users className=\"w-4 h-4 text-blue-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">2 / 2 Asignados</div>\n          <div className=\"text-[10px] text-zinc-400\">\n            Carlos M\303\251ndez (Cupo #1) & Sof\303\255a Alarc\303\263n (Cupo #2)\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Utilizaci\303\263n de Hardware</span>\n            <Camera className=\"w-4 h-4 text-amber-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">{hardwareUtilizationRate}%</div>\n          <div className=\"text-[10px] text-amber-400\">\n            {activeReservationsCount} de {equipment.length} equipos bloqueados en rodaje\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Entregables en Pipeline</span>\n            <Layers className=\"w-4 h-4 text-indigo-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">{deliverables.length}</div>\n          <div className=\"text-[10px] text-indigo-400\">\n            En 7 fases de ciclo de vida\n          </div>\n        </div>\n\n      </div>\n\n      {/* RBAC Persona Matrix & Permissions Breakdown */}\n      <div className=\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-4\">\n        <h3 className=\"font-bold text-white text-sm flex items-center gap-2\">\n          <Lock className=\"w-4 h-4 text-purple-400\" />\n          <span>Matriz de Roles y Permisos del Sistema (RBAC)</span>\n        </h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"border-b border-zinc-800 bg-zinc-950/80 text-zinc-400 uppercase text-[10px]\">\n                <th className=\"p-3\">Rol del Sistema</th>\n                <th className=\"p-3\">Usuarios Asignados</th>\n                <th className=\"p-3\">Permisos & Capacidades de Negocio</th>\n                <th className=\"p-3\">Restricciones de Seguridad</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-zinc-800 text-zinc-300\">\n              \n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded border border-purple-500/30 font-mono\">\n                    WebAdmin\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">Alejandro Cruz</td>\n                <td className=\"p-3 text-zinc-300\">\n                  Control total del sistema, configuraci\303\263n de organizaciones, infraestructura, AI API Keys y auditor\303\255a de eventos.\n                </td>\n                <td className=\"p-3 text-emerald-400 font-mono text-[11px]\">Acceso Irrestricto</td>\n              </tr>\n\n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30 font-mono\">\n                    Director de Proyecto\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">Martina Sotomayor</td>\n                <td className=\"p-3 text-zinc-300\">\n                  Aprobaci\303\263n formal de Gu\303\255as T\303\251cnicas, asignaci\303\263n de equipos, balanceo de hardware, Override de Cambios T-3.\n                </td>\n                <td className=\"p-3 text-zinc-400 font-mono text-[11px]\">Sin acceso a infraestructura cloud</td>\n              </tr>\n\n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/30 font-mono\">\n                    Colaboradores (2 Cupos)\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">\n                  Carlos M\303\251ndez (Cupo #1), Sof\303\255a Alarc\303\263n (Cupo #2)\n                </td>\n                <td className=\"p-3 text-zinc-300\">\n                  Co-creaci\303\263n de ideas, ejecuci\303\263n t\303\251cnica audiovisual, actualizaci\303\263n de fases en Kanban, solicitud de reservas de hardware.\n                </td>\n                <td className=\"p-3 text-zinc-400 font-mono text-[11px]\">\n                  No autorizados para aprobar Gu\303\255a T\303\251cnica ni Override T-3\n                </td>\n              </tr>\n\n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30 font-mono\">\n                    Clientes (6 Marcas)\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">\n                  Representantes de Apex, Lumina, Kuro, Velox, Terra, Nova\n                </td>\n                <td className=\"p-3 text-zinc-300\">\n                  Co-creaci\303\263n de ideas, revisi\303\263n de calendarios (producci\303\263n/publicaci\303\263n), visualizaci\303\263n de gu\303\255a t\303\251cnica, solicitud de cambios.\n                </td>\n                <td className=\"p-3 text-red-400 font-mono text-[11px]\">\n                  Sujetos a bloqueo de cambios en ventana T-3 (\342\211\2443 d\303\255as)\n                </td>\n              </tr>\n\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Audit Logs Live Feed */}\n      <div className=\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"font-bold text-white text-sm flex items-center gap-2\">\n            <Activity className=\"w-4 h-4 text-emerald-400\" />\n            <span>Registro de Auditor\303\255a & Trazabilidad de Eventos</span>\n          </h3>\n          <span className=\"text-zinc-500 font-mono text-xs\">\n            {auditLogs.length} eventos registrados\n          </span>\n        </div>\n\n        <div className=\"space-y-2 max-h-80 overflow-y-auto custom-scrollbar\">\n          {auditLogs.map((log) => (\n            <div\n              key={log.id}\n              className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800/80 flex items-center justify-between text-xs hover:border-zinc-700 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-2 h-2 rounded-full bg-indigo-500 shrink-0\" />\n                <div>\n                  <span className=\"font-bold text-zinc-200\">{log.action}</span>\n                  <span className=\"text-zinc-400 ml-2 font-mono text-[11px]\">{log.entity}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-4 text-zinc-400 text-[11px]\">\n                <span>Por: <strong className=\"text-zinc-300\">{log.performedBy}</strong></span>\n                <span className=\"font-mono text-zinc-500\">{log.timestamp}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    raw_content: "import React from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  ShieldCheck,\n  Users,\n  Building2,\n  Camera,\n  Activity,\n  Server,\n  Database,\n  Lock,\n  Layers,\n  Sparkles,\n  CheckCircle2,\n  AlertTriangle,\n  Clock,\n} from \'lucide-react\';\n\nexport const WebAdminDashboard: React.FC = () => {\n  const {\n    users,\n    brands,\n    equipment,\n    deliverables,\n    auditLogs,\n    reservations,\n    validateBrandTerritories,\n    currentUser,\n  } = useApp();\n\n  const activeReservationsCount = equipment.filter((e) => e.status !== \'available\').length;\n  const hardwareUtilizationRate = Math.round((activeReservationsCount / equipment.length) * 100);\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header */}\n      <div className=\"bg-zinc-900/70 border border-zinc-800 rounded-2xl p-6 shadow-xl flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 shadow-md\">\n            <ShieldCheck className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <h2 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <span>Panel de Gobernanza & WebAdmin</span>\n              <span className=\"text-xs font-mono font-semibold px-2 py-0.5 rounded bg-purple-950/60 text-purple-300 border border-purple-500/30\">\n                Control Global RBAC\n              </span>\n            </h2>\n            <p className=\"text-xs text-zinc-400\">\n              Monitoreo de infraestructura, matriz de permisos, cuotas de colaboradores y registro de auditor\303\255a.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <span className=\"flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n            <span>Infraestructura Operativa</span>\n          </span>\n        </div>\n      </div>\n\n      {/* 4 Health Stats */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        \n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Marcas Activas</span>\n            <Building2 className=\"w-4 h-4 text-pink-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">{brands.length}</div>\n          <div className=\"text-[10px] text-emerald-400\">\n            6 de 6 marcas con territorios validados\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Cupos de Colaborador</span>\n            <Users className=\"w-4 h-4 text-blue-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">2 / 2 Asignados</div>\n          <div className=\"text-[10px] text-zinc-400\">\n            Carlos M\303\251ndez (Cupo #1) & Sof\303\255a Alarc\303\263n (Cupo #2)\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Utilizaci\303\263n de Hardware</span>\n            <Camera className=\"w-4 h-4 text-amber-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">{hardwareUtilizationRate}%</div>\n          <div className=\"text-[10px] text-amber-400\">\n            {activeReservationsCount} de {equipment.length} equipos bloqueados en rodaje\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-xl p-4 space-y-1\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs\">\n            <span>Entregables en Pipeline</span>\n            <Layers className=\"w-4 h-4 text-indigo-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white font-mono\">{deliverables.length}</div>\n          <div className=\"text-[10px] text-indigo-400\">\n            En 7 fases de ciclo de vida\n          </div>\n        </div>\n\n      </div>\n\n      {/* RBAC Persona Matrix & Permissions Breakdown */}\n      <div className=\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-4\">\n        <h3 className=\"font-bold text-white text-sm flex items-center gap-2\">\n          <Lock className=\"w-4 h-4 text-purple-400\" />\n          <span>Matriz de Roles y Permisos del Sistema (RBAC)</span>\n        </h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"border-b border-zinc-800 bg-zinc-950/80 text-zinc-400 uppercase text-[10px]\">\n                <th className=\"p-3\">Rol del Sistema</th>\n                <th className=\"p-3\">Usuarios Asignados</th>\n                <th className=\"p-3\">Permisos & Capacidades de Negocio</th>\n                <th className=\"p-3\">Restricciones de Seguridad</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-zinc-800 text-zinc-300\">\n              \n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded border border-purple-500/30 font-mono\">\n                    WebAdmin\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">Alejandro Cruz</td>\n                <td className=\"p-3 text-zinc-300\">\n                  Control total del sistema, configuraci\303\263n de organizaciones, infraestructura, AI API Keys y auditor\303\255a de eventos.\n                </td>\n                <td className=\"p-3 text-emerald-400 font-mono text-[11px]\">Acceso Irrestricto</td>\n              </tr>\n\n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30 font-mono\">\n                    Director de Proyecto\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">Martina Sotomayor</td>\n                <td className=\"p-3 text-zinc-300\">\n                  Aprobaci\303\263n formal de Gu\303\255as T\303\251cnicas, asignaci\303\263n de equipos, balanceo de hardware, Override de Cambios T-3.\n                </td>\n                <td className=\"p-3 text-zinc-400 font-mono text-[11px]\">Sin acceso a infraestructura cloud</td>\n              </tr>\n\n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/30 font-mono\">\n                    Colaboradores (2 Cupos)\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">\n                  Carlos M\303\251ndez (Cupo #1), Sof\303\255a Alarc\303\263n (Cupo #2)\n                </td>\n                <td className=\"p-3 text-zinc-300\">\n                  Co-creaci\303\263n de ideas, ejecuci\303\263n t\303\251cnica audiovisual, actualizaci\303\263n de fases en Kanban, solicitud de reservas de hardware.\n                </td>\n                <td className=\"p-3 text-zinc-400 font-mono text-[11px]\">\n                  No autorizados para aprobar Gu\303\255a T\303\251cnica ni Override T-3\n                </td>\n              </tr>\n\n              <tr className=\"hover:bg-zinc-950/40\">\n                <td className=\"p-3\">\n                  <span className=\"font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30 font-mono\">\n                    Clientes (6 Marcas)\n                  </span>\n                </td>\n                <td className=\"p-3 font-semibold text-white\">\n                  Representantes de Apex, Lumina, Kuro, Velox, Terra, Nova\n                </td>\n                <td className=\"p-3 text-zinc-300\">\n                  Co-creaci\303\263n de ideas, revisi\303\263n de calendarios (producci\303\263n/publicaci\303\263n), visualizaci\303\263n de gu\303\255a t\303\251cnica, solicitud de cambios.\n                </td>\n                <td className=\"p-3 text-red-400 font-mono text-[11px]\">\n                  Sujetos a bloqueo de cambios en ventana T-3 (\342\211\2443 d\303\255as)\n                </td>\n              </tr>\n\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Audit Logs Live Feed */}\n      <div className=\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"font-bold text-white text-sm flex items-center gap-2\">\n            <Activity className=\"w-4 h-4 text-emerald-400\" />\n            <span>Registro de Auditor\303\255a & Trazabilidad de Eventos</span>\n          </h3>\n          <span className=\"text-zinc-500 font-mono text-xs\">\n            {auditLogs.length} eventos registrados\n          </span>\n        </div>\n\n        <div className=\"space-y-2 max-h-80 overflow-y-auto custom-scrollbar\">\n          {auditLogs.map((log) => (\n            <div\n              key={log.id}\n              className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800/80 flex items-center justify-between text-xs hover:border-zinc-700 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-2 h-2 rounded-full bg-indigo-500 shrink-0\" />\n                <div>\n                  <span className=\"font-bold text-zinc-200\">{log.action}</span>\n                  <span className=\"text-zinc-400 ml-2 font-mono text-[11px]\">{log.entity}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-4 text-zinc-400 text-[11px]\">\n                <span>Por: <strong className=\"text-zinc-300\">{log.performedBy}</strong></span>\n                <span className=\"font-mono text-zinc-500\">{log.timestamp}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
