) => setActiveTab(\'ideate\')}\n              className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg transition-all ${\n                activeTab === \'ideate\'\n                  ? \'bg-purple-600 text-white shadow-md\'\n                  : \'bg-zinc-800/80 text-zinc-400 hover:text-zinc-200\'\n              }`}\n            >\n              <Lightbulb className=\"w-3.5 h-3.5\" />\n              <span>1. Ideaci\303\263n & Conceptos</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'techGuide\')}\n              className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg transition-all ${\n                activeTab === \'techGuide\'\n                  ? \'bg-purple-600 text-white shadow-md\'\n                  : \'bg-zinc-800/80 text-zinc-400 hover:text-zinc-200\'\n              }`}\n            >\n              <Cpu className=\"w-3.5 h-3.5\" />\n              <span>2. Compilador de Gu\303\255a T\303\251cnica</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto flex-1 space-y-6 text-xs text-zinc-300\">\n          \n          {/* TAB 1: IDEATION */}\n          {activeTab === \'ideate\' && (\n            <div className=\"space-y-5\">\n              \n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-zinc-400 font-medium mb-1\">Marca / Cliente *</label>\n                  <select\n                    value={selectedBrandId}\n                    onChange={(e) => {\n                      setSelectedBrandId(e.target.value);\n                      const terrs = territories.filter((t) => t.brandId === e.target.value && t.active);\n                      if (terrs[0]) setSelectedTerritoryId(terrs[0].id);\n                    }}\n                    className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                  >\n                    {brands.map((b) => (\n                      <option key={b.id} value={b.id}>\n                        {b.name} ({b.industry})\n                      </option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-zinc-400 font-medium mb-1\">Territorio de Comunicaci\303\263n *</label>\n                  <select\n                    value={selectedTerritoryId}\n                    onChange={(e) => setSelectedTerritoryId(e.target.value)}\n                    className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                  >\n                    {brandTerritories.map((t) => (\n                      <option key={t.id} value={t.id}>\n                        {t.name}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-zinc-400 font-medium mb-1\">Brief Creativo / Objetivo del Spot *</label>\n                <textarea\n                  value={creativeBrief}\n                  onChange={(e) => setCreativeBrief(e.target.value)}\n                  rows={3}\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                  placeholder=\"Describe la intenci\303\263n narrativa, arquetipo de personaje y llamado a la acci\303\263n...\"\n                />\n              </div>\n\n              <div className=\"flex justify-end\">\n                <button\n                  onClick={handleRunIdeation}\n                  disabled={isIdeating}\n                  className=\"flex items-center gap-2 px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold shadow-lg shadow-purple-600/30 transition-all disabled:opacity-50\"\n                >\n                  <Sparkles className=\"w-4 h-4\" />\n                  <span>{isIdeating ? \'Generando Conceptos con Gemini...\' : \'Generar 3 Propuestas Creativas\'}</span>\n                </button>\n              </div>\n\n              {/* Generated Ideas Result Cards */}\n              {generatedIdeas.length > 0 && (\n                <div className=\"space-y-4 pt-4 border-t border-zinc-800\">\n                  <h4 className=\"font-bold text-white text-sm flex items-center gap-2\">\n                    <Lightbulb className=\"w-4 h-4 text-amber-400\" />\n                    <span>Propuestas Creativas Co-creadas</span>\n                  </h4>\n\n                  <div className=\"space-y-3\">\n                    {generatedIdeas.map((idea, iIdx) => (\n                      <div\n                        key={iIdx}\n                        className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 space-y-3 hover:border-purple-500/50 transition-all\"\n                      >\n                        <div className=\"flex items-start justify-between gap-3\">\n                          <div>\n                            <span className=\"text-[10px] uppercase font-bold text-purple-400 font-mono\">\n                              Propuesta #{iIdx + 1} \342\200\242 {idea.format || \'9:16 UHD\'}\n                            </span>\n                            <h5 className=\"text-sm font-bold text-white mt-0.5\">{idea.title}</h5>\n                          </div>\n\n                          <button\n                            onClick={() => handleApplyIdeaAsDeliverable(idea)}\n                            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-md shrink-0\"\n                          >\n                            <span>Convertir en Entregable</span>\n                            <ChevronRight className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n\n                        {/* Hook */}\n                        <div className=\"bg-indigo-950/30 p-2.5 rounded-lg border border-indigo-500/20\">\n                          <span className=\"text-[10px] font-bold text-indigo-300 block mb-0.5\">\n                            Hook de 3 Segundos:\n                          </span>\n                          <p className=\"text-indigo-100 italic\">\"{idea.hook}\"</p>\n                        </div>\n\n                        {/* Narrative */}\n                        <p className=\"text-zinc-300 leading-relaxed text-xs\">\n                          {idea.narrativeConcept}\n                        </p>\n\n                        {/* Tags */}\n                        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] pt-1\">\n                          <div className=\"text-zinc-400\">\n                            <strong>Estilo Visual:</strong> {idea.visualStyle}\n                          </div>\n                          <div className=\"text-zinc-400\">\n                            <strong>Dise\303\261o Sonoro:</strong> {idea.audioDesign}\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n            </div>\n          )}\n\n          {/* TAB 2: TECHNICAL GUIDE COMPILER */}\n          {activeTab === \'techGuide\' && (\n            <div className=\"space-y-5\">\n              \n              <div>\n                <label className=\"block text-zinc-400 font-medium mb-1\">Entregable a Compilar *</label>\n                <select\n                  value={targetDeliverableId}\n                  onChange={(e) => setTargetDeliverableId(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                >\n                  {deliverables.map((del) => {\n                    const b = brands.find((brand) => brand.id === del.brandId);\n                    return (\n                      <option key={del.id} value={del.id}>\n                        [{del.code}] {del.title} ({b?.name})\n                      </option>\n                    );\n                  })}\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-zinc-400 font-medium mb-1\">Instrucciones de Estilo & Cinematograf\303\255a</label>\n                <textarea\n                  value={techStyleNotes}\n                  onChange={(e) => setTechStyleNotes(e.target.value)}\n                  rows={3}\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                  placeholder=\"Detalles sobre temperatura de color, tipo de lente (anam\303\263rfico/esf\303\251rico), movimientos de c\303\241mara...\"\n                />\n              </div>\n\n              <div className=\"flex justify-end\">\n                <button\n                  onClick={handleRunTechGuideGeneration}\n                  disabled={isGeneratingGuide}\n                  className=\"flex items-center gap-2 px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold shadow-lg disabled:opacity-50\"\n                >\n                  <Cpu className=\"w-4 h-4\" />\n                  <span>{isGeneratingGuide ? \'Compilando Gu\303\255a T\303\251cnica...\' : \'Compilar Gu\303\255a T\303\251cnica & Shotlist\'}</span>\n                </button>\n              </div>\n\n              {/* Generated Tech Guide Result */}\n              {generatedGuideResult && (\n                <div className=\"bg-zinc-950 p-5 rounded-2xl border border-zinc-800 space-y-4 pt-4 animate-in fade-in\">\n                  <div className=\"flex items-center justify-between\">\n                    <h4 className=\"font-bold text-white text-sm flex items-center gap-2\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                      <span>Gu\303\255a T\303\251cnica Compilada con \303\211xito</span>\n                    </h4>\n\n                    <button\n                      onClick={handleApplyTechGuideToDeliverable}\n                      className=\"px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-md\"\n                    >\n                      Sincronizar con Entregable\n                    </button>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-3 text-xs\">\n                    <div className=\"bg-zinc-900 p-3 rounded-lg border border-zinc-800\">\n                      <span className=\"text-zinc-500 text-[10px] block\">Ratios & Formato</span>\n                      <span className=\"font-mono text-zinc-200\">\n                        {generatedGuideResult.aspectRatios?.join(\', \')} \342\200\242 {generatedGuideResult.frameRate}\n                      </span>\n                    </div>\n\n                    <div className=\"bg-zinc-900 p-3 rounded-lg border border-zinc-800\">\n                      <span className=\"text-zinc-500 text-[10px] block\">Perfil de Color</span>\n                      <span className=\"font-mono text-zinc-200\">{generatedGuideResult.colorSpace}</span>\n                    </div>\n                  </div>\n\n                  {/* Shotlist table */}\n                  {generatedGuideResult.shotlist && (\n                    <div className=\"space-y-2\">\n                      <span className=\"font-bold text-zinc-200\">Shotlist Cinematogr\303\241fico:</span>\n                      <div className=\"overflow-x-auto\">\n                        <table className=\"w-full text-left text-[11px] border-collapse\">\n                          <thead>\n                            <tr className=\"border-b border-zinc-800 text-zinc-500 uppercase\">\n                              <th className=\"py-1.5 px-2\">#</th>\n                              <th className=\"py-1.5 px-2\">Descripci\303\263n</th>\n                              <th className=\"py-1.5 px-2\">\303\201ngulo</th>\n                              <th className=\"py-1.5 px-2\">Movimiento</th>\n                              <th className=\"py-1.5 px-2\">Duraci\303\263n</th>\n                            </tr>\n                          </thead>\n                          <tbody className=\"divide-y divide-zinc-800/60\">\n                            {generatedGuideResult.shotlist.map((s: any, idx: number) => (\n                              <tr key={idx}>\n                                <td className=\"py-1.5 px-2 font-mono text-indigo-400\">#{idx + 1}</td>\n                                <td className=\"py-1.5 px-2 text-zinc-200\">{s.description}</td>\n                                <td className=\"py-1.5 px-2 text-zinc-400 font-mono\">{s.cameraAngle}</td>\n                                <td className=\"py-1.5 px-2 text-zinc-400\">{s.movement}</td>\n                                <td className=\"py-1.5 px-2 font-mono text-amber-400\">{s.durationSec}s</td>\n                              </tr>\n                            ))}\n                          </tbody>\n                        </table>\n                      </div>\n                    </div>\n                  )}\n\n                </div>\n              )}\n\n            </div>\n          )}\n\n        </div>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-2 sm:p-4 overflow-y-auto\">\n      <div className=\"bg-white border border-slate-200 rounded-lg max-w-3xl w-full shadow-xl overflow-hidden my-auto max-h-[92vh] flex flex-col animate-in fade-in zoom-in-95\">\n        \n        {/* Header */}\n        <div className=\"p-3.5 border-b border-slate-200 bg-slate-50 shrink-0\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-purple-50 border border-purple-200 flex items-center justify-center text-purple-700 shadow-2xs\">\n                <Sparkles className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-1.5\">\n                  <span>Asistente de Producci\303\263n Audiovisual</span>\n                  <span className=\"text-[9px] uppercase font-mono px-1.5 py-0.2 rounded bg-purple-100 text-purple-800 border border-purple-200 font-semibold\">\n                    Gemini Flash Thinking\n                  </span>\n                </h2>\n                <p className=\"text-[11px] text-slate-500\">\n                  Co-creaci\303\263n conceptual, compilaci\303\263n de shotlists cinematogr\303\241ficos y an\303\241lisis de impacto T-3.\n                </p>\n              </div>\n            </div>\n\n            <button\n              onClick={() => setIsAiModalOpen(false)}\n              className=\"p-1 rounded-md bg-white border border-slate-200 text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Mode Switcher */}\n          <div className=\"flex items-center gap-1.5 mt-3 text-xs font-semibold\">\n            <button\n              onClick={() => setActiveTab(\'ideate\')}\n              className={`flex items-center gap-1 px-3 py-1.5 rounded-md transition-all cursor-pointer ${\n                activeTab === \'ideate\'\n                  ? \'bg-purple-700 text-white shadow-xs\'\n                  : \'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100\'\n              }`}\n            >\n              <Lightbulb className=\"w-3.5 h-3.5\" />\n              <span>1. Ideaci\303\263n & Conceptos</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'techGuide\')}\n              className={`flex items-center gap-1 px-3 py-1.5 rounded-md transition-all cursor-pointer ${\n                activeTab === \'techGuide\'\n                  ? \'bg-purple-700 text-white shadow-xs\'\n                  : \'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100\'\n              }`}\n            >\n              <Cpu className=\"w-3.5 h-3.5\" />\n              <span>2. Compilador de Gu\303\255a T\303\251cnica</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-4 overflow-y-auto flex-1 space-y-4 text-xs text-slate-700\">\n          \n          {/* TAB 1: IDEATION */}\n          {activeTab === \'ideate\' && (\n            <div className=\"space-y-3.5\">\n              \n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1 text-[11px]\">Marca / Cliente *</label>\n                  <select\n                    value={selectedBrandId}\n                    onChange={(e) => {\n                      setSelectedBrandId(e.target.value);\n                      const terrs = territories.filter((t) => t.brandId === e.target.value && t.active);\n                      if (terrs[0]) setSelectedTerritoryId(terrs[0].id);\n                    }}\n                    className=\"w-full bg-white border border-slate-300 rounded-md px-2.5 py-1.5 text-slate-900 text-xs\"\n                  >\n                    {brands.map((b) => (\n                      <option key={b.id} value={b.id}>\n                        {b.name} ({b.industry})\n                      </option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-600 font-medium mb-1 text-[11px]\">Territorio de Comunicaci\303\263n *</label>\n                  <select\n                    value={selectedTerritoryId}\n                    onChange={(e) => setSelectedTerritoryId(e.target.value)}\n                    className=\"w-full bg-white border border-slate-300 rounded-md px-2.5 py-1.5 text-slate-900 text-xs\"\n                  >\n                    {brandTerritories.map((t) => (\n                      <option key={t.id} value={t.id}>\n                        {t.name}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-slate-600 font-medium mb-1 text-[11px]\">Brief Creativo / Objetivo del Spot *</label>\n                <textarea\n                  value={creativeBrief}\n                  onChange={(e) => setCreativeBrief(e.target.value)}\n                  rows={2}\n                  className=\"w-full bg-white border border-slate-300 rounded-md px-2.5 py-1.5 text-slate-900 text-xs\"\n                  placeholder=\"Describe la intenci\303\263n narrativa, arquetipo de personaje y llamado a la acci\303\263n...\"\n                />\n              </div>\n\n              <div className=\"flex justify-end\">\n                <button\n                  onClick={handleRunIdeation}\n                  disabled={isIdeating}\n                  className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-purple-700 hover:bg-purple-800 text-white font-semibold text-xs shadow-xs transition-all disabled:opacity-50 cursor-pointer\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>{isIdeating ? \'Generando Conceptos...\' : \'Generar 3 Propuestas Creativas\'}</span>\n                </button>\n              </div>\n\n              {/* Generated Ideas Result Cards */}\n              {generatedIdeas.length > 0 && (\n                <div className=\"space-y-3 pt-3 border-t border-slate-200\">\n                  <h4 className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5\">\n                    <Lightbulb className=\"w-3.5 h-3.5 text-amber-600\" />\n                    <span>Propuestas Creativas Co-creadas</span>\n                  </h4>\n\n                  <div className=\"space-y-2.5\">\n                    {generatedIdeas.map((idea, iIdx) => (\n                      <div\n                        key={iIdx}\n                        className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2 hover:border-purple-300 transition-all\"\n                      >\n                        <div className=\"flex items-start justify-between gap-3\">\n                          <div>\n                            <span className=\"text-[9px] uppercase font-bold text-purple-700 font-mono\">\n                              Propuesta #{iIdx + 1} \342\200\242 {idea.format || \'9:16 UHD\'}\n                            </span>\n                            <h5 className=\"text-xs font-bold text-slate-900 mt-0.5\">{idea.title}</h5>\n                          </div>\n\n                          <button\n                            onClick={() => handleApplyIdeaAsDeliverable(idea)}\n                            className=\"flex items-center gap-1 px-2.5 py-1 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-[11px] shadow-2xs shrink-0 cursor-pointer\"\n                          >\n                            <span>Convertir en Entregable</span>\n                            <ChevronRight className=\"w-3 h-3\" />\n                          </button>\n                        </div>\n\n                        {/* Hook */}\n                        <div className=\"bg-indigo-50/80 p-2 rounded-md border border-indigo-200\">\n                          <span className=\"text-[9px] font-bold text-indigo-800 block mb-0.2\">\n                            Hook de 3 Segundos:\n                          </span>\n                          <p className=\"text-indigo-950 italic text-[11px]\">\"{idea.hook}\"</p>\n                        </div>\n\n                        {/* Narrative */}\n                        <p className=\"text-slate-700 leading-relaxed text-[11px]\">\n                          {idea.narrativeConcept}\n                        </p>\n\n                        {/* Tags */}\n                        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[10px] pt-1 border-t border-slate-200/80\">\n                          <div className=\"text-slate-600\">\n                            <strong className=\"text-slate-800\">Estilo Visual:</strong> {idea.visualStyle}\n                          </div>\n                          <div className=\"text-slate-600\">\n                            <strong className=\"text-slate-800\">Dise\303\261o Sonoro:</strong> {idea.audioDesign}\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n            </div>\n          )}\n\n          {/* TAB 2: TECHNICAL GUIDE COMPILER */}\n          {activeTab === \'techGuide\' && (\n            <div className=\"space-y-3.5\">\n              \n              <div>\n                <label className=\"block text-slate-600 font-medium mb-1 text-[11px]\">Entregable a Compilar *</label>\n                <select\n                  value={targetDeliverableId}\n                  onChange={(e) => setTargetDeliverableId(e.target.value)}\n                  className=\"w-full bg-white border border-slate-300 rounded-md px-2.5 py-1.5 text-slate-900 text-xs\"\n                >\n                  {deliverables.map((del) => {\n                    const b = brands.find((brand) => brand.id === del.brandId);\n                    return (\n                      <option key={del.id} value={del.id}>\n                        [{del.code}] {del.title} ({b?.name})\n                      </option>\n                    );\n                  })}\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-slate-600 font-medium mb-1 text-[11px]\">Instrucciones de Estilo & Cinematograf\303\255a</label>\n                <textarea\n                  value={techStyleNotes}\n                  onChange={(e) => setTechStyleNotes(e.target.value)}\n                  rows={2}\n                  className=\"w-full bg-white border border-slate-300 rounded-md px-2.5 py-1.5 text-slate-900 text-xs\"\n                  placeholder=\"Detalles sobre temperatura de color, tipo de lente (anam\303\263rfico/esf\303\251rico), movimientos de c\303\241mara...\"\n                />\n              </div>\n\n              <div className=\"flex justify-end\">\n                <button\n                  onClick={handleRunTechGuideGeneration}\n                  disabled={isGeneratingGuide}\n                  className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-purple-700 hover:bg-purple-800 text-white font-semibold text-xs shadow-xs disabled:opacity-50 cursor-pointer\"\n                >\n                  <Cpu className=\"w-3.5 h-3.5\" />\n                  <span>{isGeneratingGuide ? \'Compilando Gu\303\255a T\303\251cnica...\' : \'Compilar Gu\303\255a T\303\251cnica & Shotlist\'}</span>\n                </button>\n              </div>\n\n              {/* Generated Tech Guide Result */}\n              {generatedGuideResult && (\n                <div className=\"bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-3 pt-3 animate-in fade-in\">\n                  <div className=\"flex items-center justify-between\">\n                    <h4 className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                      <span>Gu\303\255a T\303\251cnica Compilada con \303\211xito</span>\n                    </h4>\n\n                    <button\n                      onClick={handleApplyTechGuideToDeliverable}\n                      className=\"px-3 py-1 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs shadow-2xs cursor-pointer\"\n                    >\n                      Sincronizar con Entregable\n                    </button>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                    <div className=\"bg-white p-2 rounded-md border border-slate-200\">\n                      <span className=\"text-slate-500 text-[9px] block\">Ratios & Formato</span>\n                      <span className=\"font-mono text-slate-800 text-[11px]\">\n                        {generatedGuideResult.aspectRatios?.join(\', \')} \342\200\242 {generatedGuideResult.frameRate}\n                      </span>\n                    </div>\n\n                    <div className=\"bg-white p-2 rounded-md border border-slate-200\">\n                      <span className=\"text-slate-500 text-[9px] block\">Perfil de Color</span>\n                      <span className=\"font-mono text-slate-800 text-[11px]\">{generatedGuideResult.colorSpace}</span>\n                    </div>\n                  </div>\n\n                  {/* Shotlist table */}\n                  {generatedGuideResult.shotlist && (\n                    <div className=\"space-y-1.5\">\n                      <span className=\"font-bold text-slate-800 text-[11px]\">Shotlist Cinematogr\303\241fico:</span>\n                      <div className=\"overflow-x-auto\">\n                        <table className=\"w-full text-left text-[11px] border-collapse\">\n                          <thead>\n                            <tr className=\"border-b border-slate-200 text-slate-500 uppercase text-[9px]\">\n                              <th className=\"py-1 px-1.5\">#</th>\n                              <th className=\"py-1 px-2\">Descripci\303\263n</th>\n                              <th className=\"py-1 px-1.5\">\303\201ngulo</th>\n                              <th className=\"py-1 px-1.5\">Movimiento</th>\n                              <th className=\"py-1 px-1.5\">Duraci\303\263n</th>\n                            </tr>\n                          </thead>\n                          <tbody className=\"divide-y divide-slate-200\">\n                            {generatedGuideResult.shotlist.map((s: any, idx: number) => (\n                              <tr key={idx} className=\"hover:bg-slate-100\">\n                                <td className=\"py-1 px-1.5 font-mono text-indigo-700 font-bold\">#{idx + 1}</td>\n                                <td className=\"py-1 px-2 text-slate-900\">{s.description}</td>\n                                <td className=\"py-1 px-1.5 text-slate-600 font-mono\">{s.cameraAngle}</td>\n                                <td className=\"py-1 px-1.5 text-slate-600\">{s.movement}</td>\n                                <td className=\"py-1 px-1.5 font-mono text-amber-700 font-bold\">{s.durationSec}s</td>\n                              </tr>\n                            ))}\n                          </tbody>\n                        </table>\n                      </div>\n                    </div>\n                  )}\n\n                </div>\n              )}\n\n            </div>\n          )}\n\n        </div>\n      </div>\n    </div>\n  );"
