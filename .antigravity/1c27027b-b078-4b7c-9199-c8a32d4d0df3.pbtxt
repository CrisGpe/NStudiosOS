  view_file {
    absolute_path_uri: "file:///src/components/DeliverableDetailModal.tsx"
    end_line: 627
    content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Deliverable,\n  DeliverablePhase,\n  ChangeRequest,\n} from \'../types\';\nimport {\n  X,\n  Calendar,\n  Layers,\n  Camera,\n  AlertTriangle,\n  FileCheck2,\n  Clock,\n  Sparkles,\n  User,\n  Building2,\n  ExternalLink,\n  ChevronRight,\n  ShieldAlert,\n  CheckCircle2,\n  XCircle,\n  Video,\n  DollarSign,\n} from \'lucide-react\';\nimport { TechnicalGuideViewer } from \'./TechnicalGuideViewer\';\n\nconst PHASE_STEPS: { id: DeliverablePhase; label: string; tag: string }[] = [\n  { id: \'ideacion\', label: \'Ideaci\303\263n\', tag: \'D1-15\' },\n  { id: \'calendarizacion\', label: \'Calendarizaci\303\263n\', tag: \'D15-20\' },\n  { id: \'guia_tecnica\', label: \'Gu\303\255a T\303\251cnica\', tag: \'D20-Fin\' },\n  { id: \'produccion\', label: \'Rodaje\', tag: \'Set\' },\n  { id: \'post_produccion\', label: \'Post-Prod\', tag: \'Color/VFX\' },\n  { id: \'aprobacion_cliente\', label: \'Aprobaci\303\263n\', tag: \'Ventana T-3\' },\n  { id: \'publicado\', label: \'Publicado\', tag: \'Listo\' },\n];\n\nexport const DeliverableDetailModal: React.FC = () => {\n  const {\n    selectedDeliverable,\n    setSelectedDeliverable,\n    brands,\n    territories,\n    users,\n    equipment,\n    moveDeliverablePhase,\n    submitChangeRequest,\n    evaluateChangeRequestStatus,\n    currentUser,\n    openAiModalWithContext,\n  } = useApp();\n\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'changes\' | \'guide\' | \'equipment\'>(\'overview\');\n\n  // Change request form state\n  const [changeTitle, setChangeTitle] = useState(\'\');\n  const [changeReason, setChangeReason] = useState(\'Edici\303\263n y Ritmo\');\n  const [changeDesc, setChangeDesc] = useState(\'\');\n  const [isAiEvaluating, setIsAiEvaluating] = useState(false);\n  const [aiAnalysisResult, setAiAnalysisResult] = useState<any>(null);\n\n  if (!selectedDeliverable) return null;\n\n  const brand = brands.find((b) => b.id === selectedDeliverable.brandId);\n  const territory = territories.find((t) => t.id === selectedDeliverable.territoryId);\n  const assignee = users.find((u) => u.id === selectedDeliverable.assigneeId);\n  const reservedGear = equipment.filter((e) => selectedDeliverable.equipmentReservedIds.includes(e.id));\n\n  // T-3 calculation\n  const now = new Date(\'2026-08-17\').getTime();\n  const pub = new Date(selectedDeliverable.publishDate).getTime();\n  const daysToPublish = Math.ceil((pub - now) / (1000 * 60 * 60 * 24));\n  const isTMinus3Active = daysToPublish <= 3 && daysToPublish >= 0;\n\n  const currentPhaseIndex = PHASE_STEPS.findIndex((p) => p.id === selectedDeliverable.phase);\n\n  const handleCreateChangeRequest = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!changeTitle.trim() || !changeDesc.trim()) return;\n\n    submitChangeRequest(selectedDeliverable.id, {\n      title: changeTitle,\n      reason: changeReason,\n      description: changeDesc,\n      requestedById: currentUser.id,\n      requestedByName: currentUser.name,\n    });\n\n    setChangeTitle(\'\');\n    setChangeDesc(\'\');\n    setAiAnalysisResult(null);\n  };\n\n  const handleEvaluateWithAI = async () => {\n    if (!changeDesc.trim()) {\n      alert(\'Por favor escribe primero la descripci\303\263n del cambio solicitado para que Gemini pueda evaluarlo.\');\n      return;\n    }\n\n    setIsAiEvaluating(true);\n    try {\n      const response = await fetch(\'/api/gemini/evaluate-change\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          deliverable: selectedDeliverable,\n          changeRequestDescription: `${changeTitle} (${changeReason}): ${changeDesc}`,\n          daysToPublish,\n        }),\n      });\n\n      const data = await response.json();\n      setAiAnalysisResult(data);\n    } catch (err) {\n      console.error(err);\n      alert(\'Error evaluando el cambio con IA\');\n    } finally {\n      setIsAiEvaluating(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-2 sm:p-4 overflow-y-auto\">\n      <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-4xl w-full shadow-2xl overflow-hidden my-auto max-h-[92vh] flex flex-col animate-in fade-in zoom-in-95\">\n        \n        {/* Modal Header */}\n        <div className=\"p-5 border-b border-zinc-800 bg-zinc-950/80 shrink-0\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"font-mono font-bold text-xs px-2 py-0.5 rounded bg-zinc-900 text-indigo-400 border border-zinc-800\">\n                  {selectedDeliverable.code}\n                </span>\n                <span className=\"text-xs uppercase font-bold px-2 py-0.5 rounded border bg-blue-500/10 text-blue-400 border-blue-500/30\">\n                  {selectedDeliverable.priority}\n                </span>\n                <span className=\"text-xs text-zinc-400 font-mono\">\n                  {selectedDeliverable.format}\n                </span>\n              </div>\n\n              <h2 className=\"text-lg sm:text-xl font-bold text-white mt-1 leading-snug\">\n                {selectedDeliverable.title}\n              </h2>\n\n              <div className=\"flex items-center gap-4 text-xs text-zinc-400 mt-1.5 flex-wrap\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span\n                    className=\"w-2.5 h-2.5 rounded-full shrink-0\"\n                    style={{ backgroundColor: brand?.primaryColor || \'#6366f1\' }}\n                  />\n                  <span className=\"text-zinc-200 font-semibold\">{brand?.name}</span>\n                </div>\n                {territory && (\n                  <span className=\"text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800\">\n                    \360\237\216\257 {territory.name}\n                  </span>\n                )}\n                {assignee && (\n                  <span className=\"text-zinc-400\">\n                    \360\237\221\244 Asignado: <strong className=\"text-zinc-300\">{assignee.name}</strong>\n                  </span>\n                )}\n              </div>\n            </div>\n\n            <button\n              onClick={() => setSelectedDeliverable(null)}\n              className=\"p-1.5 rounded-lg bg-zinc-800 text-zinc-400 hover:text-white hover:bg-zinc-700 transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Stepper: Phase Progress Bar */}\n          <div className=\"mt-5 pt-4 border-t border-zinc-800/80\">\n            <div className=\"grid grid-cols-7 gap-1 text-center\">\n              {PHASE_STEPS.map((step, sIdx) => {\n                const isCurrent = sIdx === currentPhaseIndex;\n                const isPassed = sIdx < currentPhaseIndex;\n\n                return (\n                  <button\n                    key={step.id}\n                    onClick={() => moveDeliverablePhase(selectedDeliverable.id, step.id)}\n                    className={`p-1.5 rounded-lg transition-all text-left flex flex-col justify-between ${\n                      isCurrent\n                        ? \'bg-indigo-600 text-white font-bold shadow-md ring-1 ring-white/20\'\n                        : isPassed\n                        ? \'bg-zinc-800 text-zinc-300 font-medium\'\n                        : \'bg-zinc-950 text-zinc-500 hover:bg-zinc-800/60\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-[10px] w-full\">\n                      <span className=\"font-mono\">#{sIdx + 1}</span>\n                      <span className=\"text-[9px] opacity-80\">{step.tag}</span>\n                    </div>\n                    <div className=\"text-[11px] truncate mt-0.5 font-semibold\">{step.label}</div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Navigation Sub-Tabs */}\n        <div className=\"flex items-center gap-2 px-6 pt-3 border-b border-zinc-800 bg-zinc-950/40 text-xs shrink-0\">\n          <button\n            onClick={() => setActiveTab(\'overview\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 ${\n              activeTab === \'overview\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            Visi\303\263n General & Fechas\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'changes\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 flex items-center gap-1.5 ${\n              activeTab === \'changes\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            <span>Control de Cambios & Regla T-3</span>\n            {isTMinus3Active && (\n              <span className=\"px-1.5 py-0.2 rounded bg-red-500 text-white text-[9px] font-bold\">\n                T-3\n              </span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'guide\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 ${\n              activeTab === \'guide\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            Gu\303\255a T\303\251cnica & Shotlist\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'equipment\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 ${\n              activeTab === \'equipment\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            Hardware & Reservas ({reservedGear.length})\n          </button>\n        </div>\n\n        {/* Modal Body Content */}\n        <div className=\"p-6 overflow-y-auto flex-1 space-y-6\">\n          \n          {/* TAB 1: OVERVIEW */}\n          {activeTab === \'overview\' && (\n            <div className=\"space-y-6 text-xs text-zinc-300\">\n              \n              {/* Key Timeline Milestone Grid */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  <div className=\"flex items-center gap-1.5 text-zinc-400 mb-1\">\n                    <Video className=\"w-4 h-4 text-rose-400\" />\n                    <span>Fechas de Rodaje (Producci\303\263n)</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-white font-mono\">\n                    {selectedDeliverable.productionStartDate} al {selectedDeliverable.productionEndDate}\n                  </div>\n                </div>\n\n                <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  <div className=\"flex items-center gap-1.5 text-zinc-400 mb-1\">\n                    <Calendar className=\"w-4 h-4 text-teal-400\" />\n                    <span>Fecha de Publicaci\303\263n Oficial</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-white font-mono\">\n                    {selectedDeliverable.publishDate}\n                  </div>\n                </div>\n\n                <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  <div className=\"flex items-center gap-1.5 text-zinc-400 mb-1\">\n                    <Clock className=\"w-4 h-4 text-amber-400\" />\n                    <span>Cuenta Regresiva a Estreno</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-amber-300 font-mono\">\n                    {daysToPublish} d\303\255as restantes\n                  </div>\n                </div>\n              </div>\n\n              {/* Concept Hook / Logline */}\n              {selectedDeliverable.conceptHook && (\n                <div className=\"bg-indigo-950/20 border border-indigo-500/30 p-4 rounded-xl space-y-1\">\n                  <span className=\"text-[10px] uppercase font-bold text-indigo-400\">\n                    \360\237\216\257 Hook Inicial / Logline (0-3 Segundos)\n                  </span>\n                  <p className=\"text-sm font-medium text-indigo-200 italic\">\n                    \"{selectedDeliverable.conceptHook}\"\n                  </p>\n                </div>\n              )}\n\n              {/* Description */}\n              <div className=\"space-y-1.5\">\n                <span className=\"font-bold text-zinc-200\">Concepto Narrativo & Propuesta Visual:</span>\n                <p className=\"text-xs text-zinc-300 leading-relaxed bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  {selectedDeliverable.description}\n                </p>\n              </div>\n\n              {/* Assets Linked */}\n              {selectedDeliverable.assetsLinked && selectedDeliverable.assetsLinked.length > 0 && (\n                <div className=\"space-y-2\">\n                  <span className=\"font-bold text-zinc-200\">Activos Digitales de Marca Vinculados:</span>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {selectedDeliverable.assetsLinked.map((asset, aIdx) => (\n                      <span\n                        key={aIdx}\n                        className=\"px-3 py-1.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-300 font-mono flex items-center gap-1.5\"\n                      >\n                        <ExternalLink className=\"w-3.5 h-3.5 text-zinc-500\" />\n                        {asset}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n            </div>\n          )}\n\n          {/* TAB 2: CHANGE REQUESTS & T-3 POLICY */}\n          {activeTab === \'changes\' && (\n            <div className=\"space-y-6 text-xs text-zinc-300\">\n              \n              {/* T-3 Policy Banner */}\n              <div\n                className={`p-4 rounded-xl border ${\n                  isTMinus3Active\n                    ? \'bg-red-500/15 border-red-500/40 text-red-200\'\n                    : \'bg-zinc-950 border-zinc-800 text-zinc-300\'\n                }`}\n              >\n                <div className=\"flex items-start gap-3\">\n                  <ShieldAlert\n                    className={`w-6 h-6 shrink-0 ${\n                      isTMinus3Active ? \'text-red-400\' : \'text-amber-400\'\n                    }`}\n                  />\n                  <div className=\"space-y-1\">\n                    <div className=\"font-bold text-white flex items-center gap-2\">\n                      <span>Pol\303\255tica de Ventana T-3 (Bloqueo 3 D\303\255as Previos a Publicaci\303\263n)</span>\n                      {isTMinus3Active ? (\n                        <span className=\"bg-red-600 text-white px-2 py-0.5 rounded text-[10px] font-mono\">\n                          BLOQUEO ACTIVO ({daysToPublish} d\303\255as restantes)\n                        </span>\n                      ) : (\n                        <span className=\"bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded text-[10px] font-mono\">\n                          Ventana Regular ({daysToPublish} d\303\255as restantes)\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[11px] leading-relaxed opacity-90\">\n                      Cualquier solicitud de cambio realizada a menos de 3 d\303\255as de la fecha de publicaci\303\263n (T-3) queda\n                      autom\303\241ticamente clasificada como <strong>Bloqueada / Requiere Override de Direcci\303\263n</strong> y puede acarrear\n                      sobrecostos o reprogramaci\303\263n de la fecha de estreno.\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Submit New Change Request Form */}\n              <div className=\"bg-zinc-950 p-5 rounded-2xl border border-zinc-800 space-y-4\">\n                <h4 className=\"font-bold text-white text-sm\">Nueva Solicitud de Cambio</h4>\n\n                <form onSubmit={handleCreateChangeRequest} className=\"space-y-4\">\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <div>\n                      <label className=\"block text-zinc-400 mb-1\">T\303\255tulo del Cambio *</label>\n                      <input\n                        type=\"text\"\n                        value={changeTitle}\n                        onChange={(e) => setChangeTitle(e.target.value)}\n                        placeholder=\"Ej: Modificar m\303\272sica de fondo y etalonaje final\"\n                        className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                        required\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-zinc-400 mb-1\">Motivo / Tipo de Ajuste</label>\n                      <select\n                        value={changeReason}\n                        onChange={(e) => setChangeReason(e.target.value)}\n                        className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                      >\n                        <option value=\"Edici\303\263n y Ritmo\">Edici\303\263n y Ritmo</option>\n                        <option value=\"Audio / M\303\272sica / Locuci\303\263n\">Audio / M\303\272sica / Locuci\303\263n</option>\n                        <option value=\"Color Grading & Perfil\">Color Grading & Perfil</option>\n                        <option value=\"Textos & Gr\303\241ficas de Marca\">Textos & Gr\303\241ficas de Marca</option>\n                        <option value=\"Narrativa / Re-rodaje\">Narrativa / Re-rodaje</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-zinc-400 mb-1\">Detalle del Cambio Solicitado *</label>\n                    <textarea\n                      value={changeDesc}\n                      onChange={(e) => setChangeDesc(e.target.value)}\n                      rows={3}\n                      placeholder=\"Explica qu\303\251 fragmento o aspecto necesita ser modificado y por qu\303\251...\"\n                      className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                      required\n                    />\n                  </div>\n\n                  {/* AI Evaluation trigger */}\n                  <div className=\"flex items-center justify-between pt-2 border-t border-zinc-800 flex-wrap gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={handleEvaluateWithAI}\n                      disabled={isAiEvaluating}\n                      className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-950/80 hover:bg-purple-900 border border-purple-500/40 text-purple-300 font-semibold text-xs\"\n                    >\n                      <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n                      <span>{isAiEvaluating ? \'Evaluando...\' : \'Evaluar Viabilidad con Gemini AI\'}</span>\n                    </button>\n\n                    <button\n                      type=\"submit\"\n                      className=\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-md\"\n                    >\n                      Enviar Solicitud\n                    </button>\n                  </div>\n                </form>\n\n                {/* AI Analysis Preview */}\n                {aiAnalysisResult && (\n                  <div className=\"bg-purple-950/30 border border-purple-500/40 rounded-xl p-4 space-y-2 animate-in fade-in\">\n                    <div className=\"flex items-center justify-between text-purple-300 font-bold\">\n                      <span className=\"flex items-center gap-1.5\">\n                        <Sparkles className=\"w-4 h-4 text-purple-400\" />\n                        Diagn\303\263stico T\303\251cnico Gemini AI:\n                      </span>\n                      <span className=\"font-mono text-[11px] uppercase bg-purple-900/60 px-2 py-0.5 rounded border border-purple-500/30\">\n                        {aiAnalysisResult.verdict}\n                      </span>\n                    </div>\n\n                    <p className=\"text-zinc-300 text-xs leading-relaxed\">\n                      {aiAnalysisResult.directorRationale}\n                    </p>\n\n                    <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 text-[11px] font-mono\">\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Impacto T-3:</span>\n                        <span className={aiAnalysisResult.incursTMinus3Penalty ? \'text-red-400 font-bold\' : \'text-emerald-400\'}>\n                          {aiAnalysisResult.incursTMinus3Penalty ? \'PENALIZADO\' : \'DENTRO DE TIEMPO\'}\n                        </span>\n                      </div>\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Retraso Estimado:</span>\n                        <span className=\"text-amber-300 font-bold\">{aiAnalysisResult.estimatedDelayHours} horas</span>\n                      </div>\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Sobrecosto USD:</span>\n                        <span className=\"text-rose-400 font-bold\">${aiAnalysisResult.additionalCostUSD} USD</span>\n                      </div>\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Riesgo:</span>\n                        <span className=\"text-zinc-300 font-bold\">{aiAnalysisResult.riskAssessment}</span>\n                      </div>\n                    </div>\n                  </div>\n                )}\n              </div>\n\n              {/* History of Change Requests */}\n              <div className=\"space-y-3\">\n                <h4 className=\"font-bold text-white text-sm\">Historial de Solicitudes de Cambio</h4>\n\n                {(!selectedDeliverable.changeRequests || selectedDeliverable.changeRequests.length === 0) ? (\n                  <div className=\"p-6 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-xl\">\n                    No hay solicitudes de cambio registradas para este entregable.\n                  </div>\n                ) : (\n                  selectedDeliverable.changeRequests.map((cr) => (\n                    <div\n                      key={cr.id}\n                      className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 space-y-3\"\n                    >\n                      <div className=\"flex items-start justify-between gap-2\">\n                        <div>\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-bold text-zinc-100\">{cr.title}</span>\n                            <span className=\"text-[10px] bg-zinc-900 px-2 py-0.5 rounded text-zinc-400 border border-zinc-800\">\n                              {cr.reason}\n                            </span>\n                          </div>\n                          <p className=\"text-[11px] text-zinc-400 mt-1 leading-relaxed\">\n                            {cr.description}\n                          </p>\n                        </div>\n\n                        <span\n                          className={`text-[10px] font-bold px-2.5 py-1 rounded-full border uppercase ${\n                            cr.status === \'approved\'\n                              ? \'bg-emerald-500/10 text-emerald-400 border-emerald-500/30\'\n                              : cr.status === \'blocked_t3\'\n                              ? \'bg-red-500/15 text-red-300 border-red-500/40\'\n                              : cr.status === \'rejected\'\n                              ? \'bg-zinc-800 text-zinc-400 border-zinc-700\'\n                              : \'bg-amber-500/10 text-amber-300 border-amber-500/30\'\n                          }`}\n                        >\n                          {cr.status}\n                        </span>\n                      </div>\n\n                      {/* Meta Footer & Director Action */}\n                      <div className=\"flex items-center justify-between pt-2 border-t border-zinc-900 text-[11px] text-zinc-500\">\n                        <div>\n                          Solicitado por <strong>{cr.requestedByName}</strong> el {cr.requestedAt} (T-{cr.daysToPublishAtSubmission}d)\n                        </div>\n\n                        {/* Director Controls */}\n                        {(currentUser.role === \'director\' || currentUser.role === \'webadmin\') && cr.status !== \'approved\' && (\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => evaluateChangeRequestStatus(selectedDeliverable.id, cr.id, \'approved\', \'Aprobado con Override de Director de Proyecto.\')}\n                              className=\"px-2.5 py-1 rounded bg-emerald-600/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-600/40 font-semibold\"\n                            >\n                              Director Override (Aprobar)\n                            </button>\n                            <button\n                              onClick={() => evaluateChangeRequestStatus(selectedDeliverable.id, cr.id, \'rejected\', \'Rechazado por impacto cr\303\255tico en calendario de estreno.\')}\n                              className=\"px-2.5 py-1 rounded bg-red-600/20 text-red-300 border border-red-500/40 hover:bg-red-600/40 font-semibold\"\n                            >\n                              Rechazar\n                            </button>\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  ))\n                )}\n              </div>\n\n            </div>\n          )}\n\n          {/* TAB 3: TECHNICAL GUIDE */}\n          {activeTab === \'guide\' && (\n            <TechnicalGuideViewer deliverable={selectedDeliverable} />\n          )}\n\n          {/* TAB 4: EQUIPMENT RESERVED */}\n          {activeTab === \'equipment\' && (\n            <div className=\"space-y-4 text-xs text-zinc-300\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-bold text-white text-sm\">\n                  Hardware y \303\223pticas Asignadas al Rodaje ({reservedGear.length})\n                </span>\n                <span className=\"text-amber-400 font-mono font-bold\">\n                  Total Kit: ${reservedGear.reduce((acc, curr) => acc + curr.dailyRateUSD, 0)} USD / d\303\255a\n                </span>\n              </div>\n\n              {reservedGear.length === 0 ? (\n                <div className=\"p-8 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-xl\">\n                  No hay equipos reservados directamente para este entregable.\n                </div>\n              ) : (\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  {reservedGear.map((eq) => (\n                    <div\n                      key={eq.id}\n                      className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex items-center gap-3\"\n                    >\n                      <img\n                        src={eq.image}\n                        alt={eq.name}\n                        className=\"w-16 h-16 rounded-xl object-cover ring-1 ring-zinc-700 shrink-0\"\n                      />\n                      <div className=\"min-w-0 flex-1\">\n                        <div className=\"font-bold text-zinc-100 truncate\">{eq.name}</div>\n                        <div className=\"text-[11px] text-zinc-400 font-mono truncate\">{eq.model}</div>\n                        <div className=\"text-[10px] text-amber-400 font-semibold mt-1\">\n                          ${eq.dailyRateUSD}/d\303\255a \342\200\242 Serial: {eq.serialNumber}\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          )}\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 border-t border-zinc-800 bg-zinc-950 flex items-center justify-between text-xs shrink-0\">\n          <span className=\"text-zinc-500 font-mono\">\n            \303\232ltima actualizaci\303\263n: {selectedDeliverable.updatedAt}\n          </span>\n          <button\n            onClick={() => setSelectedDeliverable(null)}\n            className=\"px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium\"\n          >\n            Cerrar Visor\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Deliverable,\n  DeliverablePhase,\n  ChangeRequest,\n} from \'../types\';\nimport {\n  X,\n  Calendar,\n  Layers,\n  Camera,\n  AlertTriangle,\n  FileCheck2,\n  Clock,\n  Sparkles,\n  User,\n  Building2,\n  ExternalLink,\n  ChevronRight,\n  ShieldAlert,\n  CheckCircle2,\n  XCircle,\n  Video,\n  DollarSign,\n} from \'lucide-react\';\nimport { TechnicalGuideViewer } from \'./TechnicalGuideViewer\';\n\nconst PHASE_STEPS: { id: DeliverablePhase; label: string; tag: string }[] = [\n  { id: \'ideacion\', label: \'Ideaci\303\263n\', tag: \'D1-15\' },\n  { id: \'calendarizacion\', label: \'Calendarizaci\303\263n\', tag: \'D15-20\' },\n  { id: \'guia_tecnica\', label: \'Gu\303\255a T\303\251cnica\', tag: \'D20-Fin\' },\n  { id: \'produccion\', label: \'Rodaje\', tag: \'Set\' },\n  { id: \'post_produccion\', label: \'Post-Prod\', tag: \'Color/VFX\' },\n  { id: \'aprobacion_cliente\', label: \'Aprobaci\303\263n\', tag: \'Ventana T-3\' },\n  { id: \'publicado\', label: \'Publicado\', tag: \'Listo\' },\n];\n\nexport const DeliverableDetailModal: React.FC = () => {\n  const {\n    selectedDeliverable,\n    setSelectedDeliverable,\n    brands,\n    territories,\n    users,\n    equipment,\n    moveDeliverablePhase,\n    submitChangeRequest,\n    evaluateChangeRequestStatus,\n    currentUser,\n    openAiModalWithContext,\n  } = useApp();\n\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'changes\' | \'guide\' | \'equipment\'>(\'overview\');\n\n  // Change request form state\n  const [changeTitle, setChangeTitle] = useState(\'\');\n  const [changeReason, setChangeReason] = useState(\'Edici\303\263n y Ritmo\');\n  const [changeDesc, setChangeDesc] = useState(\'\');\n  const [isAiEvaluating, setIsAiEvaluating] = useState(false);\n  const [aiAnalysisResult, setAiAnalysisResult] = useState<any>(null);\n\n  if (!selectedDeliverable) return null;\n\n  const brand = brands.find((b) => b.id === selectedDeliverable.brandId);\n  const territory = territories.find((t) => t.id === selectedDeliverable.territoryId);\n  const assignee = users.find((u) => u.id === selectedDeliverable.assigneeId);\n  const reservedGear = equipment.filter((e) => selectedDeliverable.equipmentReservedIds.includes(e.id));\n\n  // T-3 calculation\n  const now = new Date(\'2026-08-17\').getTime();\n  const pub = new Date(selectedDeliverable.publishDate).getTime();\n  const daysToPublish = Math.ceil((pub - now) / (1000 * 60 * 60 * 24));\n  const isTMinus3Active = daysToPublish <= 3 && daysToPublish >= 0;\n\n  const currentPhaseIndex = PHASE_STEPS.findIndex((p) => p.id === selectedDeliverable.phase);\n\n  const handleCreateChangeRequest = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!changeTitle.trim() || !changeDesc.trim()) return;\n\n    submitChangeRequest(selectedDeliverable.id, {\n      title: changeTitle,\n      reason: changeReason,\n      description: changeDesc,\n      requestedById: currentUser.id,\n      requestedByName: currentUser.name,\n    });\n\n    setChangeTitle(\'\');\n    setChangeDesc(\'\');\n    setAiAnalysisResult(null);\n  };\n\n  const handleEvaluateWithAI = async () => {\n    if (!changeDesc.trim()) {\n      alert(\'Por favor escribe primero la descripci\303\263n del cambio solicitado para que Gemini pueda evaluarlo.\');\n      return;\n    }\n\n    setIsAiEvaluating(true);\n    try {\n      const response = await fetch(\'/api/gemini/evaluate-change\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          deliverable: selectedDeliverable,\n          changeRequestDescription: `${changeTitle} (${changeReason}): ${changeDesc}`,\n          daysToPublish,\n        }),\n      });\n\n      const data = await response.json();\n      setAiAnalysisResult(data);\n    } catch (err) {\n      console.error(err);\n      alert(\'Error evaluando el cambio con IA\');\n    } finally {\n      setIsAiEvaluating(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-2 sm:p-4 overflow-y-auto\">\n      <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-4xl w-full shadow-2xl overflow-hidden my-auto max-h-[92vh] flex flex-col animate-in fade-in zoom-in-95\">\n        \n        {/* Modal Header */}\n        <div className=\"p-5 border-b border-zinc-800 bg-zinc-950/80 shrink-0\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"font-mono font-bold text-xs px-2 py-0.5 rounded bg-zinc-900 text-indigo-400 border border-zinc-800\">\n                  {selectedDeliverable.code}\n                </span>\n                <span className=\"text-xs uppercase font-bold px-2 py-0.5 rounded border bg-blue-500/10 text-blue-400 border-blue-500/30\">\n                  {selectedDeliverable.priority}\n                </span>\n                <span className=\"text-xs text-zinc-400 font-mono\">\n                  {selectedDeliverable.format}\n                </span>\n              </div>\n\n              <h2 className=\"text-lg sm:text-xl font-bold text-white mt-1 leading-snug\">\n                {selectedDeliverable.title}\n              </h2>\n\n              <div className=\"flex items-center gap-4 text-xs text-zinc-400 mt-1.5 flex-wrap\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span\n                    className=\"w-2.5 h-2.5 rounded-full shrink-0\"\n                    style={{ backgroundColor: brand?.primaryColor || \'#6366f1\' }}\n                  />\n                  <span className=\"text-zinc-200 font-semibold\">{brand?.name}</span>\n                </div>\n                {territory && (\n                  <span className=\"text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800\">\n                    \360\237\216\257 {territory.name}\n                  </span>\n                )}\n                {assignee && (\n                  <span className=\"text-zinc-400\">\n                    \360\237\221\244 Asignado: <strong className=\"text-zinc-300\">{assignee.name}</strong>\n                  </span>\n                )}\n              </div>\n            </div>\n\n            <button\n              onClick={() => setSelectedDeliverable(null)}\n              className=\"p-1.5 rounded-lg bg-zinc-800 text-zinc-400 hover:text-white hover:bg-zinc-700 transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Stepper: Phase Progress Bar */}\n          <div className=\"mt-5 pt-4 border-t border-zinc-800/80\">\n            <div className=\"grid grid-cols-7 gap-1 text-center\">\n              {PHASE_STEPS.map((step, sIdx) => {\n                const isCurrent = sIdx === currentPhaseIndex;\n                const isPassed = sIdx < currentPhaseIndex;\n\n                return (\n                  <button\n                    key={step.id}\n                    onClick={() => moveDeliverablePhase(selectedDeliverable.id, step.id)}\n                    className={`p-1.5 rounded-lg transition-all text-left flex flex-col justify-between ${\n                      isCurrent\n                        ? \'bg-indigo-600 text-white font-bold shadow-md ring-1 ring-white/20\'\n                        : isPassed\n                        ? \'bg-zinc-800 text-zinc-300 font-medium\'\n                        : \'bg-zinc-950 text-zinc-500 hover:bg-zinc-800/60\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-[10px] w-full\">\n                      <span className=\"font-mono\">#{sIdx + 1}</span>\n                      <span className=\"text-[9px] opacity-80\">{step.tag}</span>\n                    </div>\n                    <div className=\"text-[11px] truncate mt-0.5 font-semibold\">{step.label}</div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Navigation Sub-Tabs */}\n        <div className=\"flex items-center gap-2 px-6 pt-3 border-b border-zinc-800 bg-zinc-950/40 text-xs shrink-0\">\n          <button\n            onClick={() => setActiveTab(\'overview\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 ${\n              activeTab === \'overview\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            Visi\303\263n General & Fechas\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'changes\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 flex items-center gap-1.5 ${\n              activeTab === \'changes\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            <span>Control de Cambios & Regla T-3</span>\n            {isTMinus3Active && (\n              <span className=\"px-1.5 py-0.2 rounded bg-red-500 text-white text-[9px] font-bold\">\n                T-3\n              </span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'guide\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 ${\n              activeTab === \'guide\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            Gu\303\255a T\303\251cnica & Shotlist\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'equipment\')}\n            className={`pb-2.5 px-2 font-semibold transition-colors border-b-2 ${\n              activeTab === \'equipment\'\n                ? \'border-indigo-500 text-indigo-400\'\n                : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            Hardware & Reservas ({reservedGear.length})\n          </button>\n        </div>\n\n        {/* Modal Body Content */}\n        <div className=\"p-6 overflow-y-auto flex-1 space-y-6\">\n          \n          {/* TAB 1: OVERVIEW */}\n          {activeTab === \'overview\' && (\n            <div className=\"space-y-6 text-xs text-zinc-300\">\n              \n              {/* Key Timeline Milestone Grid */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  <div className=\"flex items-center gap-1.5 text-zinc-400 mb-1\">\n                    <Video className=\"w-4 h-4 text-rose-400\" />\n                    <span>Fechas de Rodaje (Producci\303\263n)</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-white font-mono\">\n                    {selectedDeliverable.productionStartDate} al {selectedDeliverable.productionEndDate}\n                  </div>\n                </div>\n\n                <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  <div className=\"flex items-center gap-1.5 text-zinc-400 mb-1\">\n                    <Calendar className=\"w-4 h-4 text-teal-400\" />\n                    <span>Fecha de Publicaci\303\263n Oficial</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-white font-mono\">\n                    {selectedDeliverable.publishDate}\n                  </div>\n                </div>\n\n                <div className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  <div className=\"flex items-center gap-1.5 text-zinc-400 mb-1\">\n                    <Clock className=\"w-4 h-4 text-amber-400\" />\n                    <span>Cuenta Regresiva a Estreno</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-amber-300 font-mono\">\n                    {daysToPublish} d\303\255as restantes\n                  </div>\n                </div>\n              </div>\n\n              {/* Concept Hook / Logline */}\n              {selectedDeliverable.conceptHook && (\n                <div className=\"bg-indigo-950/20 border border-indigo-500/30 p-4 rounded-xl space-y-1\">\n                  <span className=\"text-[10px] uppercase font-bold text-indigo-400\">\n                    \360\237\216\257 Hook Inicial / Logline (0-3 Segundos)\n                  </span>\n                  <p className=\"text-sm font-medium text-indigo-200 italic\">\n                    \"{selectedDeliverable.conceptHook}\"\n                  </p>\n                </div>\n              )}\n\n              {/* Description */}\n              <div className=\"space-y-1.5\">\n                <span className=\"font-bold text-zinc-200\">Concepto Narrativo & Propuesta Visual:</span>\n                <p className=\"text-xs text-zinc-300 leading-relaxed bg-zinc-950 p-4 rounded-xl border border-zinc-800\">\n                  {selectedDeliverable.description}\n                </p>\n              </div>\n\n              {/* Assets Linked */}\n              {selectedDeliverable.assetsLinked && selectedDeliverable.assetsLinked.length > 0 && (\n                <div className=\"space-y-2\">\n                  <span className=\"font-bold text-zinc-200\">Activos Digitales de Marca Vinculados:</span>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {selectedDeliverable.assetsLinked.map((asset, aIdx) => (\n                      <span\n                        key={aIdx}\n                        className=\"px-3 py-1.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-300 font-mono flex items-center gap-1.5\"\n                      >\n                        <ExternalLink className=\"w-3.5 h-3.5 text-zinc-500\" />\n                        {asset}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n            </div>\n          )}\n\n          {/* TAB 2: CHANGE REQUESTS & T-3 POLICY */}\n          {activeTab === \'changes\' && (\n            <div className=\"space-y-6 text-xs text-zinc-300\">\n              \n              {/* T-3 Policy Banner */}\n              <div\n                className={`p-4 rounded-xl border ${\n                  isTMinus3Active\n                    ? \'bg-red-500/15 border-red-500/40 text-red-200\'\n                    : \'bg-zinc-950 border-zinc-800 text-zinc-300\'\n                }`}\n              >\n                <div className=\"flex items-start gap-3\">\n                  <ShieldAlert\n                    className={`w-6 h-6 shrink-0 ${\n                      isTMinus3Active ? \'text-red-400\' : \'text-amber-400\'\n                    }`}\n                  />\n                  <div className=\"space-y-1\">\n                    <div className=\"font-bold text-white flex items-center gap-2\">\n                      <span>Pol\303\255tica de Ventana T-3 (Bloqueo 3 D\303\255as Previos a Publicaci\303\263n)</span>\n                      {isTMinus3Active ? (\n                        <span className=\"bg-red-600 text-white px-2 py-0.5 rounded text-[10px] font-mono\">\n                          BLOQUEO ACTIVO ({daysToPublish} d\303\255as restantes)\n                        </span>\n                      ) : (\n                        <span className=\"bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded text-[10px] font-mono\">\n                          Ventana Regular ({daysToPublish} d\303\255as restantes)\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[11px] leading-relaxed opacity-90\">\n                      Cualquier solicitud de cambio realizada a menos de 3 d\303\255as de la fecha de publicaci\303\263n (T-3) queda\n                      autom\303\241ticamente clasificada como <strong>Bloqueada / Requiere Override de Direcci\303\263n</strong> y puede acarrear\n                      sobrecostos o reprogramaci\303\263n de la fecha de estreno.\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Submit New Change Request Form */}\n              <div className=\"bg-zinc-950 p-5 rounded-2xl border border-zinc-800 space-y-4\">\n                <h4 className=\"font-bold text-white text-sm\">Nueva Solicitud de Cambio</h4>\n\n                <form onSubmit={handleCreateChangeRequest} className=\"space-y-4\">\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <div>\n                      <label className=\"block text-zinc-400 mb-1\">T\303\255tulo del Cambio *</label>\n                      <input\n                        type=\"text\"\n                        value={changeTitle}\n                        onChange={(e) => setChangeTitle(e.target.value)}\n                        placeholder=\"Ej: Modificar m\303\272sica de fondo y etalonaje final\"\n                        className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                        required\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-zinc-400 mb-1\">Motivo / Tipo de Ajuste</label>\n                      <select\n                        value={changeReason}\n                        onChange={(e) => setChangeReason(e.target.value)}\n                        className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                      >\n                        <option value=\"Edici\303\263n y Ritmo\">Edici\303\263n y Ritmo</option>\n                        <option value=\"Audio / M\303\272sica / Locuci\303\263n\">Audio / M\303\272sica / Locuci\303\263n</option>\n                        <option value=\"Color Grading & Perfil\">Color Grading & Perfil</option>\n                        <option value=\"Textos & Gr\303\241ficas de Marca\">Textos & Gr\303\241ficas de Marca</option>\n                        <option value=\"Narrativa / Re-rodaje\">Narrativa / Re-rodaje</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-zinc-400 mb-1\">Detalle del Cambio Solicitado *</label>\n                    <textarea\n                      value={changeDesc}\n                      onChange={(e) => setChangeDesc(e.target.value)}\n                      rows={3}\n                      placeholder=\"Explica qu\303\251 fragmento o aspecto necesita ser modificado y por qu\303\251...\"\n                      className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                      required\n                    />\n                  </div>\n\n                  {/* AI Evaluation trigger */}\n                  <div className=\"flex items-center justify-between pt-2 border-t border-zinc-800 flex-wrap gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={handleEvaluateWithAI}\n                      disabled={isAiEvaluating}\n                      className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-950/80 hover:bg-purple-900 border border-purple-500/40 text-purple-300 font-semibold text-xs\"\n                    >\n                      <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n                      <span>{isAiEvaluating ? \'Evaluando...\' : \'Evaluar Viabilidad con Gemini AI\'}</span>\n                    </button>\n\n                    <button\n                      type=\"submit\"\n                      className=\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-md\"\n                    >\n                      Enviar Solicitud\n                    </button>\n                  </div>\n                </form>\n\n                {/* AI Analysis Preview */}\n                {aiAnalysisResult && (\n                  <div className=\"bg-purple-950/30 border border-purple-500/40 rounded-xl p-4 space-y-2 animate-in fade-in\">\n                    <div className=\"flex items-center justify-between text-purple-300 font-bold\">\n                      <span className=\"flex items-center gap-1.5\">\n                        <Sparkles className=\"w-4 h-4 text-purple-400\" />\n                        Diagn\303\263stico T\303\251cnico Gemini AI:\n                      </span>\n                      <span className=\"font-mono text-[11px] uppercase bg-purple-900/60 px-2 py-0.5 rounded border border-purple-500/30\">\n                        {aiAnalysisResult.verdict}\n                      </span>\n                    </div>\n\n                    <p className=\"text-zinc-300 text-xs leading-relaxed\">\n                      {aiAnalysisResult.directorRationale}\n                    </p>\n\n                    <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 text-[11px] font-mono\">\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Impacto T-3:</span>\n                        <span className={aiAnalysisResult.incursTMinus3Penalty ? \'text-red-400 font-bold\' : \'text-emerald-400\'}>\n                          {aiAnalysisResult.incursTMinus3Penalty ? \'PENALIZADO\' : \'DENTRO DE TIEMPO\'}\n                        </span>\n                      </div>\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Retraso Estimado:</span>\n                        <span className=\"text-amber-300 font-bold\">{aiAnalysisResult.estimatedDelayHours} horas</span>\n                      </div>\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Sobrecosto USD:</span>\n                        <span className=\"text-rose-400 font-bold\">${aiAnalysisResult.additionalCostUSD} USD</span>\n                      </div>\n                      <div className=\"bg-zinc-950/80 p-2 rounded border border-zinc-800\">\n                        <span className=\"text-zinc-500 block text-[9px]\">Riesgo:</span>\n                        <span className=\"text-zinc-300 font-bold\">{aiAnalysisResult.riskAssessment}</span>\n                      </div>\n                    </div>\n                  </div>\n                )}\n              </div>\n\n              {/* History of Change Requests */}\n              <div className=\"space-y-3\">\n                <h4 className=\"font-bold text-white text-sm\">Historial de Solicitudes de Cambio</h4>\n\n                {(!selectedDeliverable.changeRequests || selectedDeliverable.changeRequests.length === 0) ? (\n                  <div className=\"p-6 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-xl\">\n                    No hay solicitudes de cambio registradas para este entregable.\n                  </div>\n                ) : (\n                  selectedDeliverable.changeRequests.map((cr) => (\n                    <div\n                      key={cr.id}\n                      className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 space-y-3\"\n                    >\n                      <div className=\"flex items-start justify-between gap-2\">\n                        <div>\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-bold text-zinc-100\">{cr.title}</span>\n                            <span className=\"text-[10px] bg-zinc-900 px-2 py-0.5 rounded text-zinc-400 border border-zinc-800\">\n                              {cr.reason}\n                            </span>\n                          </div>\n                          <p className=\"text-[11px] text-zinc-400 mt-1 leading-relaxed\">\n                            {cr.description}\n                          </p>\n                        </div>\n\n                        <span\n                          className={`text-[10px] font-bold px-2.5 py-1 rounded-full border uppercase ${\n                            cr.status === \'approved\'\n                              ? \'bg-emerald-500/10 text-emerald-400 border-emerald-500/30\'\n                              : cr.status === \'blocked_t3\'\n                              ? \'bg-red-500/15 text-red-300 border-red-500/40\'\n                              : cr.status === \'rejected\'\n                              ? \'bg-zinc-800 text-zinc-400 border-zinc-700\'\n                              : \'bg-amber-500/10 text-amber-300 border-amber-500/30\'\n                          }`}\n                        >\n                          {cr.status}\n                        </span>\n                      </div>\n\n                      {/* Meta Footer & Director Action */}\n                      <div className=\"flex items-center justify-between pt-2 border-t border-zinc-900 text-[11px] text-zinc-500\">\n                        <div>\n                          Solicitado por <strong>{cr.requestedByName}</strong> el {cr.requestedAt} (T-{cr.daysToPublishAtSubmission}d)\n                        </div>\n\n                        {/* Director Controls */}\n                        {(currentUser.role === \'director\' || currentUser.role === \'webadmin\') && cr.status !== \'approved\' && (\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => evaluateChangeRequestStatus(selectedDeliverable.id, cr.id, \'approved\', \'Aprobado con Override de Director de Proyecto.\')}\n                              className=\"px-2.5 py-1 rounded bg-emerald-600/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-600/40 font-semibold\"\n                            >\n                              Director Override (Aprobar)\n                            </button>\n                            <button\n                              onClick={() => evaluateChangeRequestStatus(selectedDeliverable.id, cr.id, \'rejected\', \'Rechazado por impacto cr\303\255tico en calendario de estreno.\')}\n                              className=\"px-2.5 py-1 rounded bg-red-600/20 text-red-300 border border-red-500/40 hover:bg-red-600/40 font-semibold\"\n                            >\n                              Rechazar\n                            </button>\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  ))\n                )}\n              </div>\n\n            </div>\n          )}\n\n          {/* TAB 3: TECHNICAL GUIDE */}\n          {activeTab === \'guide\' && (\n            <TechnicalGuideViewer deliverable={selectedDeliverable} />\n          )}\n\n          {/* TAB 4: EQUIPMENT RESERVED */}\n          {activeTab === \'equipment\' && (\n            <div className=\"space-y-4 text-xs text-zinc-300\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-bold text-white text-sm\">\n                  Hardware y \303\223pticas Asignadas al Rodaje ({reservedGear.length})\n                </span>\n                <span className=\"text-amber-400 font-mono font-bold\">\n                  Total Kit: ${reservedGear.reduce((acc, curr) => acc + curr.dailyRateUSD, 0)} USD / d\303\255a\n                </span>\n              </div>\n\n              {reservedGear.length === 0 ? (\n                <div className=\"p-8 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-xl\">\n                  No hay equipos reservados directamente para este entregable.\n                </div>\n              ) : (\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  {reservedGear.map((eq) => (\n                    <div\n                      key={eq.id}\n                      className=\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex items-center gap-3\"\n                    >\n                      <img\n                        src={eq.image}\n                        alt={eq.name}\n                        className=\"w-16 h-16 rounded-xl object-cover ring-1 ring-zinc-700 shrink-0\"\n                      />\n                      <div className=\"min-w-0 flex-1\">\n                        <div className=\"font-bold text-zinc-100 truncate\">{eq.name}</div>\n                        <div className=\"text-[11px] text-zinc-400 font-mono truncate\">{eq.model}</div>\n                        <div className=\"text-[10px] text-amber-400 font-semibold mt-1\">\n                          ${eq.dailyRateUSD}/d\303\255a \342\200\242 Serial: {eq.serialNumber}\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          )}\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 border-t border-zinc-800 bg-zinc-950 flex items-center justify-between text-xs shrink-0\">\n          <span className=\"text-zinc-500 font-mono\">\n            \303\232ltima actualizaci\303\263n: {selectedDeliverable.updatedAt}\n          </span>\n          <button\n            onClick={() => setSelectedDeliverable(null)}\n            className=\"px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium\"\n          >\n            Cerrar Visor\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 628
    num_bytes: 28867
  }
}
