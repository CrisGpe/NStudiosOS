rose-600 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            <Video className=\"w-3.5 h-3.5 text-rose-300\" />\n            <span>Solo Rodaje / Producci\303\263n</span>\n          </button>\n\n          <button\n            onClick={() => setViewMode(\'publishing\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all ${\n              viewMode === \'publishing\'\n                ? \'bg-teal-600 text-white shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            <Send className=\"w-3.5 h-3.5 text-teal-300\" />\n            <span>Solo Publicaci\303\263n & T-3</span>\n          </button>\n        </div>\n\n        {/* Month Navigation */}\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={handlePrevMonth}\n            className=\"p-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-zinc-300 transition-colors\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n          </button>\n          <span className=\"font-bold text-sm text-zinc-100 min-w-[140px] text-center\">\n            {monthNames[currentMonth]} {currentYear}\n          </span>\n          <button\n            onClick={handleNextMonth}\n            className=\"p-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-zinc-300 transition-colors\"\n          >\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n      </div>\n\n      {/* Legend & T-3 Rule Alert Info */}\n      <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-3 flex flex-wrap items-center justify-between gap-3 text-xs\">\n        <div className=\"flex flex-wrap items-center gap-4 text-zinc-300\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-3 h-3 rounded bg-rose-500/20 border border-rose-500/50\" />\n            <span>Rodaje / Producci\303\263n (Hardware Bloqueado)</span>\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-3 h-3 rounded bg-teal-500/20 border border-teal-500/50\" />\n            <span>Fecha de Publicaci\303\263n</span>\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-3 h-3 rounded bg-red-500/30 border border-red-500 text-red-300 text-[9px] font-bold flex items-center justify-center\">\n              T-3\n            </span>\n            <span>Ventana de Bloqueo de Cambios (3 d\303\255as previos a estreno)</span>\n          </div>\n        </div>\n\n        <span className=\"text-zinc-500 font-mono text-[11px]\">\n          Hoy: 17 de Agosto, 2026\n        </span>\n      </div>\n\n      {/* 7-Day Week Calendar Grid */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl\">\n        \n        {/* Days of Week Header */}\n        <div className=\"grid grid-cols-7 border-b border-zinc-800 bg-zinc-900/90 text-center py-2.5 text-xs font-semibold text-zinc-400\">\n          <div>Lunes</div>\n          <div>Martes</div>\n          <div>Mi\303\251rcoles</div>\n          <div>Jueves</div>\n          <div>Viernes</div>\n          <div>S\303\241bado</div>\n          <div>Domingo</div>\n        </div>\n\n        {/* Days Matrix */}\n        <div className=\"grid grid-cols-7 auto-rows-fr divide-x divide-y divide-zinc-800/60 bg-zinc-950\">\n          {/* Empty cells before start of month */}\n          {Array.from({ length: startOffset }).map((_, i) => (\n            <div key={`empty-${i}`} className=\"min-h-[120px] p-2 bg-zinc-950/40 text-zinc-700 text-xs select-none\" />\n          ))}\n\n          {/* Days in Month */}\n          {Array.from({ length: daysInMonth }).map((_, i) => {\n            const dayNum = i + 1;\n            const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, \'0\')}-${String(dayNum).padStart(2, \'0\')}`;\n            const { prodEvents, pubEvents } = getEventsForDate(dateStr);\n            const isToday = currentYear === 2026 && currentMonth === 7 && dayNum === 17;\n\n            return (\n              <div\n                key={dateStr}\n                className={`min-h-[125px] p-2 transition-colors flex flex-col justify-between ${\n                  isToday ? \'bg-indigo-950/20 ring-1 ring-inset ring-indigo-500/50\' : \'hover:bg-zinc-900/40\'\n                }`}\n              >\n                {/* Date Header */}\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <span\n                    className={`text-xs font-bold font-mono px-1.5 py-0.5 rounded ${\n                      isToday\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : \'text-zinc-400\'\n                    }`}\n                  >\n                    {dayNum}\n                  </span>\n                  {isToday && (\n                    <span className=\"text-[9px] uppercase font-bold text-indigo-400 bg-indigo-500/10 px-1 py-0.2 rounded border border-indigo-500/20\">\n                      HOY\n                    </span>\n                  )}\n                </div>\n\n                {/* Events in this day */}\n                <div className=\"space-y-1 overflow-y-auto max-h-[85px] custom-scrollbar flex-1\">\n                  \n                  {/* Production / Shoot Events */}\n                  {prodEvents.map((del) => {\n                    const brand = brands.find((b) => b.id === del.brandId);\n                    return (\n                      <div\n                        key={`prod-${del.id}`}\n                        onClick={() => setSelectedDeliverable(del)}\n                        className=\"bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/40 rounded p-1 text-[10px] text-rose-200 cursor-pointer transition-all truncate\"\n                        title={`Rodaje: ${del.title} (${brand?.name})`}\n                      >\n                        <div className=\"flex items-center gap-1\">\n                          <Video className=\"w-2.5 h-2.5 text-rose-400 shrink-0\" />\n                          <span className=\"font-semibold text-rose-300 font-mono\">[{del.code}]</span>\n                          <span className=\"truncate\">{del.title}</span>\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                  {/* Publishing Events */}\n                  {pubEvents.map((del) => {\n                    const brand = brands.find((b) => b.id === del.brandId);\n                    const now = new Date(\'2026-08-17\').getTime();\n                    const pub = new Date(del.publishDate).getTime();\n                    const diffDays = Math.ceil((pub - now) / (1000 * 60 * 60 * 24));\n                    const isTMinus3 = diffDays <= 3 && diffDays >= 0;\n\n                    return (\n                      <div\n                        key={`pub-${del.id}`}\n                        onClick={() => setSelectedDeliverable(del)}\n                        className={`rounded p-1 text-[10px] cursor-pointer transition-all border ${\n                          isTMinus3\n                            ? \'bg-red-500/20 hover:bg-red-500/30 border-red-500/60 text-red-200 animate-pulse\'\n                            : \'bg-teal-500/15 hover:bg-teal-500/25 border-teal-500/40 text-teal-200\'\n                        }`}\n                        title={`Publicaci\303\263n: ${del.title} (${brand?.name})`}\n                      >\n                        <div className=\"flex items-center justify-between gap-1\">\n                          <div className=\"flex items-center gap-1 truncate\">\n                            <Send className=\"w-2.5 h-2.5 text-teal-400 shrink-0\" />\n                            <span className=\"truncate\">{del.title}</span>\n                          </div>\n                          {isTMinus3 && (\n                            <span className=\"bg-red-600 text-white font-bold px-1 rounded text-[8px]\">\n                              T-3\n                            </span>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                </div>\n\n                {/* Day Summary Indicators */}\n                {(prodEvents.length > 0 || pubEvents.length > 0) && (\n                  <div className=\"text-[9px] text-zinc-500 font-mono pt-1 text-right\">\n                    {prodEvents.length > 0 && `${prodEvents.length} rodaje `}\n                    {pubEvents.length > 0 && `\342\200\242 ${pubEvents.length} estreno`}\n                  </div>\n                )}\n\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"space-y-4\">\n      \n      {/* Calendar Header & View Switcher - High Density */}\n      <div className=\"bg-white border border-slate-200 rounded-lg p-3 shadow-2xs flex flex-wrap items-center justify-between gap-3\">\n        \n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"w-8 h-8 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600\">\n            <CalendarIcon className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-1.5\">\n              <span>Calendario Din\303\241mico de Producci\303\263n & Publicaci\303\263n</span>\n              <span className=\"text-[10px] px-1.5 py-0.2 rounded bg-slate-100 text-slate-600 font-mono font-semibold border border-slate-200\">\n                1 Pasado / 2 Futuro\n              </span>\n            </h2>\n            <p className=\"text-[11px] text-slate-500\">\n              Fechas de rodaje, reserva de hardware y fechas l\303\255mites con regla de ventana T-3.\n            </p>\n          </div>\n        </div>\n\n        {/* View Mode Toggle */}\n        <div className=\"flex items-center gap-1 bg-slate-50 p-1 rounded-md border border-slate-200 text-xs\">\n          <button\n            onClick={() => setViewMode(\'dual\')}\n            className={`flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold transition-all cursor-pointer ${\n              viewMode === \'dual\'\n                ? \'bg-slate-900 text-white shadow-2xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Layers className=\"w-3 h-3\" />\n            <span>Vista Dual</span>\n          </button>\n\n          <button\n            onClick={() => setViewMode(\'production\')}\n            className={`flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold transition-all cursor-pointer ${\n              viewMode === \'production\'\n                ? \'bg-rose-600 text-white shadow-2xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Video className=\"w-3 h-3\" />\n            <span>Rodaje / Producci\303\263n</span>\n          </button>\n\n          <button\n            onClick={() => setViewMode(\'publishing\')}\n            className={`flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold transition-all cursor-pointer ${\n              viewMode === \'publishing\'\n                ? \'bg-teal-600 text-white shadow-2xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Send className=\"w-3 h-3\" />\n            <span>Publicaci\303\263n & T-3</span>\n          </button>\n        </div>\n\n        {/* Month Navigation */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={handlePrevMonth}\n            className=\"p-1.5 rounded-md bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors cursor-pointer\"\n          >\n            <ChevronLeft className=\"w-3.5 h-3.5\" />\n          </button>\n          <span className=\"font-bold text-xs text-slate-800 min-w-[120px] text-center\">\n            {monthNames[currentMonth]} {currentYear}\n          </span>\n          <button\n            onClick={handleNextMonth}\n            className=\"p-1.5 rounded-md bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors cursor-pointer\"\n          >\n            <ChevronRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n      </div>\n\n      {/* Legend & T-3 Rule Alert Info - High Density */}\n      <div className=\"bg-white border border-slate-200 rounded-lg p-2.5 flex flex-wrap items-center justify-between gap-2.5 text-xs shadow-2xs\">\n        <div className=\"flex flex-wrap items-center gap-3.5 text-slate-600\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-2.5 rounded bg-rose-50 border border-rose-300\" />\n            <span>Rodaje (Hardware Bloqueado)</span>\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-2.5 rounded bg-teal-50 border border-teal-300\" />\n            <span>Fecha de Publicaci\303\263n</span>\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-2.5 rounded bg-red-100 border border-red-400 text-red-700 text-[8px] font-bold flex items-center justify-center\">\n              T-3\n            </span>\n            <span>Bloqueo de Cambios T-3 (\342\211\2443 d\303\255as antes de estreno)</span>\n          </div>\n        </div>\n\n        <span className=\"text-slate-500 font-mono text-[11px] font-medium\">\n          Hoy: 17 de Agosto, 2026\n        </span>\n      </div>\n\n      {/* 7-Day Week Calendar Grid - High Density */}\n      <div className=\"bg-white border border-slate-200 rounded-lg overflow-hidden shadow-2xs\">\n        \n        {/* Days of Week Header */}\n        <div className=\"grid grid-cols-7 border-b border-slate-200 bg-slate-50 text-center py-2 text-xs font-bold text-slate-600 uppercase tracking-wider\">\n          <div>Lunes</div>\n          <div>Martes</div>\n          <div>Mi\303\251rcoles</div>\n          <div>Jueves</div>\n          <div>Viernes</div>\n          <div>S\303\241bado</div>\n          <div>Domingo</div>\n        </div>\n\n        {/* Days Matrix */}\n        <div className=\"grid grid-cols-7 auto-rows-fr divide-x divide-y divide-slate-200 bg-white\">\n          {/* Empty cells before start of month */}\n          {Array.from({ length: startOffset }).map((_, i) => (\n            <div key={`empty-${i}`} className=\"min-h-[110px] p-2 bg-slate-50/50 text-slate-300 text-xs select-none\" />\n          ))}\n\n          {/* Days in Month */}\n          {Array.from({ length: daysInMonth }).map((_, i) => {\n            const dayNum = i + 1;\n            const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, \'0\')}-${String(dayNum).padStart(2, \'0\')}`;\n            const { prodEvents, pubEvents } = getEventsForDate(dateStr);\n            const isToday = currentYear === 2026 && currentMonth === 7 && dayNum === 17;\n\n            return (\n              <div\n                key={dateStr}\n                className={`min-h-[115px] p-2 transition-colors flex flex-col justify-between ${\n                  isToday ? \'bg-blue-50/40 ring-1 ring-inset ring-blue-500\' : \'hover:bg-slate-50/60\'\n                }`}\n              >\n                {/* Date Header */}\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span\n                    className={`text-xs font-bold font-mono px-1.5 py-0.2 rounded ${\n                      isToday\n                        ? \'bg-blue-600 text-white shadow-2xs\'\n                        : \'text-slate-600\'\n                    }`}\n                  >\n                    {dayNum}\n                  </span>\n                  {isToday && (\n                    <span className=\"text-[9px] uppercase font-bold text-blue-700 bg-blue-50 px-1 py-0.2 rounded border border-blue-200\">\n                      HOY\n                    </span>\n                  )}\n                </div>\n\n                {/* Events in this day */}\n                <div className=\"space-y-1 overflow-y-auto max-h-[80px] custom-scrollbar flex-1\">\n                  \n                  {/* Production / Shoot Events */}\n                  {prodEvents.map((del) => {\n                    const brand = brands.find((b) => b.id === del.brandId);\n                    return (\n                      <div\n                        key={`prod-${del.id}`}\n                        onClick={() => setSelectedDeliverable(del)}\n                        className=\"bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded p-1 text-[10px] text-rose-800 cursor-pointer transition-all truncate\"\n                        title={`Rodaje: ${del.title} (${brand?.name})`}\n                      >\n                        <div className=\"flex items-center gap-1\">\n                          <Video className=\"w-2.5 h-2.5 text-rose-600 shrink-0\" />\n                          <span className=\"font-bold text-rose-700 font-mono\">[{del.code}]</span>\n                          <span className=\"truncate font-medium\">{del.title}</span>\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                  {/* Publishing Events */}\n                  {pubEvents.map((del) => {\n                    const brand = brands.find((b) => b.id === del.brandId);\n                    const now = new Date(\'2026-08-17\').getTime();\n                    const pub = new Date(del.publishDate).getTime();\n                    const diffDays = Math.ceil((pub - now) / (1000 * 60 * 60 * 24));\n                    const isTMinus3 = diffDays <= 3 && diffDays >= 0;\n\n                    return (\n                      <div\n                        key={`pub-${del.id}`}\n                        onClick={() => setSelectedDeliverable(del)}\n                        className={`rounded p-1 text-[10px] cursor-pointer transition-all border ${\n                          isTMinus3\n                            ? \'bg-red-50 hover:bg-red-100 border-red-200 text-red-800 font-bold animate-pulse\'\n                            : \'bg-teal-50 hover:bg-teal-100 border-teal-200 text-teal-800\'\n                        }`}\n                        title={`Publicaci\303\263n: ${del.title} (${brand?.name})`}\n                      >\n                        <div className=\"flex items-center justify-between gap-1\">\n                          <div className=\"flex items-center gap-1 truncate font-medium\">\n                            <Send className=\"w-2.5 h-2.5 text-teal-600 shrink-0\" />\n                            <span className=\"truncate\">{del.title}</span>\n                          </div>\n                          {isTMinus3 && (\n                            <span className=\"bg-red-600 text-white font-bold px-1 rounded text-[8px]\">\n                              T-3\n                            </span>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                </div>\n\n                {/* Day Summary Indicators */}\n                {(prodEvents.length > 0 || pubEvents.length > 0) && (\n                  <div className=\"text-[9px] text-slate-400 font-mono pt-1 text-right\">\n                    {prodEvents.length > 0 && `${prodEvents.length} rodaje `}\n                    {pubEvents.length > 0 && `\342\200\242 ${pubEvents.length} estreno`}\n                  </div>\n                )}\n\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );"
