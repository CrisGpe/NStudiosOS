      name: "edit_file"
      arguments_json: "{\"Instruction\":\"Apply High Density styling to SystemSpecsHub component\", \"ReplacementContent\":\"  return (\\n    <div className=\\\"space-y-4\\\">\\n      \\n      {/* Header - High Density */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-lg p-3.5 shadow-2xs flex flex-wrap items-center justify-between gap-3\\\">\\n        <div className=\\\"flex items-center gap-3\\\">\\n          <div className=\\\"w-9 h-9 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-700 shrink-0\\\">\\n            <FileCode className=\\\"w-4.5 h-4.5\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-sm font-bold text-slate-900 flex items-center gap-2\\\">\\n              <span>Especificaciones T\303\251cnicas & Arquitectura</span>\\n              <span className=\\\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 font-semibold\\\">\\n                DBML \342\200\242 ERD \342\200\242 State Machine \342\200\242 OpenAPI\\n              </span>\\n            </h2>\\n            <p className=\\\"text-[11px] text-slate-500\\\">\\n              Modelo relacional, reglas cronol\303\263gicas de negocio, m\303\241quina de transiciones y dataset inicial.\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Spec Tab Switcher */}\\n        <div className=\\\"flex items-center gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200 text-xs font-semibold\\\">\\n          <button\\n            onClick={() => setActiveSpecTab(\'erd\')}\\n            className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md transition-all cursor-pointer ${\\n              activeSpecTab === \'erd\'\\n                ? \'bg-white text-slate-900 shadow-2xs border border-slate-200\'\\n                : \'text-slate-600 hover:text-slate-900\'\\n            }`}\\n          >\\n            <Database className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Diagrama ERD & DBML</span>\\n          </button>\\n\\n          <button\\n            onClick={() => setActiveSpecTab(\'stateMachine\')}\\n            className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md transition-all cursor-pointer ${\\n              activeSpecTab === \'stateMachine\'\\n                ? \'bg-white text-slate-900 shadow-2xs border border-slate-200\'\\n                : \'text-slate-600 hover:text-slate-900\'\\n            }`}\\n          >\\n            <GitBranch className=\\\"w-3.5 h-3.5\\\" />\\n            <span>M\303\241quina de Estados & T-3</span>\\n          </button>\\n\\n          <button\\n            onClick={() => setActiveSpecTab(\'apiDocs\')}\\n            className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md transition-all cursor-pointer ${\\n              activeSpecTab === \'apiDocs\'\\n                ? \'bg-white text-slate-900 shadow-2xs border border-slate-200\'\\n                : \'text-slate-600 hover:text-slate-900\'\\n            }`}\\n          >\\n            <Terminal className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Contratos REST</span>\\n          </button>\\n\\n          <button\\n            onClick={() => setActiveSpecTab(\'mockData\')}\\n            className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md transition-all cursor-pointer ${\\n              activeSpecTab === \'mockData\'\\n                ? \'bg-white text-slate-900 shadow-2xs border border-slate-200\'\\n                : \'text-slate-600 hover:text-slate-900\'\\n            }`}\\n          >\\n            <Table className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Dataset (JSON)</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* TAB 1: DIAGRAMA ERD & DBML */}\\n      {activeSpecTab === \'erd\' && (\\n        <div className=\\\"space-y-4\\\">\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-4\\\">\\n            \\n            {/* Mermaid Schema Card */}\\n            <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-3 shadow-2xs\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-bold text-slate-900 text-xs flex items-center gap-1.5\\\">\\n                  <Database className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                  <span>Diagrama Entidad-Relaci\303\263n (Mermaid Format)</span>\\n                </h3>\\n                <button\\n                  onClick={() => handleCopy(erdMermaid, \'mermaid\')}\\n                  className=\\\"flex items-center gap-1 text-[11px] text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-2 py-0.5 rounded cursor-pointer\\\"\\n                >\\n                  {copiedCode === \'mermaid\' ? <Check className=\\\"w-3 h-3 text-emerald-600\\\" /> : <Copy className=\\\"w-3 h-3\\\" />}\\n                  <span>{copiedCode === \'mermaid\' ? \'Copiado\' : \'Copiar Mermaid\'}</span>\\n                </button>\\n              </div>\\n\\n              <pre className=\\\"bg-slate-900 p-3.5 rounded-lg border border-slate-800 text-[11px] font-mono text-emerald-400 overflow-x-auto max-h-[440px] custom-scrollbar\\\">\\n                {erdMermaid}\\n              </pre>\\n            </div>\\n\\n            {/* DBML Schema Card */}\\n            <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-3 shadow-2xs\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-bold text-slate-900 text-xs flex items-center gap-1.5\\\">\\n                  <FileCode className=\\\"w-3.5 h-3.5 text-blue-600\\\" />\\n                  <span>Esquema Relacional en DBML</span>\\n                </h3>\\n                <button\\n                  onClick={() => handleCopy(erdDbml, \'dbml\')}\\n                  className=\\\"flex items-center gap-1 text-[11px] text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-2 py-0.5 rounded cursor-pointer\\\"\\n                >\\n                  {copiedCode === \'dbml\' ? <Check className=\\\"w-3 h-3 text-blue-600\\\" /> : <Copy className=\\\"w-3 h-3\\\" />}\\n                  <span>{copiedCode === \'dbml\' ? \'Copiado\' : \'Copiar DBML\'}</span>\\n                </button>\\n              </div>\\n\\n              <pre className=\\\"bg-slate-900 p-3.5 rounded-lg border border-slate-800 text-[11px] font-mono text-sky-300 overflow-x-auto max-h-[440px] custom-scrollbar\\\">\\n                {erdDbml}\\n              </pre>\\n            </div>\\n\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: M\303\201QUINA DE ESTADOS Y TRANSICIONES */}\\n      {activeSpecTab === \'stateMachine\' && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-4 shadow-2xs\\\">\\n          <div>\\n            <h3 className=\\\"font-bold text-slate-900 text-sm\\\">\\n              M\303\241quina de Estados & Matriz de Transiciones Cronol\303\263gicas\\n            </h3>\\n            <p className=\\\"text-[11px] text-slate-500 mt-0.5\\\">\\n              Eventos, disparadores cronol\303\263gicos, condiciones de guarda y roles con permiso de transici\303\263n.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"overflow-x-auto border border-slate-200 rounded-md\\\">\\n            <table className=\\\"w-full text-left text-xs border-collapse\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-slate-200 bg-slate-50 text-slate-600 font-bold uppercase text-[9px]\\\">\\n                  <th className=\\\"p-2.5\\\">Fase Origen \342\236\224 Destino</th>\\n                  <th className=\\\"p-2.5\\\">Ventana Cronol\303\263gica</th>\\n                  <th className=\\\"p-2.5\\\">Evento / Disparador</th>\\n                  <th className=\\\"p-2.5\\\">Validaci\303\263n / Condici\303\263n de Guarda</th>\\n                  <th className=\\\"p-2.5\\\">Roles Autorizados</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-slate-100 text-slate-700\\\">\\n                <tr className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"p-2.5 font-bold text-blue-700\\\">\\n                    Ideaci\303\263n \342\236\224 Calendarizaci\303\263n\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-slate-500 text-[11px]\\\">D\303\255a 1 al 15</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Aprobaci\303\263n de concepto narrativo y hook inicial</td>\\n                  <td className=\\\"p-2.5 text-slate-600 text-[11px]\\\">\\n                    Marca con \342\211\245 3 territorios activos y territorio seleccionado.\\n                  </td>\\n                  <td className=\\\"p-2.5 font-semibold text-emerald-800 text-[11px]\\\">\\n                    Cliente, Colaborador, Director\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"p-2.5 font-bold text-indigo-700\\\">\\n                    Calendarizaci\303\263n \342\236\224 Gu\303\255a T\303\251cnica\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-slate-500 text-[11px]\\\">D\303\255a 15 al 20</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Definici\303\263n de fechas de rodaje y publicaci\303\263n</td>\\n                  <td className=\\\"p-2.5 text-slate-600 text-[11px]\\\">\\n                    Fechas de producci\303\263n y publicaci\303\263n v\303\241lidas. Sin colisi\303\263n de hardware.\\n                  </td>\\n                  <td className=\\\"p-2.5 font-semibold text-emerald-800 text-[11px]\\\">\\n                    Colaborador, Director\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"p-2.5 font-bold text-amber-700\\\">\\n                    Gu\303\255a T\303\251cnica \342\236\224 En Rodaje\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-slate-500 text-[11px]\\\">D\303\255a 20 a Fin-5</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Firma t\303\251cnica y visto bueno de Direcci\303\263n</td>\\n                  <td className=\\\"p-2.5 text-slate-600 text-[11px]\\\">\\n                    Shotlist compilado, equipos reservados y Visto Bueno del Director.\\n                  </td>\\n                  <td className=\\\"p-2.5 font-semibold text-purple-800 text-[11px]\\\">\\n                    Director de Proyecto, WebAdmin\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"p-2.5 font-bold text-rose-700\\\">\\n                    En Rodaje \342\236\224 Post-Producci\303\263n\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-slate-500 text-[11px]\\\">Ventana Rodaje</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Cierre de rodaje e ingesta de metraje bruto (RAW/Log)</td>\\n                  <td className=\\\"p-2.5 text-slate-600 text-[11px]\\\">\\n                    Liberaci\303\263n de hardware en inventario para otros rodajes.\\n                  </td>\\n                  <td className=\\\"p-2.5 font-semibold text-blue-800 text-[11px]\\\">\\n                    Colaborador Audiovisual\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"p-2.5 font-bold text-purple-700\\\">\\n                    Post-Producci\303\263n \342\236\224 Aprobaci\303\263n Cliente\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-slate-500 text-[11px]\\\">Fin-5 a Fin-3</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Exportaci\303\263n de corte preliminar (Rough Cut / Color)</td>\\n                  <td className=\\\"p-2.5 text-slate-600 text-[11px]\\\">\\n                    Render en relaciones de aspecto especificadas (9:16, 16:9).\\n                  </td>\\n                  <td className=\\\"p-2.5 font-semibold text-blue-800 text-[11px]\\\">\\n                    Colaborador, Director\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-red-50/50 bg-red-50/30 border-l-2 border-red-500\\\">\\n                  <td className=\\\"p-2.5 font-bold text-red-700\\\">\\n                    Aprobaci\303\263n Cliente (Ventana T-3)\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-red-700 font-bold text-[11px]\\\">\342\211\244 3 D\303\255as de Publicaci\303\263n</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Solicitud de ajuste de \303\272ltimo minuto por cliente</td>\\n                  <td className=\\\"p-2.5 text-red-900 text-[11px]\\\">\\n                    <strong>REGLA T-3:</strong> Bloqueo autom\303\241tico. Requiere \\\"Director Override\\\" con sobrecosto y retraso en horas.\\n                  </td>\\n                  <td className=\\\"p-2.5 font-bold text-purple-800 text-[11px]\\\">\\n                    Director (Override Exclusivo)\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"p-2.5 font-bold text-emerald-700\\\">\\n                    Aprobaci\303\263n \342\236\224 Publicado\\n                  </td>\\n                  <td className=\\\"p-2.5 font-mono text-slate-500 text-[11px]\\\">Fecha de Lanzamiento</td>\\n                  <td className=\\\"p-2.5 text-[11px]\\\">Aprobaci\303\263n final del cliente o Director</td>\\n                  <td className=\\\"p-2.5 text-slate-600 text-[11px]\\\">\\n                    Masters exportados en ProRes/H.265 y checklist de calidad cerrado.\\n                  </td>\\n                  <td className=\\\"p-2.5 font-semibold text-emerald-800 text-[11px]\\\">\\n                    Cliente, Director, WebAdmin\\n                  </td>\\n                </tr>\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: CONTRATOS DE API REST */}\\n      {activeSpecTab === \'apiDocs\' && (\\n        <div className=\\\"space-y-4\\\">\\n          <div className=\\\"grid grid-cols-1 gap-3\\\">\\n            \\n            {/* Endpoint 1 */}\\n            <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-2.5 shadow-2xs\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 font-mono font-bold text-[11px]\\\">\\n                  POST\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-slate-900\\\">/api/gemini/ideate</span>\\n                <span className=\\\"text-[11px] text-slate-500 ml-auto font-medium\\\">\\n                  Generaci\303\263n Co-creativa con Gemini\\n                </span>\\n              </div>\\n              <p className=\\\"text-[11px] text-slate-600\\\">\\n                Genera 3 propuestas narrativas completas con gancho de retenci\303\263n de 3 segundos basado en el territorio de comunicaci\303\263n.\\n              </p>\\n              <pre className=\\\"bg-slate-900 p-3 rounded-lg border border-slate-800 text-[11px] font-mono text-indigo-300 overflow-x-auto\\\">\\n{`// Payload Request:\\n{\\n  \\\"brandName\\\": \\\"Apex Athletics\\\",\\n  \\\"industry\\\": \\\"Indumentaria Deportiva de Alto Rendimiento\\\",\\n  \\\"brandTone\\\": \\\"\303\211pico, en\303\251rgico y cinem\303\241tico\\\",\\n  \\\"territory\\\": \\\"Rendimiento Extremo & Atletas Pro\\\",\\n  \\\"briefPrompt\\\": \\\"Spot de calzado Kinetic Aero\\\"\\n}\\n\\n// Response:\\n{\\n  \\\"ideas\\\": [\\n    {\\n      \\\"title\\\": \\\"Apex Kinetic Aero - Desaf\303\255o de la Gravedad\\\",\\n      \\\"hook\\\": \\\"\302\277Qu\303\251 se siente correr a 30km/h en medio de la niebla?\\\",\\n      \\\"narrativeConcept\\\": \\\"Plano secuencia din\303\241mico siguiendo...\\\",\\n      \\\"visualStyle\\\": \\\"Alto contraste, color grading fr\303\255o...\\\",\\n      \\\"audioDesign\\\": \\\"Sonido de respiraci\303\263n r\303\255tmica y drop musical...\\\",\\n      \\\"format\\\": \\\"Video Vertical 9:16 UHD\\\"\\n    }\\n  ]\\n}`}\\n              </pre>\\n            </div>\\n\\n            {/* Endpoint 2 */}\\n            <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-2.5 shadow-2xs\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 font-mono font-bold text-[11px]\\\">\\n                  POST\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-slate-900\\\">/api/gemini/technical-guide</span>\\n                <span className=\\\"text-[11px] text-slate-500 ml-auto font-medium\\\">\\n                  Compilaci\303\263n de Gu\303\255a T\303\251cnica Audiovisual\\n                </span>\\n              </div>\\n              <pre className=\\\"bg-slate-900 p-3 rounded-lg border border-slate-800 text-[11px] font-mono text-emerald-300 overflow-x-auto\\\">\\n{`// Payload Request:\\n{\\n  \\\"deliverable\\\": { \\\"title\\\": \\\"Lumina Skin Glow\\\", \\\"format\\\": \\\"9:16 UHD\\\", ... },\\n  \\\"styleNotes\\\": \\\"Estilo macro anam\303\263rfico, iluminaci\303\263n key suave...\\\"\\n}\\n\\n// Response:\\n{\\n  \\\"aspectRatios\\\": [\\\"9:16\\\", \\\"4:5\\\"],\\n  \\\"frameRate\\\": \\\"60fps slow-motion\\\",\\n  \\\"colorSpace\\\": \\\"Apple Log ProRes 422HQ\\\",\\n  \\\"audioSpecs\\\": \\\"Audio 32-bit Float (-18dB target)\\\",\\n  \\\"lightingScheme\\\": \\\"Difusor de 120cm + Rim Light 3200K c\303\241lido\\\",\\n  \\\"shotlist\\\": [\\n    {\\n      \\\"shotNumber\\\": 1,\\n      \\\"description\\\": \\\"Macro a gota de serum cayendo en p\303\263mulo\\\",\\n      \\\"cameraAngle\\\": \\\"Extreme Close-Up Macro\\\",\\n      \\\"movement\\\": \\\"Push-in lento\\\",\\n      \\\"durationSec\\\": 3,\\n      \\\"audioNote\\\": \\\"ASMR n\303\255tido de apertura\\\"\\n    }\\n  ]\\n}`}\\n              </pre>\\n            </div>\\n\\n            {/* Endpoint 3 */}\\n            <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-2.5 shadow-2xs\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 font-mono font-bold text-[11px]\\\">\\n                  POST\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-slate-900\\\">/api/gemini/evaluate-change</span>\\n                <span className=\\\"text-[11px] text-slate-500 ml-auto font-medium\\\">\\n                  Evaluador de Regla de Ventana T-3\\n                </span>\\n              </div>\\n              <pre className=\\\"bg-slate-900 p-3 rounded-lg border border-slate-800 text-[11px] font-mono text-amber-300 overflow-x-auto\\\">\\n{`// Payload Request:\\n{\\n  \\\"deliverable\\\": { \\\"id\\\": \\\"del-1\\\", \\\"publishDate\\\": \\\"2026-08-19\\\" },\\n  \\\"changeRequestDescription\\\": \\\"Cambiar toda la m\303\272sica y reeditar el segundo acto\\\",\\n  \\\"daysToPublish\\\": 2\\n}\\n\\n// Response:\\n{\\n  \\\"verdict\\\": \\\"blocked_t3_override_required\\\",\\n  \\\"incursTMinus3Penalty\\\": true,\\n  \\\"estimatedDelayHours\\\": 36,\\n  \\\"additionalCostUSD\\\": 450,\\n  \\\"riskAssessment\\\": \\\"Alto riesgo de retrasar el estreno oficial de la marca.\\\",\\n  \\\"directorRationale\\\": \\\"Solicitud recibida a T-2 d\303\255as. Reedici\303\263n exige desarmar timeline y nuevo render.\\\"\\n}`}\\n              </pre>\\n            </div>\\n\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 4: MOCK DATASET INICIAL (JSON) */}\\n      {activeSpecTab === \'mockData\' && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 space-y-3 shadow-2xs\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n            <div>\\n              <h3 className=\\\"font-bold text-slate-900 text-sm\\\">\\n                Dataset Inicial de Demostraci\303\263n Completo\\n              </h3>\\n              <p className=\\\"text-[11px] text-slate-500\\\">\\n                1 Director de Proyecto, 2 Colaboradores con cupos, 6 Clientes/Marcas con \342\211\2453 territorios, inventario de hardware y 12 entregables.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                onClick={() => handleCopy(JSON.stringify(INITIAL_DATA_SNAPSHOT, null, 2), \'mockJson\')}\\n                className=\\\"flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 text-xs font-semibold transition-all cursor-pointer\\\"\\n              >\\n                {copiedCode === \'mockJson\' ? <Check className=\\\"w-3.5 h-3.5 text-emerald-600\\\" /> : <Copy className=\\\"w-3.5 h-3.5\\\" />}\\n                <span>{copiedCode === \'mockJson\' ? \'Copiado\' : \'Copiar JSON\'}</span>\\n              </button>\\n\\n              <button\\n                onClick={() => {\\n                  const blob = new Blob([JSON.stringify(INITIAL_DATA_SNAPSHOT, null, 2)], {\\n                    type: \'application/json\',\\n                  });\\n                  const url = URL.createObjectURL(blob);\\n                  const a = document.createElement(\'a\');\\n                  a.href = url;\\n                  a.download = \'cineflow-dataset.json\';\\n                  a.click();\\n                }}\\n                className=\\\"flex items-center gap-1.5 px-3 py-1 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs cursor-pointer\\\"\\n              >\\n                <Download className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Descargar Dataset</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          <pre className=\\\"bg-slate-900 p-3.5 rounded-lg border border-slate-800 text-[11px] font-mono text-slate-200 overflow-x-auto max-h-[460px] custom-scrollbar\\\">\\n            {JSON.stringify(INITIAL_DATA_SNAPSHOT, null, 2)}\\n          </pre>\\n        </div>\\n      )}\\n\\n    </div>\\n  );\", \"TargetContent\":\"  return (\\n    <div className=\\\"space-y-6\\\">\\n      \\n      {/* Header */}\\n      <div className=\\\"bg-zinc-900/70 border border-zinc-800 rounded-2xl p-6 shadow-xl flex flex-wrap items-center justify-between gap-4\\\">\\n        <div className=\\\"flex items-center gap-4\\\">\\n          <div className=\\\"w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shadow-md\\\">\\n            <FileCode className=\\\"w-6 h-6\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-lg font-bold text-white flex items-center gap-2\\\">\\n              <span>Especificaciones T\303\251cnicas & Arquitectura del Sistema</span>\\n              <span className=\\\"text-xs font-mono font-normal px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700\\\">\\n                DBML \342\200\242 ERD \342\200\242 State Machine \342\200\242 OpenAPI\\n              </span>\\n            </h2>\\n            <p className=\\\"text-xs text-zinc-400\\\">\\n              Modelo relacional, reglas cronol\303\263gicas de negocio, matriz de transiciones de estado y dataset inicial.\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Spec Tab Switcher */}\\n        <div className=\\\"flex items-center gap-2 bg-zinc-950 p-1.5 rounded-xl border border-zinc-800 text-xs font-semibold\\\">\\n          <button\\n            onClick={() => setActiveSpecTab(\'erd\')}\\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-all ${\\n              activeSpecTab === \'erd\'\\n                ? \'bg-emerald-600 text-white shadow-sm\'\\n                : \'text-zinc-400 hover:text-zinc-200\'\\n            }`}\\n          >\\n            <Database className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Diagrama ERD & DBML</span>\\n          </button>\\n\\n          <button\\n            onClick={() => setActiveSpecTab(\'stateMachine\')}\\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-all ${\\n              activeSpecTab === \'stateMachine\'\\n                ? \'bg-emerald-600 text-white shadow-sm\'\\n                : \'text-zinc-400 hover:text-zinc-200\'\\n            }`}\\n          >\\n            <GitBranch className=\\\"w-3.5 h-3.5\\\" />\\n            <span>M\303\241quina de Estados & T-3</span>\\n          </button>\\n\\n          <button\\n            onClick={() => setActiveSpecTab(\'apiDocs\')}\\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-all ${\\n              activeSpecTab === \'apiDocs\'\\n                ? \'bg-emerald-600 text-white shadow-sm\'\\n                : \'text-zinc-400 hover:text-zinc-200\'\\n            }`}\\n          >\\n            <Terminal className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Contratos de API REST</span>\\n          </button>\\n\\n          <button\\n            onClick={() => setActiveSpecTab(\'mockData\')}\\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-all ${\\n              activeSpecTab === \'mockData\'\\n                ? \'bg-emerald-600 text-white shadow-sm\'\\n                : \'text-zinc-400 hover:text-zinc-200\'\\n            }`}\\n          >\\n            <Table className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Dataset Inicial (JSON)</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* TAB 1: DIAGRAMA ERD & DBML */}\\n      {activeSpecTab === \'erd\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n            \\n            {/* Mermaid Schema Card */}\\n            <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 space-y-4\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-bold text-white text-sm flex items-center gap-2\\\">\\n                  <Database className=\\\"w-4 h-4 text-emerald-400\\\" />\\n                  <span>Diagrama Entidad-Relaci\303\263n (Mermaid Format)</span>\\n                </h3>\\n                <button\\n                  onClick={() => handleCopy(erdMermaid, \'mermaid\')}\\n                  className=\\\"flex items-center gap-1 text-xs text-zinc-400 hover:text-white bg-zinc-800 px-2.5 py-1 rounded\\\"\\n                >\\n                  {copiedCode === \'mermaid\' ? <Check className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> : <Copy className=\\\"w-3.5 h-3.5\\\" />}\\n                  <span>{copiedCode === \'mermaid\' ? \'Copiado\' : \'Copiar Mermaid\'}</span>\\n                </button>\\n              </div>\\n\\n              <pre className=\\\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-[11px] font-mono text-zinc-300 overflow-x-auto max-h-[480px] custom-scrollbar\\\">\\n                {erdMermaid}\\n              </pre>\\n            </div>\\n\\n            {/* DBML Schema Card */}\\n            <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 space-y-4\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-bold text-white text-sm flex items-center gap-2\\\">\\n                  <FileCode className=\\\"w-4 h-4 text-indigo-400\\\" />\\n                  <span>Esquema Relacional en DBML (Database Markup Language)</span>\\n                </h3>\\n                <button\\n                  onClick={() => handleCopy(erdDbml, \'dbml\')}\\n                  className=\\\"flex items-center gap-1 text-xs text-zinc-400 hover:text-white bg-zinc-800 px-2.5 py-1 rounded\\\"\\n                >\\n                  {copiedCode === \'dbml\' ? <Check className=\\\"w-3.5 h-3.5 text-indigo-400\\\" /> : <Copy className=\\\"w-3.5 h-3.5\\\" />}\\n                  <span>{copiedCode === \'dbml\' ? \'Copiado\' : \'Copiar DBML\'}</span>\\n                </button>\\n              </div>\\n\\n              <pre className=\\\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-[11px] font-mono text-zinc-300 overflow-x-auto max-h-[480px] custom-scrollbar\\\">\\n                {erdDbml}\\n              </pre>\\n            </div>\\n\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: M\303\201QUINA DE ESTADOS Y TRANSICIONES */}\\n      {activeSpecTab === \'stateMachine\' && (\\n        <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-6\\\">\\n          <div>\\n            <h3 className=\\\"font-bold text-white text-base\\\">\\n              M\303\241quina de Estados & Matriz de Transiciones Cronol\303\263gicas\\n            </h3>\\n            <p className=\\\"text-xs text-zinc-400 mt-1\\\">\\n              Eventos, disparadores cronol\303\263gicos, condiciones de guarda y roles con permiso de transici\303\263n.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left text-xs border-collapse\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-zinc-800 bg-zinc-950/80 text-zinc-400 font-semibold uppercase text-[10px]\\\">\\n                  <th className=\\\"p-3\\\">Fase Origen \342\236\224 Destino</th>\\n                  <th className=\\\"p-3\\\">Ventana Cronol\303\263gica</th>\\n                  <th className=\\\"p-3\\\">Evento / Disparador</th>\\n                  <th className=\\\"p-3\\\">Validaci\303\263n / Condici\303\263n de Guarda</th>\\n                  <th className=\\\"p-3\\\">Roles Autorizados</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-zinc-800 text-zinc-300\\\">\\n                <tr className=\\\"hover:bg-zinc-950/40\\\">\\n                  <td className=\\\"p-3 font-semibold text-blue-400\\\">\\n                    Ideaci\303\263n \342\236\224 Calendarizaci\303\263n\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-zinc-400\\\">D\303\255a 1 al 15</td>\\n                  <td className=\\\"p-3\\\">Aprobaci\303\263n de concepto narrativo y hook inicial</td>\\n                  <td className=\\\"p-3 text-zinc-400\\\">\\n                    Marca con \342\211\245 3 territorios activos y territorio seleccionado.\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-emerald-400\\\">\\n                    Cliente, Colaborador, Director\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-zinc-950/40\\\">\\n                  <td className=\\\"p-3 font-semibold text-indigo-400\\\">\\n                    Calendarizaci\303\263n \342\236\224 Gu\303\255a T\303\251cnica\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-zinc-400\\\">D\303\255a 15 al 20</td>\\n                  <td className=\\\"p-3\\\">Definici\303\263n de fechas de rodaje y publicaci\303\263n</td>\\n                  <td className=\\\"p-3 text-zinc-400\\\">\\n                    Fechas de producci\303\263n y publicaci\303\263n v\303\241lidas. Sin colisi\303\263n de hardware.\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-emerald-400\\\">\\n                    Colaborador, Director\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-zinc-950/40\\\">\\n                  <td className=\\\"p-3 font-semibold text-amber-400\\\">\\n                    Gu\303\255a T\303\251cnica \342\236\224 En Rodaje\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-zinc-400\\\">D\303\255a 20 a Fin-5</td>\\n                  <td className=\\\"p-3\\\">Firma t\303\251cnica y visto bueno de Direcci\303\263n</td>\\n                  <td className=\\\"p-3 text-zinc-400\\\">\\n                    Shotlist compilado, equipos reservados y Visto Bueno del Director.\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-purple-400\\\">\\n                    Director de Proyecto, WebAdmin\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-zinc-950/40\\\">\\n                  <td className=\\\"p-3 font-semibold text-rose-400\\\">\\n                    En Rodaje \342\236\224 Post-Producci\303\263n\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-zinc-400\\\">Ventana Rodaje</td>\\n                  <td className=\\\"p-3\\\">Cierre de rodaje e ingesta de metraje bruto (RAW/Log)</td>\\n                  <td className=\\\"p-3 text-zinc-400\\\">\\n                    Liberaci\303\263n de hardware en inventario para otros rodajes.\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-blue-400\\\">\\n                    Colaborador Audiovisual\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-zinc-950/40\\\">\\n                  <td className=\\\"p-3 font-semibold text-purple-400\\\">\\n                    Post-Producci\303\263n \342\236\224 Aprobaci\303\263n Cliente\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-zinc-400\\\">Fin-5 a Fin-3</td>\\n                  <td className=\\\"p-3\\\">Exportaci\303\263n de corte preliminar (Rough Cut / Color)</td>\\n                  <td className=\\\"p-3 text-zinc-400\\\">\\n                    Render en relaciones de aspecto especificadas (9:16, 16:9).\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-blue-400\\\">\\n                    Colaborador, Director\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-zinc-950/40 bg-red-950/15 border-l-2 border-red-500\\\">\\n                  <td className=\\\"p-3 font-semibold text-red-400\\\">\\n                    Aprobaci\303\263n Cliente (Ventana T-3)\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-red-300\\\">\342\211\244 3 D\303\255as de Publicaci\303\263n</td>\\n                  <td className=\\\"p-3\\\">Solicitud de ajuste de \303\272ltimo minuto por cliente</td>\\n                  <td className=\\\"p-3 text-red-300\\\">\\n                    <strong>REGLA T-3:</strong> Bloqueo autom\303\241tico. Requiere \\\"Director Override\\\" con sobrecosto y retraso en horas.\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-purple-400\\\">\\n                    Director (Override Exclusivo)\\n                  </td>\\n                </tr>\\n\\n                <tr className=\\\"hover:bg-zinc-950/40\\\">\\n                  <td className=\\\"p-3 font-semibold text-emerald-400\\\">\\n                    Aprobaci\303\263n \342\236\224 Publicado\\n                  </td>\\n                  <td className=\\\"p-3 font-mono text-zinc-400\\\">Fecha de Lanzamiento</td>\\n                  <td className=\\\"p-3\\\">Aprobaci\303\263n final del cliente o Director</td>\\n                  <td className=\\\"p-3 text-zinc-400\\\">\\n                    Masters exportados en ProRes/H.265 y checklist de calidad cerrado.\\n                  </td>\\n                  <td className=\\\"p-3 font-semibold text-emerald-400\\\">\\n                    Cliente, Director, WebAdmin\\n                  </td>\\n                </tr>\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: CONTRATOS DE API REST */}\\n      {activeSpecTab === \'apiDocs\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"grid grid-cols-1 gap-4\\\">\\n            \\n            {/* Endpoint 1 */}\\n            <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 space-y-3\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-mono font-bold text-xs\\\">\\n                  POST\\n                </span>\\n                <span className=\\\"font-mono text-sm text-white\\\">/api/gemini/ideate</span>\\n                <span className=\\\"text-xs text-zinc-400 ml-auto\\\">\\n                  Generaci\303\263n Co-creativa con Gemini 3.7 Flash\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs text-zinc-300\\\">\\n                Genera 3 propuestas narrativas completas con gancho de retenci\303\263n de 3 segundos basado en el territorio de comunicaci\303\263n.\\n              </p>\\n              <pre className=\\\"bg-zinc-950 p-3 rounded-xl border border-zinc-800 text-[11px] font-mono text-indigo-300 overflow-x-auto\\\">\\n{`// Payload Request:\\n{\\n  \\\"brandName\\\": \\\"Apex Athletics\\\",\\n  \\\"industry\\\": \\\"Indumentaria Deportiva de Alto Rendimiento\\\",\\n  \\\"brandTone\\\": \\\"\303\211pico, en\303\251rgico y cinem\303\241tico\\\",\\n  \\\"territory\\\": \\\"Rendimiento Extremo & Atletas Pro\\\",\\n  \\\"briefPrompt\\\": \\\"Spot de calzado Kinetic Aero\\\"\\n}\\n\\n// Response:\\n{\\n  \\\"ideas\\\": [\\n    {\\n      \\\"title\\\": \\\"Apex Kinetic Aero - Desaf\303\255o de la Gravedad\\\",\\n      \\\"hook\\\": \\\"\302\277Qu\303\251 se siente correr a 30km/h en medio de la niebla?\\\",\\n      \\\"narrativeConcept\\\": \\\"Plano secuencia din\303\241mico siguiendo...\\\",\\n      \\\"visualStyle\\\": \\\"Alto contraste, color grading fr\303\255o...\\\",\\n      \\\"audioDesign\\\": \\\"Sonido de respiraci\303\263n r\303\255tmica y drop musical...\\\",\\n      \\\"format\\\": \\\"Video Vertical 9:16 UHD\\\"\\n    }\\n  ]\\n}`}\\n              </pre>\\n            </div>\\n\\n            {/* Endpoint 2 */}\\n            <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 space-y-3\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-mono font-bold text-xs\\\">\\n                  POST\\n                </span>\\n                <span className=\\\"font-mono text-sm text-white\\\">/api/gemini/technical-guide</span>\\n                <span className=\\\"text-xs text-zinc-400 ml-auto\\\">\\n                  Compilaci\303\263n de Gu\303\255a T\303\251cnica Audiovisual\\n                </span>\\n              </div>\\n              <pre className=\\\"bg-zinc-950 p-3 rounded-xl border border-zinc-800 text-[11px] font-mono text-emerald-300 overflow-x-auto\\\">\\n{`// Payload Request:\\n{\\n  \\\"deliverable\\\": { \\\"title\\\": \\\"Lumina Skin Glow\\\", \\\"format\\\": \\\"9:16 UHD\\\", ... },\\n  \\\"styleNotes\\\": \\\"Estilo macro anam\303\263rfico, iluminaci\303\263n key suave...\\\"\\n}\\n\\n// Response:\\n{\\n  \\\"aspectRatios\\\": [\\\"9:16\\\", \\\"4:5\\\"],\\n  \\\"frameRate\\\": \\\"60fps slow-motion\\\",\\n  \\\"colorSpace\\\": \\\"Apple Log ProRes 422HQ\\\",\\n  \\\"audioSpecs\\\": \\\"Audio 32-bit Float (-18dB target)\\\",\\n  \\\"lightingScheme\\\": \\\"Difusor de 120cm + Rim Light 3200K c\303\241lido\\\",\\n  \\\"shotlist\\\": [\\n    {\\n      \\\"shotNumber\\\": 1,\\n      \\\"description\\\": \\\"Macro a gota de serum cayendo en p\303\263mulo\\\",\\n      \\\"cameraAngle\\\": \\\"Extreme Close-Up Macro\\\",\\n      \\\"movement\\\": \\\"Push-in lento\\\",\\n      \\\"durationSec\\\": 3,\\n      \\\"audioNote\\\": \\\"ASMR n\303\255tido de apertura\\\"\\n    }\\n  ]\\n}`}\\n              </pre>\\n            </div>\\n\\n            {/* Endpoint 3 */}\\n            <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 space-y-3\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-mono font-bold text-xs\\\">\\n                  POST\\n                </span>\\n                <span className=\\\"font-mono text-sm text-white\\\">/api/gemini/evaluate-change</span>\\n                <span className=\\\"text-xs text-zinc-400 ml-auto\\\">\\n                  Evaluador de Regla de Ventana T-3\\n                </span>\\n              </div>\\n              <pre className=\\\"bg-zinc-950 p-3 rounded-xl border border-zinc-800 text-[11px] font-mono text-amber-300 overflow-x-auto\\\">\\n{`// Payload Request:\\n{\\n  \\\"deliverable\\\": { \\\"id\\\": \\\"del-1\\\", \\\"publishDate\\\": \\\"2026-08-19\\\" },\\n  \\\"changeRequestDescription\\\": \\\"Cambiar toda la m\303\272sica y reeditar el segundo acto\\\",\\n  \\\"daysToPublish\\\": 2\\n}\\n\\n// Response:\\n{\\n  \\\"verdict\\\": \\\"blocked_t3_override_required\\\",\\n  \\\"incursTMinus3Penalty\\\": true,\\n  \\\"estimatedDelayHours\\\": 36,\\n  \\\"additionalCostUSD\\\": 450,\\n  \\\"riskAssessment\\\": \\\"Alto riesgo de retrasar el estreno oficial de la marca.\\\",\\n  \\\"directorRationale\\\": \\\"Solicitud recibida a T-2 d\303\255as. Reedici\303\263n exige desarmar timeline y nuevo render.\\\"\\n}`}\\n              </pre>\\n            </div>\\n\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 4: MOCK DATASET INICIAL (JSON) */}\\n      {activeSpecTab === \'mockData\' && (\\n        <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <div>\\n              <h3 className=\\\"font-bold text-white text-base\\\">\\n                Dataset Inicial de Demostraci\303\263n Completo\\n              </h3>\\n              <p className=\\\"text-xs text-zinc-400\\\">\\n                1 Director de Proyecto, 2 Colaboradores con cupos, 6 Clientes/Marcas con \342\211\2453 territorios, inventario de hardware y 12 entregables iniciales.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                onClick={() => handleCopy(JSON.stringify(INITIAL_DATA_SNAPSHOT, null, 2), \'mockJson\')}\\n                className=\\\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-medium transition-all\\\"\\n              >\\n                {copiedCode === \'mockJson\' ? <Check className=\\\"w-3.5 h-3.5 text-emerald-400\\\" /> : <Copy className=\\\"w-3.5 h-3.5\\\" />}\\n                <span>{copiedCode === \'mockJson\' ? \'Copiado\' : \'Copiar JSON\'}</span>\\n              </button>\\n\\n              <button\\n                onClick={() => {\\n                  const blob = new Blob([JSON.stringify(INITIAL_DATA_SNAPSHOT, null, 2)], {\\n                    type: \'application/json\',\\n                  });\\n                  const url = URL.createObjectURL(blob);\\n                  const a = document.createElement(\'a\');\\n                  a.href = url;\\n                  a.download = \'cineflow-dataset.json\';\\n                  a.click();\\n                }}\\n                className=\\\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-md\\\"\\n              >\\n                <Download className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Descargar Dataset</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          <pre className=\\\"bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-[11px] font-mono text-zinc-300 overflow-x-auto max-h-[500px] custom-scrollbar\\\">\\n            {JSON.stringify(INITIAL_DATA_SNAPSHOT, null, 2)}\\n          </pre>\\n        </div>\\n      )}\\n\\n    </div>\\n  );\", \"TargetFile\":\"/src/components/SystemSpecsHub.tsx\", \"toolAction\":\"Editing SystemSpecsHub.tsx\", \"toolSummary\":\"Editing SystemSpecsHub.tsx\"}"
