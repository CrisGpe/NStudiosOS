        }
        lines {
          text: "          {(guide.exportTargets || [\'Master ProRes 422HQ\', \'Instagram Reels 1080x1920\', \'TikTok HQ\']).map("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
