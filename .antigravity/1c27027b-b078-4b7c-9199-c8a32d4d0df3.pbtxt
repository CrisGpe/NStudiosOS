  planner_response {
    thinking: "**Refining Brand UI**\n\nI\'m currently working on updating the BrandTerritoryManager component to align with the High Density theme. Specifically, I\'m adjusting the styling of the brand selector buttons and brand info card. The selector buttons will now have a lighter background and border, while the brand info card gets a white background, rounded corners, and a subtle shadow. I also need to ensure validation is working as expected.\n\n\n"
    tool_calls {
      id: "call_3983018"
      name: "edit_file"
      arguments_json: "{\"Instruction\":\"Apply High Density styling to BrandTerritoryManager component\", \"ReplacementContent\":\"  const getAssetIcon = (type: AssetType) => {\\n    switch (type) {\\n      case \'website\':\\n      case \'landing_page\':\\n        return <Globe className=\\\"w-4 h-4 text-blue-600\\\" />;\\n      case \'mobile_app\':\\n        return <Smartphone className=\\\"w-4 h-4 text-purple-600\\\" />;\\n      case \'brand_guidelines\':\\n      case \'catalog\':\\n        return <BookOpen className=\\\"w-4 h-4 text-amber-600\\\" />;\\n      case \'media_kit\':\\n      case \'social_channel\':\\n        return <FileText className=\\\"w-4 h-4 text-emerald-600\\\" />;\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-4\\\">\\n      \\n      {/* Brand Horizontal Carousel / Selector - High Density */}\\n      <div className=\\\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5\\\">\\n        {brands.map((brand) => {\\n          const isSelected = brand.id === currentBrand?.id;\\n          const terrStatus = validateBrandTerritories(brand.id);\\n\\n          return (\\n            <button\\n              key={brand.id}\\n              onClick={() => setActiveBrandId(brand.id)}\\n              className={`p-2.5 rounded-lg border text-left transition-all relative overflow-hidden flex flex-col justify-between cursor-pointer ${\\n                isSelected\\n                  ? \'bg-white border-blue-600 ring-1 ring-blue-500 shadow-xs\'\\n                  : \'bg-white hover:bg-slate-50 border-slate-200 hover:border-slate-300 shadow-2xs\'\\n              }`}\\n            >\\n              {/* Brand Color Header line */}\\n              <div\\n                className=\\\"absolute top-0 left-0 right-0 h-1\\\"\\n                style={{ backgroundColor: brand.primaryColor }}\\n              />\\n\\n              <div className=\\\"flex items-center gap-2 mb-1.5 pt-0.5\\\">\\n                <img\\n                  src={brand.logo}\\n                  alt={brand.name}\\n                  className=\\\"w-6 h-6 rounded-md object-cover ring-1 ring-slate-200\\\"\\n                />\\n                <span className=\\\"font-bold text-xs text-slate-900 truncate\\\">{brand.name}</span>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between text-[10px] text-slate-500 pt-1 border-t border-slate-100\\\">\\n                <span className=\\\"font-medium\\\">{terrStatus.activeCount} Territorios</span>\\n                {terrStatus.isValid ? (\\n                  <CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                ) : (\\n                  <AlertTriangle className=\\\"w-3.5 h-3.5 text-amber-600\\\" />\\n                )}\\n              </div>\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {/* Current Brand Active Header */}\\n      {currentBrand && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-lg p-4 shadow-2xs space-y-4\\\">\\n          \\n          <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <img\\n                src={currentBrand.logo}\\n                alt={currentBrand.name}\\n                className=\\\"w-12 h-12 rounded-xl object-cover ring-1 ring-slate-200 shadow-2xs\\\"\\n              />\\n              <div>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <h2 className=\\\"text-base font-bold text-slate-900\\\">{currentBrand.name}</h2>\\n                  <span\\n                    className=\\\"w-2.5 h-2.5 rounded-full\\\"\\n                    style={{ backgroundColor: currentBrand.primaryColor }}\\n                    title=\\\"Color de Marca\\\"\\n                  />\\n                  <span className=\\\"text-[10px] px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 font-medium\\\">\\n                    {currentBrand.industry}\\n                  </span>\\n                </div>\\n                <p className=\\\"text-[11px] text-slate-500 mt-0.5 italic font-serif\\\">\\\"{currentBrand.slogan}\\\"</p>\\n                <div className=\\\"text-[10px] text-slate-500 mt-0.5\\\">\\n                  Contacto: <span className=\\\"text-slate-700 font-medium\\\">{currentBrand.contactPerson}</span> ({currentBrand.contactEmail})\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Strict Territory Validation Badge */}\\n            <div\\n              className={`p-2.5 rounded-lg border max-w-sm text-xs ${\\n                validationStatus.isValid\\n                  ? \'bg-emerald-50 border-emerald-200 text-emerald-900\'\\n                  : \'bg-amber-50 border-amber-200 text-amber-900\'\\n              }`}\\n            >\\n              <div className=\\\"flex items-center gap-1.5 font-bold text-xs\\\">\\n                {validationStatus.isValid ? (\\n                  <ShieldCheck className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n                ) : (\\n                  <AlertTriangle className=\\\"w-4 h-4 text-amber-600 shrink-0\\\" />\\n                )}\\n                <span>Regla de Negocio: Min. 3 Territorios Activos</span>\\n              </div>\\n              <p className=\\\"text-[11px] text-slate-600 mt-0.5\\\">{validationStatus.message}</p>\\n            </div>\\n          </div>\\n\\n          {/* Sub-tabs: Territorios vs Activos */}\\n          <div className=\\\"flex items-center justify-between border-b border-slate-200 pb-2\\\">\\n            <div className=\\\"flex items-center gap-1.5 text-xs\\\">\\n              <button\\n                onClick={() => setActiveSubTab(\'territories\')}\\n                className={`flex items-center gap-1.5 px-3 py-1 rounded-md font-semibold transition-all cursor-pointer ${\\n                  activeSubTab === \'territories\'\\n                    ? \'bg-slate-900 text-white shadow-2xs\'\\n                    : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100\'\\n                }`}\\n              >\\n                <Layers className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Territorios ({brandTerritories.length})</span>\\n              </button>\\n\\n              <button\\n                onClick={() => setActiveSubTab(\'assets\')}\\n                className={`flex items-center gap-1.5 px-3 py-1 rounded-md font-semibold transition-all cursor-pointer ${\\n                  activeSubTab === \'assets\'\\n                    ? \'bg-slate-900 text-white shadow-2xs\'\\n                    : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100\'\\n                }`}\\n              >\\n                <Globe className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Activos Digitales ({brandAssets.length})</span>\\n              </button>\\n            </div>\\n\\n            {/* Action Buttons */}\\n            <div className=\\\"flex items-center gap-2\\\">\\n              {activeSubTab === \'territories\' ? (\\n                <>\\n                  <button\\n                    onClick={() =>\\n                      openAiModalWithContext({\\n                        action: \'ideate\',\\n                        brandId: currentBrand.id,\\n                      })\\n                    }\\n                    className=\\\"flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 text-xs font-semibold cursor-pointer\\\"\\n                  >\\n                    <Sparkles className=\\\"w-3.5 h-3.5 text-purple-600\\\" />\\n                    <span>Brainstorming IA</span>\\n                  </button>\\n\\n                  <button\\n                    onClick={() => openTerritoryModal()}\\n                    className=\\\"flex items-center gap-1.5 px-3 py-1 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-xs cursor-pointer\\\"\\n                  >\\n                    <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>Nuevo Territorio</span>\\n                  </button>\\n                </>\\n              ) : (\\n                <button\\n                  onClick={() => openAssetModal()}\\n                  className=\\\"flex items-center gap-1.5 px-3 py-1 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-xs cursor-pointer\\\"\\n                >\\n                  <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Registrar Activo</span>\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n\\n          {/* Tab 1: Territorios de Comunicaci\303\263n */}\\n          {activeSubTab === \'territories\' && (\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 pt-1\\\">\\n              {brandTerritories.map((territory) => (\\n                <div\\n                  key={territory.id}\\n                  className={`bg-slate-50/70 border rounded-lg p-3 space-y-2.5 relative group transition-all ${\\n                    territory.active\\n                      ? \'border-slate-200 hover:border-blue-400 bg-white shadow-2xs\'\\n                      : \'border-slate-200 opacity-60\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-start justify-between gap-2\\\">\\n                    <div className=\\\"flex items-center gap-1.5\\\">\\n                      <span\\n                        className=\\\"w-2.5 h-2.5 rounded-full shrink-0\\\"\\n                        style={{ backgroundColor: territory.colorTag || currentBrand.primaryColor }}\\n                      />\\n                      <h4 className=\\\"text-xs font-bold text-slate-900\\\">{territory.name}</h4>\\n                    </div>\\n\\n                    <div className=\\\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\\\">\\n                      <button\\n                        onClick={() => openTerritoryModal(territory)}\\n                        className=\\\"p-1 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded cursor-pointer\\\"\\n                        title=\\\"Editar\\\"\\n                      >\\n                        <Edit2 className=\\\"w-3 h-3\\\" />\\n                      </button>\\n                      <button\\n                        onClick={() => handleDeleteTerritory(territory.id)}\\n                        className=\\\"p-1 text-red-500 hover:text-red-700 hover:bg-red-50 rounded cursor-pointer\\\"\\n                        title=\\\"Eliminar\\\"\\n                      >\\n                        <Trash2 className=\\\"w-3 h-3\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n\\n                  <p className=\\\"text-[11px] text-slate-600 line-clamp-2 leading-relaxed\\\">\\n                    {territory.description}\\n                  </p>\\n\\n                  <div className=\\\"space-y-1 text-[11px] pt-1.5 border-t border-slate-100\\\">\\n                    <div>\\n                      <span className=\\\"font-semibold text-slate-700\\\">\360\237\216\257 Objetivo:</span>{\' \'}\\n                      <span className=\\\"text-slate-600\\\">{territory.objective}</span>\\n                    </div>\\n\\n                    <div>\\n                      <span className=\\\"font-semibold text-slate-700\\\">\360\237\221\245 Audiencia:</span>{\' \'}\\n                      <span className=\\\"text-slate-600\\\">{territory.targetAudience}</span>\\n                    </div>\\n                  </div>\\n\\n                  {/* Content Pillars */}\\n                  <div className=\\\"pt-1\\\">\\n                    <div className=\\\"text-[9px] uppercase font-bold text-slate-500 mb-1\\\">Pilares de Contenido</div>\\n                    <div className=\\\"flex flex-wrap gap-1\\\">\\n                      {territory.contentPillars.map((p, pIdx) => (\\n                        <span\\n                          key={pIdx}\\n                          className=\\\"text-[10px] px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200\\\"\\n                        >\\n                          {p}\\n                        </span>\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  {/* Status Indicator */}\\n                  <div className=\\\"flex items-center justify-between text-[10px] pt-1.5 border-t border-slate-100 text-slate-500 font-mono\\\">\\n                    <span>Estado:</span>\\n                    <span\\n                      className={`font-bold ${\\n                        territory.active ? \'text-emerald-700\' : \'text-slate-500\'\\n                      }`}\\n                    >\\n                      {territory.active ? \'ACTIVO\' : \'INACTIVO\'}\\n                    </span>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n\\n          {/* Tab 2: Activos Digitales de Marca */}\\n          {activeSubTab === \'assets\' && (\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-1\\\">\\n              {brandAssets.length === 0 ? (\\n                <div className=\\\"col-span-full py-8 text-center text-slate-500 text-xs border border-dashed border-slate-300 rounded-lg bg-slate-50\\\">\\n                  No hay activos digitales registrados para esta marca.\\n                </div>\\n              ) : (\\n                brandAssets.map((asset) => (\\n                  <div\\n                    key={asset.id}\\n                    className=\\\"bg-white border border-slate-200 hover:border-slate-300 rounded-lg p-3 space-y-2 relative group shadow-2xs\\\"\\n                  >\\n                    <div className=\\\"flex items-start justify-between gap-2\\\">\\n                      <div className=\\\"flex items-center gap-2\\\">\\n                        <div className=\\\"w-7 h-7 rounded-md bg-slate-50 flex items-center justify-center border border-slate-200\\\">\\n                          {getAssetIcon(asset.type)}\\n                        </div>\\n                        <div>\\n                          <h4 className=\\\"text-xs font-bold text-slate-900\\\">{asset.name}</h4>\\n                          <span className=\\\"text-[9px] uppercase font-semibold text-slate-500\\\">\\n                            {asset.type.replace(\'_\', \' \')}\\n                          </span>\\n                        </div>\\n                      </div>\\n\\n                      <div className=\\\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\\\">\\n                        <button\\n                          onClick={() => openAssetModal(asset)}\\n                          className=\\\"p-1 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded cursor-pointer\\\"\\n                        >\\n                          <Edit2 className=\\\"w-3 h-3\\\" />\\n                        </button>\\n                        <button\\n                          onClick={() => deleteDigitalAsset(asset.id)}\\n                          className=\\\"p-1 text-red-500 hover:text-red-700 hover:bg-red-50 rounded cursor-pointer\\\"\\n                        >\\n                          <Trash2 className=\\\"w-3 h-3\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n\\n                    {asset.notes && (\\n                      <p className=\\\"text-[11px] text-slate-600 line-clamp-2 leading-relaxed\\\">\\n                        {asset.notes}\\n                      </p>\\n                    )}\\n\\n                    <div className=\\\"pt-1.5 border-t border-slate-100 flex items-center justify-between\\\">\\n                      <a\\n                        href={asset.url}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noreferrer\\\"\\n                        className=\\\"inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-700 font-medium truncate max-w-[180px]\\\"\\n                      >\\n                        <span className=\\\"truncate\\\">{asset.url}</span>\\n                        <ExternalLink className=\\\"w-3 h-3 shrink-0\\\" />\\n                      </a>\\n                      <span className=\\\"text-[10px] font-mono text-slate-500\\\">{asset.updatedAt}</span>\\n                    </div>\\n                  </div>\\n                ))\\n              )}\\n            </div>\\n          )}\\n\\n        </div>\\n      )}\\n\\n      {/* Modal: Crear / Editar Territorio */}\\n      {isTerritoryModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-white border border-slate-200 rounded-xl max-w-lg w-full p-5 shadow-2xl space-y-3.5 animate-in fade-in zoom-in-95 text-slate-800\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-slate-100 pb-2.5\\\">\\n              <h3 className=\\\"text-sm font-bold text-slate-900\\\">\\n                {editingTerritory ? \'Editar Territorio de Comunicaci\303\263n\' : \'Nuevo Territorio de Comunicaci\303\263n\'}\\n              </h3>\\n              <button\\n                onClick={() => setIsTerritoryModalOpen(false)}\\n                className=\\\"text-slate-400 hover:text-slate-700 text-sm font-bold p-1 cursor-pointer\\\"\\n              >\\n                \342\234\225\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleTerritorySubmit} className=\\\"space-y-3 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Nombre del Territorio *</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrName}\\n                  onChange={(e) => setTerrName(e.target.value)}\\n                  placeholder=\\\"Ej: Rendimiento Extremo & Atletas Pro\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                  required\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Descripci\303\263n del Territorio</label>\\n                <textarea\\n                  value={terrDescription}\\n                  onChange={(e) => setTerrDescription(e.target.value)}\\n                  rows={2}\\n                  placeholder=\\\"Describe la tem\303\241tica general, arquetipo de marca y narrativa...\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Objetivo Estrat\303\251gico</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrObjective}\\n                  onChange={(e) => setTerrObjective(e.target.value)}\\n                  placeholder=\\\"Ej: Posicionar la marca en segmento premium y generar conversi\303\263n\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">\\n                  Pilares de Contenido (Separados por coma)\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrPillars}\\n                  onChange={(e) => setTerrPillars(e.target.value)}\\n                  placeholder=\\\"Ej: Rutinas Pro, Biometr\303\255a y Fisiolog\303\255a, Entrevistas a Embajadores\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Audiencia Objetivo (Buyer Persona)</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrAudience}\\n                  onChange={(e) => setTerrAudience(e.target.value)}\\n                  placeholder=\\\"Ej: Marat\303\263nicos, deportistas y j\303\263venes profesionales de 25-40 a\303\261os\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-2 pt-1\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  id=\\\"terrActiveCheck\\\"\\n                  checked={terrActive}\\n                  onChange={(e) => setTerrActive(e.target.checked)}\\n                  className=\\\"rounded border-slate-300 text-blue-600 focus:ring-blue-500\\\"\\n                />\\n                <label htmlFor=\\\"terrActiveCheck\\\" className=\\\"text-slate-700 font-medium cursor-pointer text-xs\\\">\\n                  Territorio Activo (Aporta al cumplimiento del m\303\255nimo de 3)\\n                </label>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-end gap-2 pt-3 border-t border-slate-100\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsTerritoryModalOpen(false)}\\n                  className=\\\"px-3 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold cursor-pointer\\\"\\n                >\\n                  Cancelar\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-xs cursor-pointer\\\"\\n                >\\n                  {editingTerritory ? \'Guardar Cambios\' : \'Crear Territorio\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Modal: Crear / Editar Activo Digital */}\\n      {isAssetModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-white border border-slate-200 rounded-xl max-w-md w-full p-5 shadow-2xl space-y-3.5 animate-in fade-in zoom-in-95 text-slate-800\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-slate-100 pb-2.5\\\">\\n              <h3 className=\\\"text-sm font-bold text-slate-900\\\">\\n                {editingAsset ? \'Editar Activo Digital\' : \'Registrar Activo Digital\'}\\n              </h3>\\n              <button\\n                onClick={() => setIsAssetModalOpen(false)}\\n                className=\\\"text-slate-400 hover:text-slate-700 text-sm font-bold p-1 cursor-pointer\\\"\\n              >\\n                \342\234\225\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleAssetSubmit} className=\\\"space-y-3 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Nombre del Activo *</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={assetName}\\n                  onChange={(e) => setAssetName(e.target.value)}\\n                  placeholder=\\\"Ej: Portal Web Oficial & E-commerce\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                  required\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Tipo de Activo *</label>\\n                <select\\n                  value={assetType}\\n                  onChange={(e) => setAssetType(e.target.value as AssetType)}\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white cursor-pointer\\\"\\n                >\\n                  <option value=\\\"website\\\">Sitio Web / E-Commerce</option>\\n                  <option value=\\\"mobile_app\\\">Aplicaci\303\263n M\303\263vil (iOS / Android)</option>\\n                  <option value=\\\"landing_page\\\">Landing Page de Campa\303\261a</option>\\n                  <option value=\\\"brand_guidelines\\\">Manual de Identidad & Gu\303\255a de Marca</option>\\n                  <option value=\\\"catalog\\\">Cat\303\241logo de Productos PDF / Digital</option>\\n                  <option value=\\\"media_kit\\\">Media Kit & Recursos de Prensa</option>\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">URL / Enlace del Activo *</label>\\n                <input\\n                  type=\\\"url\\\"\\n                  value={assetUrl}\\n                  onChange={(e) => setAssetUrl(e.target.value)}\\n                  placeholder=\\\"https://ejemplo.com/recurso\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                  required\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-700 font-semibold mb-1\\\">Notas T\303\251cnicas / Credenciales</label>\\n                <textarea\\n                  value={assetNotes}\\n                  onChange={(e) => setAssetNotes(e.target.value)}\\n                  rows={2}\\n                  placeholder=\\\"Detalles sobre tecnolog\303\255a, accesos o lineamientos...\\\"\\n                  className=\\\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-end gap-2 pt-3 border-t border-slate-100\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsAssetModalOpen(false)}\\n                  className=\\\"px-3 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold cursor-pointer\\\"\\n                >\\n                  Cancelar\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-xs cursor-pointer\\\"\\n                >\\n                  {editingAsset ? \'Actualizar Activo\' : \'Registrar Activo\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n    </div>\\n  );\", \"TargetContent\":\"  const getAssetIcon = (type: AssetType) => {\\n    switch (type) {\\n      case \'website\':\\n      case \'landing_page\':\\n        return <Globe className=\\\"w-4 h-4 text-blue-400\\\" />;\\n      case \'mobile_app\':\\n        return <Smartphone className=\\\"w-4 h-4 text-purple-400\\\" />;\\n      case \'brand_guidelines\':\\n      case \'catalog\':\\n        return <BookOpen className=\\\"w-4 h-4 text-amber-400\\\" />;\\n      case \'media_kit\':\\n      case \'social_channel\':\\n        return <FileText className=\\\"w-4 h-4 text-emerald-400\\\" />;\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      \\n      {/* Brand Horizontal Carousel / Selector */}\\n      <div className=\\\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3\\\">\\n        {brands.map((brand) => {\\n          const isSelected = brand.id === currentBrand?.id;\\n          const terrStatus = validateBrandTerritories(brand.id);\\n\\n          return (\\n            <button\\n              key={brand.id}\\n              onClick={() => setActiveBrandId(brand.id)}\\n              className={`p-3 rounded-xl border text-left transition-all relative overflow-hidden flex flex-col justify-between ${\\n                isSelected\\n                  ? \'bg-zinc-900 border-indigo-500 ring-1 ring-indigo-500/50 shadow-lg shadow-indigo-500/10\'\\n                  : \'bg-zinc-900/50 border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900/80\'\\n              }`}\\n            >\\n              {/* Brand Color Header line */}\\n              <div\\n                className=\\\"absolute top-0 left-0 right-0 h-1\\\"\\n                style={{ backgroundColor: brand.primaryColor }}\\n              />\\n\\n              <div className=\\\"flex items-center gap-2 mb-2\\\">\\n                <img\\n                  src={brand.logo}\\n                  alt={brand.name}\\n                  className=\\\"w-7 h-7 rounded-lg object-cover ring-1 ring-zinc-700\\\"\\n                />\\n                <span className=\\\"font-bold text-xs text-zinc-100 truncate\\\">{brand.name}</span>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between text-[10px] text-zinc-400 pt-1 border-t border-zinc-800/60\\\">\\n                <span>{terrStatus.activeCount} Territorios</span>\\n                {terrStatus.isValid ? (\\n                  <CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n                ) : (\\n                  <AlertTriangle className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                )}\\n              </div>\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {/* Current Brand Active Header */}\\n      {currentBrand && (\\n        <div className=\\\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 shadow-xl space-y-5\\\">\\n          \\n          <div className=\\\"flex flex-wrap items-start justify-between gap-4\\\">\\n            <div className=\\\"flex items-center gap-4\\\">\\n              <img\\n                src={currentBrand.logo}\\n                alt={currentBrand.name}\\n                className=\\\"w-14 h-14 rounded-2xl object-cover ring-2 ring-zinc-700 shadow-md\\\"\\n              />\\n              <div>\\n                <div className=\\\"flex items-center gap-2.5\\\">\\n                  <h2 className=\\\"text-xl font-bold text-white\\\">{currentBrand.name}</h2>\\n                  <span\\n                    className=\\\"w-3 h-3 rounded-full\\\"\\n                    style={{ backgroundColor: currentBrand.primaryColor }}\\n                    title=\\\"Color de Marca\\\"\\n                  />\\n                  <span className=\\\"text-xs px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700\\\">\\n                    {currentBrand.industry}\\n                  </span>\\n                </div>\\n                <p className=\\\"text-xs text-zinc-400 mt-0.5 italic\\\">\\\"{currentBrand.slogan}\\\"</p>\\n                <div className=\\\"text-[11px] text-zinc-500 mt-1\\\">\\n                  Contacto: {currentBrand.contactPerson} ({currentBrand.contactEmail})\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Strict Territory Validation Badge */}\\n            <div\\n              className={`p-3 rounded-xl border max-w-sm text-xs ${\\n                validationStatus.isValid\\n                  ? \'bg-emerald-500/10 border-emerald-500/30 text-emerald-300\'\\n                  : \'bg-amber-500/15 border-amber-500/40 text-amber-300\'\\n              }`}\\n            >\\n              <div className=\\\"flex items-center gap-2 font-semibold\\\">\\n                {validationStatus.isValid ? (\\n                  <ShieldCheck className=\\\"w-4 h-4 text-emerald-400 shrink-0\\\" />\\n                ) : (\\n                  <AlertTriangle className=\\\"w-4 h-4 text-amber-400 shrink-0\\\" />\\n                )}\\n                <span>Regla de Negocio: Min. 3 Territorios Activos</span>\\n              </div>\\n              <p className=\\\"text-[11px] text-zinc-400 mt-1\\\">{validationStatus.message}</p>\\n            </div>\\n          </div>\\n\\n          {/* Sub-tabs: Territorios vs Activos */}\\n          <div className=\\\"flex items-center justify-between border-b border-zinc-800 pb-2\\\">\\n            <div className=\\\"flex items-center gap-2 text-xs\\\">\\n              <button\\n                onClick={() => setActiveSubTab(\'territories\')}\\n                className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg font-semibold transition-all ${\\n                  activeSubTab === \'territories\'\\n                    ? \'bg-indigo-600 text-white shadow-sm\'\\n                    : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800\'\\n                }`}\\n              >\\n                <Layers className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Territorios de Comunicaci\303\263n ({brandTerritories.length})</span>\\n              </button>\\n\\n              <button\\n                onClick={() => setActiveSubTab(\'assets\')}\\n                className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg font-semibold transition-all ${\\n                  activeSubTab === \'assets\'\\n                    ? \'bg-indigo-600 text-white shadow-sm\'\\n                    : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800\'\\n                }`}\\n              >\\n                <Globe className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Activos Digitales Registrados ({brandAssets.length})</span>\\n              </button>\\n            </div>\\n\\n            {/* Action Buttons */}\\n            <div className=\\\"flex items-center gap-2\\\">\\n              {activeSubTab === \'territories\' ? (\\n                <>\\n                  <button\\n                    onClick={() =>\\n                      openAiModalWithContext({\\n                        action: \'ideate\',\\n                        brandId: currentBrand.id,\\n                      })\\n                    }\\n                    className=\\\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-950/60 hover:bg-purple-900 border border-purple-500/30 text-purple-300 text-xs font-medium\\\"\\n                  >\\n                    <Sparkles className=\\\"w-3.5 h-3.5 text-purple-400\\\" />\\n                    <span>Brainstorming IA</span>\\n                  </button>\\n\\n                  <button\\n                    onClick={() => openTerritoryModal()}\\n                    className=\\\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-md\\\"\\n                  >\\n                    <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>Nuevo Territorio</span>\\n                  </button>\\n                </>\\n              ) : (\\n                <button\\n                  onClick={() => openAssetModal()}\\n                  className=\\\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-md\\\"\\n                >\\n                  <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Registrar Activo Digital</span>\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n\\n          {/* Tab 1: Territorios de Comunicaci\303\263n */}\\n          {activeSubTab === \'territories\' && (\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-2\\\">\\n              {brandTerritories.map((territory) => (\\n                <div\\n                  key={territory.id}\\n                  className={`bg-zinc-950/80 border rounded-xl p-4 space-y-3 relative group transition-all ${\\n                    territory.active\\n                      ? \'border-zinc-800 hover:border-zinc-700 shadow-md\'\\n                      : \'border-zinc-900 opacity-60\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-start justify-between gap-2\\\">\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <span\\n                        className=\\\"w-2.5 h-2.5 rounded-full shrink-0\\\"\\n                        style={{ backgroundColor: territory.colorTag || currentBrand.primaryColor }}\\n                      />\\n                      <h4 className=\\\"text-sm font-bold text-zinc-100\\\">{territory.name}</h4>\\n                    </div>\\n\\n                    <div className=\\\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\\\">\\n                      <button\\n                        onClick={() => openTerritoryModal(territory)}\\n                        className=\\\"p-1 text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 rounded\\\"\\n                        title=\\\"Editar\\\"\\n                      >\\n                        <Edit2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                      <button\\n                        onClick={() => handleDeleteTerritory(territory.id)}\\n                        className=\\\"p-1 text-red-400 hover:text-red-300 hover:bg-red-950/40 rounded\\\"\\n                        title=\\\"Eliminar\\\"\\n                      >\\n                        <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n\\n                  <p className=\\\"text-xs text-zinc-400 line-clamp-2 leading-relaxed\\\">\\n                    {territory.description}\\n                  </p>\\n\\n                  <div className=\\\"space-y-1.5 text-[11px] pt-2 border-t border-zinc-900\\\">\\n                    <div>\\n                      <span className=\\\"font-semibold text-zinc-300\\\">\360\237\216\257 Objetivo:</span>{\' \'}\\n                      <span className=\\\"text-zinc-400\\\">{territory.objective}</span>\\n                    </div>\\n\\n                    <div>\\n                      <span className=\\\"font-semibold text-zinc-300\\\">\360\237\221\245 Audiencia:</span>{\' \'}\\n                      <span className=\\\"text-zinc-400\\\">{territory.targetAudience}</span>\\n                    </div>\\n                  </div>\\n\\n                  {/* Content Pillars */}\\n                  <div className=\\\"pt-2\\\">\\n                    <div className=\\\"text-[10px] uppercase font-bold text-zinc-500 mb-1\\\">Pilares de Contenido</div>\\n                    <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                      {territory.contentPillars.map((p, pIdx) => (\\n                        <span\\n                          key={pIdx}\\n                          className=\\\"text-[10px] px-2 py-0.5 rounded bg-zinc-900 text-zinc-300 border border-zinc-800\\\"\\n                        >\\n                          {p}\\n                        </span>\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  {/* Status Indicator */}\\n                  <div className=\\\"flex items-center justify-between text-[10px] pt-2 border-t border-zinc-900 text-zinc-500 font-mono\\\">\\n                    <span>Estado:</span>\\n                    <span\\n                      className={`font-semibold ${\\n                        territory.active ? \'text-emerald-400\' : \'text-zinc-500\'\\n                      }`}\\n                    >\\n                      {territory.active ? \'ACTIVO\' : \'INACTIVO\'}\\n                    </span>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n\\n          {/* Tab 2: Activos Digitales de Marca */}\\n          {activeSubTab === \'assets\' && (\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-2\\\">\\n              {brandAssets.length === 0 ? (\\n                <div className=\\\"col-span-full py-12 text-center text-zinc-500 text-xs border border-dashed border-zinc-800 rounded-xl\\\">\\n                  No hay activos digitales registrados para esta marca.\\n                </div>\\n              ) : (\\n                brandAssets.map((asset) => (\\n                  <div\\n                    key={asset.id}\\n                    className=\\\"bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 rounded-xl p-4 space-y-3 relative group shadow-md\\\"\\n                  >\\n                    <div className=\\\"flex items-start justify-between gap-2\\\">\\n                      <div className=\\\"flex items-center gap-2.5\\\">\\n                        <div className=\\\"w-8 h-8 rounded-lg bg-zinc-900 flex items-center justify-center border border-zinc-800\\\">\\n                          {getAssetIcon(asset.type)}\\n                        </div>\\n                        <div>\\n                          <h4 className=\\\"text-xs font-bold text-zinc-100\\\">{asset.name}</h4>\\n                          <span className=\\\"text-[10px] uppercase font-semibold text-zinc-500\\\">\\n                            {asset.type.replace(\'_\', \' \')}\\n                          </span>\\n                        </div>\\n                      </div>\\n\\n                      <div className=\\\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\\\">\\n                        <button\\n                          onClick={() => openAssetModal(asset)}\\n                          className=\\\"p-1 text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 rounded\\\"\\n                        >\\n                          <Edit2 className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          onClick={() => deleteDigitalAsset(asset.id)}\\n                          className=\\\"p-1 text-red-400 hover:text-red-300 hover:bg-red-950/40 rounded\\\"\\n                        >\\n                          <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n\\n                    {asset.notes && (\\n                      <p className=\\\"text-[11px] text-zinc-400 line-clamp-2 leading-relaxed\\\">\\n                        {asset.notes}\\n                      </p>\\n                    )}\\n\\n                    <div className=\\\"pt-2 border-t border-zinc-900 flex items-center justify-between\\\">\\n                      <a\\n                        href={asset.url}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noreferrer\\\"\\n                        className=\\\"inline-flex items-center gap-1 text-xs text-indigo-400 hover:text-indigo-300 font-medium truncate max-w-[200px]\\\"\\n                      >\\n                        <span className=\\\"truncate\\\">{asset.url}</span>\\n                        <ExternalLink className=\\\"w-3 h-3 shrink-0\\\" />\\n                      </a>\\n                      <span className=\\\"text-[10px] font-mono text-zinc-500\\\">{asset.updatedAt}</span>\\n                    </div>\\n                  </div>\\n                ))\\n              )}\\n            </div>\\n          )}\\n\\n        </div>\\n      )}\\n\\n      {/* Modal: Crear / Editar Territorio */}\\n      {isTerritoryModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-xl w-full p-6 shadow-2xl space-y-4 animate-in fade-in zoom-in-95\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-zinc-800 pb-3\\\">\\n              <h3 className=\\\"text-base font-bold text-white\\\">\\n                {editingTerritory ? \'Editar Territorio de Comunicaci\303\263n\' : \'Nuevo Territorio de Comunicaci\303\263n\'}\\n              </h3>\\n              <button\\n                onClick={() => setIsTerritoryModalOpen(false)}\\n                className=\\\"text-zinc-500 hover:text-zinc-300 text-sm font-semibold p-1\\\"\\n              >\\n                \342\234\225\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleTerritorySubmit} className=\\\"space-y-4 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Nombre del Territorio *</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrName}\\n                  onChange={(e) => setTerrName(e.target.value)}\\n                  placeholder=\\\"Ej: Rendimiento Extremo & Atletas Pro\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs focus:ring-1 focus:ring-indigo-500\\\"\\n                  required\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Descripci\303\263n del Territorio</label>\\n                <textarea\\n                  value={terrDescription}\\n                  onChange={(e) => setTerrDescription(e.target.value)}\\n                  rows={2}\\n                  placeholder=\\\"Describe la tem\303\241tica general, arquetipo de marca y narrativa...\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Objetivo Estrat\303\251gico</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrObjective}\\n                  onChange={(e) => setTerrObjective(e.target.value)}\\n                  placeholder=\\\"Ej: Posicionar la marca en segmento premium y generar conversi\303\263n\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">\\n                  Pilares de Contenido (Separados por coma)\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrPillars}\\n                  onChange={(e) => setTerrPillars(e.target.value)}\\n                  placeholder=\\\"Ej: Rutinas Pro, Biometr\303\255a y Fisiolog\303\255a, Entrevistas a Embajadores\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Audiencia Objetivo (Buyer Persona)</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={terrAudience}\\n                  onChange={(e) => setTerrAudience(e.target.value)}\\n                  placeholder=\\\"Ej: Marat\303\263nicos, deportistas y j\303\263venes profesionales de 25-40 a\303\261os\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-2 pt-2\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  id=\\\"terrActiveCheck\\\"\\n                  checked={terrActive}\\n                  onChange={(e) => setTerrActive(e.target.checked)}\\n                  className=\\\"rounded border-zinc-800 text-indigo-600 focus:ring-indigo-500\\\"\\n                />\\n                <label htmlFor=\\\"terrActiveCheck\\\" className=\\\"text-zinc-300 font-medium cursor-pointer\\\">\\n                  Territorio Activo (Aporta al cumplimiento del m\303\255nimo de 3)\\n                </label>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-end gap-3 pt-4 border-t border-zinc-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsTerritoryModalOpen(false)}\\n                  className=\\\"px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300\\\"\\n                >\\n                  Cancelar\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-md\\\"\\n                >\\n                  {editingTerritory ? \'Guardar Cambios\' : \'Crear Territorio\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Modal: Crear / Editar Activo Digital */}\\n      {isAssetModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4 animate-in fade-in zoom-in-95\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-zinc-800 pb-3\\\">\\n              <h3 className=\\\"text-base font-bold text-white\\\">\\n                {editingAsset ? \'Editar Activo Digital\' : \'Registrar Activo Digital\'}\\n              </h3>\\n              <button\\n                onClick={() => setIsAssetModalOpen(false)}\\n                className=\\\"text-zinc-500 hover:text-zinc-300 text-sm font-semibold p-1\\\"\\n              >\\n                \342\234\225\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleAssetSubmit} className=\\\"space-y-4 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Nombre del Activo *</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={assetName}\\n                  onChange={(e) => setAssetName(e.target.value)}\\n                  placeholder=\\\"Ej: Portal Web Oficial & E-commerce\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                  required\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Tipo de Activo *</label>\\n                <select\\n                  value={assetType}\\n                  onChange={(e) => setAssetType(e.target.value as AssetType)}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                >\\n                  <option value=\\\"website\\\">Sitio Web / E-Commerce</option>\\n                  <option value=\\\"mobile_app\\\">Aplicaci\303\263n M\303\263vil (iOS / Android)</option>\\n                  <option value=\\\"landing_page\\\">Landing Page de Campa\303\261a</option>\\n                  <option value=\\\"brand_guidelines\\\">Manual de Identidad & Gu\303\255a de Marca</option>\\n                  <option value=\\\"catalog\\\">Cat\303\241logo de Productos PDF / Digital</option>\\n                  <option value=\\\"media_kit\\\">Media Kit & Recursos de Prensa</option>\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">URL / Enlace del Activo *</label>\\n                <input\\n                  type=\\\"url\\\"\\n                  value={assetUrl}\\n                  onChange={(e) => setAssetUrl(e.target.value)}\\n                  placeholder=\\\"https://ejemplo.com/recurso\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                  required\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-300 font-medium mb-1\\\">Notas T\303\251cnicas / Credenciales</label>\\n                <textarea\\n                  value={assetNotes}\\n                  onChange={(e) => setAssetNotes(e.target.value)}\\n                  rows={2}\\n                  placeholder=\\\"Detalles sobre tecnolog\303\255a, accesos o lineamientos...\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-end gap-3 pt-4 border-t border-zinc-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsAssetModalOpen(false)}\\n                  className=\\\"px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300\\\"\\n                >\\n                  Cancelar\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-md\\\"\\n                >\\n                  {editingAsset ? \'Actualizar Activo\' : \'Registrar Activo\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n    </div>\\n  );\", \"TargetFile\":\"/src/components/BrandTerritoryManager.tsx\", \"toolAction\":\"Editing BrandTerritoryManager.tsx\", \"toolSummary\":\"Editing BrandTerritoryManager.tsx\"}"
      thought_signature: ""
      original_name: "edit_file"
    }
