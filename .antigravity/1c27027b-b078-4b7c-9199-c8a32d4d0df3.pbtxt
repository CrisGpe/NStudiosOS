    content: "import React from \'react\';\nimport { AppProvider, useApp } from \'./context/AppContext\';\nimport { Navbar } from \'./components/Navbar\';\nimport { KanbanBoard } from \'./components/KanbanBoard\';\nimport { DualCalendar } from \'./components/DualCalendar\';\nimport { BrandTerritoryManager } from \'./components/BrandTerritoryManager\';\nimport { EquipmentManager } from \'./components/EquipmentManager\';\nimport { SystemSpecsHub } from \'./components/SystemSpecsHub\';\nimport { WebAdminDashboard } from \'./components/WebAdminDashboard\';\nimport { DeliverableDetailModal } from \'./components/DeliverableDetailModal\';\nimport { AICopilotModal } from \'./components/AICopilotModal\';\n\nconst AppContent: React.FC = () => {\n  const { activeTab } = useApp();\n\n  return (\n    <div className=\"min-h-screen bg-zinc-950 text-zinc-100 flex flex-col selection:bg-indigo-500 selection:text-white\">\n      {/* Top Navigation Bar with Role Simulator & Brand Select */}\n      <Navbar />\n\n      {/* Main Tabbed Viewport */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {activeTab === \'kanban\' && <KanbanBoard />}\n        {activeTab === \'calendar\' && <DualCalendar />}\n        {activeTab === \'brands\' && <BrandTerritoryManager />}\n        {activeTab === \'equipment\' && <EquipmentManager />}\n        {activeTab === \'specs\' && <SystemSpecsHub />}\n        {activeTab === \'admin\' && <WebAdminDashboard />}\n      </main>\n\n      {/* Global Deliverable Inspector Modal */}\n      <DeliverableDetailModal />\n\n      {/* Global AI Copilot Modal */}\n      <AICopilotModal />\n\n      {/* Footer */}\n      <footer className=\"border-t border-zinc-800/60 py-4 bg-zinc-950 text-center text-xs text-zinc-500\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-wrap items-center justify-between gap-2\">\n          <span>CineFlow Studio OS \342\200\224 Sistema Integral de Gesti\303\263n Audiovisual & RBAC</span>\n          <span className=\"font-mono text-[11px] text-zinc-600\">\n            Node.js + Express + React 19 + Tailwind v4 + Gemini 3.7 Flash\n          </span>\n        </div>\n      </footer>\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <AppProvider>\n      <AppContent />\n    </AppProvider>\n  );\n}\n"
    raw_content: "import React from \'react\';\nimport { AppProvider, useApp } from \'./context/AppContext\';\nimport { Navbar } from \'./components/Navbar\';\nimport { KanbanBoard } from \'./components/KanbanBoard\';\nimport { DualCalendar } from \'./components/DualCalendar\';\nimport { BrandTerritoryManager } from \'./components/BrandTerritoryManager\';\nimport { EquipmentManager } from \'./components/EquipmentManager\';\nimport { SystemSpecsHub } from \'./components/SystemSpecsHub\';\nimport { WebAdminDashboard } from \'./components/WebAdminDashboard\';\nimport { DeliverableDetailModal } from \'./components/DeliverableDetailModal\';\nimport { AICopilotModal } from \'./components/AICopilotModal\';\n\nconst AppContent: React.FC = () => {\n  const { activeTab } = useApp();\n\n  return (\n    <div className=\"min-h-screen bg-zinc-950 text-zinc-100 flex flex-col selection:bg-indigo-500 selection:text-white\">\n      {/* Top Navigation Bar with Role Simulator & Brand Select */}\n      <Navbar />\n\n      {/* Main Tabbed Viewport */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {activeTab === \'kanban\' && <KanbanBoard />}\n        {activeTab === \'calendar\' && <DualCalendar />}\n        {activeTab === \'brands\' && <BrandTerritoryManager />}\n        {activeTab === \'equipment\' && <EquipmentManager />}\n        {activeTab === \'specs\' && <SystemSpecsHub />}\n        {activeTab === \'admin\' && <WebAdminDashboard />}\n      </main>\n\n      {/* Global Deliverable Inspector Modal */}\n      <DeliverableDetailModal />\n\n      {/* Global AI Copilot Modal */}\n      <AICopilotModal />\n\n      {/* Footer */}\n      <footer className=\"border-t border-zinc-800/60 py-4 bg-zinc-950 text-center text-xs text-zinc-500\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-wrap items-center justify-between gap-2\">\n          <span>CineFlow Studio OS \342\200\224 Sistema Integral de Gesti\303\263n Audiovisual & RBAC</span>\n          <span className=\"font-mono text-[11px] text-zinc-600\">\n            Node.js + Express + React 19 + Tailwind v4 + Gemini 3.7 Flash\n          </span>\n        </div>\n      </footer>\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <AppProvider>\n      <AppContent />\n    </AppProvider>\n  );\n}\n"
