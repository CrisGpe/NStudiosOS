    instruction: "Apply High Density styling to EquipmentManager component"
    replacement_infos {
      original_chunk {
        target_content: "  const getStatusBadge = (status: EquipmentStatus) => {\n    switch (status) {\n      case \'available\':\n        return {\n          label: \'Disponible\',\n          className: \'bg-emerald-500/10 text-emerald-400 border-emerald-500/30\',\n        };\n      case \'reserved\':\n        return {\n          label: \'Reservado\',\n          className: \'bg-amber-500/10 text-amber-400 border-amber-500/30\',\n        };\n      case \'in_shoot\':\n        return {\n          label: \'En Rodaje Activo\',\n          className: \'bg-rose-500/10 text-rose-400 border-rose-500/30\',\n        };\n      case \'maintenance\':\n        return {\n          label: \'Mantenimiento / Calibraci\303\263n\',\n          className: \'bg-zinc-500/10 text-zinc-400 border-zinc-500/30\',\n        };\n    }\n  };\n\n  const openBookingModal = (eq: HardwareEquipment) => {\n    setTargetEquipment(eq);\n    setBookStartDate(\'2026-08-25\');\n    setBookEndDate(\'2026-08-27\');\n    setBookNotes(\'\');\n    setCollisionWarning(null);\n    setIsBookModalOpen(true);\n  };\n\n  const handleDateChange = (start: string, end: string) => {\n    setBookStartDate(start);\n    setBookEndDate(end);\n    if (targetEquipment && start && end) {\n      const collision = checkEquipmentCollision(targetEquipment.id, start, end);\n      if (collision.hasCollision) {\n        setCollisionWarning(\n          `\302\241ALERTA DE COLISI\303\223N! Ya existe una reserva para \'${collision.collidingWith?.deliverableTitle}\' del ${collision.collidingWith?.startDate} al ${collision.collidingWith?.endDate}.`\n        );\n      } else {\n        setCollisionWarning(null);\n      }\n    }\n  };\n\n  const handleBookingSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!targetEquipment) return;\n\n    const chosenDel = deliverables.find((d) => d.id === selectedDeliverableId) || deliverables[0];\n    const brand = brands.find((b) => b.id === chosenDel.brandId);\n\n    const res = createEquipmentReservation({\n      equipmentId: targetEquipment.id,\n      deliverableId: chosenDel.id,\n      deliverableTitle: chosenDel.title,\n      brandName: brand?.name || \'Marca\',\n      startDate: bookStartDate,\n      endDate: bookEndDate,\n      reservedById: currentUser.id,\n      reservedByName: currentUser.name,\n      notes: bookNotes,\n    });\n\n    if (!res.success) {\n      alert(res.error);\n      return;\n    }\n\n    setIsBookModalOpen(false);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header & Stats */}\n      <div className=\"bg-zinc-900/70 border border-zinc-800 rounded-2xl p-6 shadow-xl flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shadow-md\">\n            <Camera className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <h2 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <span>Inventario Audiovisual & Motor de Reservas</span>\n              <span className=\"text-xs font-mono font-normal px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700\">\n                Detecci\303\263n de Colisiones Activa\n              </span>\n            </h2>\n            <p className=\"text-xs text-zinc-400\">\n              Hardware profesional cinematogr\303\241fico, \303\263pticas, audio 32-bit float, iluminaci\303\263n y estaciones de render.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-4 text-xs font-mono\">\n          <div className=\"bg-zinc-950 px-3 py-2 rounded-xl border border-zinc-800 text-center\">\n            <div className=\"text-zinc-500 text-[10px] uppercase\">Total Equipos</div>\n            <div className=\"text-base font-bold text-zinc-200\">{equipment.length}</div>\n          </div>\n          <div className=\"bg-zinc-950 px-3 py-2 rounded-xl border border-zinc-800 text-center\">\n            <div className=\"text-zinc-500 text-[10px] uppercase\">En Rodaje / Reservados</div>\n            <div className=\"text-base font-bold text-amber-400\">\n              {equipment.filter((e) => e.status !== \'available\').length}\n            </div>\n          </div>\n          <div className=\"bg-zinc-950 px-3 py-2 rounded-xl border border-zinc-800 text-center\">\n            <div className=\"text-zinc-500 text-[10px] uppercase\">Disponibles</div>\n            <div className=\"text-base font-bold text-emerald-400\">\n              {equipment.filter((e) => e.status === \'available\').length}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Filters Bar */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex flex-wrap items-center gap-3\">\n          \n          <div className=\"relative min-w-[240px]\">\n            <Search className=\"w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input\n              type=\"text\"\n              value={equipmentSearch}\n              onChange={(e) => setEquipmentSearch(e.target.value)}\n              placeholder=\"Buscar modelo, \303\263ptica, serial...\"\n              className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-zinc-200 focus:ring-1 focus:ring-amber-500\"\n            />\n          </div>\n\n          <select\n            value={selectedCategory}\n            onChange={(e) => setSelectedCategory(e.target.value)}\n            className=\"bg-zinc-950 border border-zinc-800 text-xs text-zinc-300 rounded-lg px-3 py-1.5 focus:ring-1 focus:ring-amber-500\"\n          >\n            {categories.map((c) => (\n              <option key={c.id} value={c.id}>\n                {c.name}\n              </option>\n            ))}\n          </select>\n\n          <select\n            value={selectedStatus}\n            onChange={(e) => setSelectedStatus(e.target.value)}\n            className=\"bg-zinc-950 border border-zinc-800 text-xs text-zinc-300 rounded-lg px-3 py-1.5 focus:ring-1 focus:ring-amber-500\"\n          >\n            <option value=\"all\">Todos los Estados</option>\n            <option value=\"available\">Disponibles</option>\n            <option value=\"reserved\">Reservados</option>\n            <option value=\"in_shoot\">En Rodaje</option>\n            <option value=\"maintenance\">Mantenimiento</option>\n          </select>\n        </div>\n\n        <span className=\"text-xs text-zinc-500 font-mono\">\n          {filteredEquipment.length} dispositivos mostrados\n        </span>\n      </div>\n\n      {/* Equipment Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {filteredEquipment.map((eq) => {\n          const statusBadge = getStatusBadge(eq.status);\n          const activeBookings = reservations.filter((r) => r.equipmentId === eq.id && r.status === \'confirmed\');\n\n          return (\n            <div\n              key={eq.id}\n              className=\"bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700 rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between group transition-all\"\n            >\n              <div>\n                {/* Equipment Image with Category Overlay */}\n                <div className=\"relative h-44 bg-zinc-950 overflow-hidden\">\n                  <img\n                    src={eq.image}\n                    alt={eq.name}\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-85\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-zinc-900 via-transparent to-black/40\" />\n\n                  {/* Status Badge */}\n                  <div className=\"absolute top-3 right-3\">\n                    <span\n                      className={`text-[10px] font-bold px-2.5 py-1 rounded-full border shadow-md backdrop-blur-md ${statusBadge.className}`}\n                    >\n                      {statusBadge.label}\n                    </span>\n                  </div>\n\n                  {/* Serial Number & Category Tag */}\n                  <div className=\"absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] text-zinc-300\">\n                    <span className=\"bg-black/60 px-2 py-0.5 rounded font-mono border border-white/10\">\n                      {eq.serialNumber}\n                    </span>\n                    <span className=\"font-semibold text-amber-400 bg-amber-950/60 px-2 py-0.5 rounded border border-amber-500/30\">\n                      ${eq.dailyRateUSD}/d\303\255a\n                    </span>\n                  </div>\n                </div>\n\n                {/* Body Content */}\n                <div className=\"p-4 space-y-3\">\n                  <div>\n                    <h3 className=\"text-sm font-bold text-white leading-snug group-hover:text-amber-400 transition-colors\">\n                      {eq.name}\n                    </h3>\n                    <p className=\"text-[11px] font-mono text-zinc-400 mt-0.5\">{eq.model}</p>\n                  </div>\n\n                  <p className=\"text-xs text-zinc-300 leading-relaxed bg-zinc-950/60 p-2.5 rounded-xl border border-zinc-800/80\">\n                    {eq.specs}\n                  </p>\n\n                  {/* Upcoming Bookings on this device */}\n                  {activeBookings.length > 0 && (\n                    <div className=\"space-y-1.5 pt-2 border-t border-zinc-800/80 text-[11px]\">\n                      <div className=\"text-[10px] uppercase font-bold text-zinc-500 flex items-center gap-1\">\n                        <Clock className=\"w-3 h-3 text-zinc-400\" />\n                        <span>Fechas Bloqueadas:</span>\n                      </div>\n                      {activeBookings.map((b) => (\n                        <div\n                          key={b.id}\n                          className=\"flex items-center justify-between bg-zinc-950 px-2.5 py-1 rounded border border-zinc-800 text-zinc-300\"\n                        >\n                          <span className=\"truncate max-w-[140px] text-amber-300\">\n                            {b.deliverableTitle}\n                          </span>\n                          <span className=\"font-mono text-zinc-400 text-[10px]\">\n                            {b.startDate} al {b.endDate}\n                          </span>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Card Footer: Action */}\n              <div className=\"p-4 pt-2 border-t border-zinc-800/80\">\n                <button\n                  onClick={() => openBookingModal(eq)}\n                  className=\"w-full flex items-center justify-center gap-2 py-2 rounded-xl bg-zinc-800 hover:bg-amber-600 hover:text-white text-zinc-200 text-xs font-semibold transition-all border border-zinc-700 hover:border-amber-500 shadow-sm\"\n                >\n                  <Calendar className=\"w-3.5 h-3.5\" />\n                  <span>Reservar Hardware / Bloquear Fechas</span>\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Modal: Reserva de Hardware con Detecci\303\263n de Colisiones */}\n      {isBookModalOpen && targetEquipment && (\n        <div className=\"fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-5 animate-in fade-in zoom-in-95\">\n            <div className=\"flex items-center justify-between border-b border-zinc-800 pb-3\">\n              <div>\n                <h3 className=\"text-base font-bold text-white\">Reserva de Hardware Audiovisual</h3>\n                <p className=\"text-xs text-zinc-400\">Verificaci\303\263n autom\303\241tica de colisiones en tiempo real.</p>\n              </div>\n              <button\n                onClick={() => setIsBookModalOpen(false)}\n                className=\"text-zinc-500 hover:text-zinc-300 text-sm font-semibold p-1\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleBookingSubmit} className=\"space-y-4 text-xs\">\n              \n              {/* Equipment Summary Banner */}\n              <div className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800 flex items-center gap-3\">\n                <img\n                  src={targetEquipment.image}\n                  alt={targetEquipment.name}\n                  className=\"w-12 h-12 rounded-lg object-cover ring-1 ring-zinc-700\"\n                />\n                <div>\n                  <h4 className=\"font-bold text-zinc-100\">{targetEquipment.name}</h4>\n                  <p className=\"text-[11px] text-zinc-400 font-mono\">{targetEquipment.model}</p>\n                  <span className=\"text-[10px] text-amber-400 font-semibold font-mono\">\n                    ${targetEquipment.dailyRateUSD} USD / d\303\255a de rodaje\n                  </span>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-zinc-300 font-medium mb-1\">Entregable Asociado al Rodaje *</label>\n                <select\n                  value={selectedDeliverableId}\n                  onChange={(e) => setSelectedDeliverableId(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                >\n                  {deliverables.map((del) => {\n                    const brand = brands.find((b) => b.id === del.brandId);\n                    return (\n                      <option key={del.id} value={del.id}>\n                        [{del.code}] {del.title} ({brand?.name})\n                      </option>\n                    );\n                  })}\n                </select>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-zinc-300 font-medium mb-1\">Fecha Inicio de Rodaje *</label>\n                  <input\n                    type=\"date\"\n                    value={bookStartDate}\n                    onChange={(e) => handleDateChange(e.target.value, bookEndDate)}\n                    className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-zinc-300 font-medium mb-1\">Fecha Fin de Rodaje *</label>\n                  <input\n                    type=\"date\"\n                    value={bookEndDate}\n                    onChange={(e) => handleDateChange(bookStartDate, e.target.value)}\n                    className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                    required\n                  />\n                </div>\n              </div>\n\n              {/* Collision Alert Banner */}\n              {collisionWarning ? (\n                <div className=\"bg-red-500/15 border border-red-500/50 rounded-xl p-3 text-red-300 flex items-start gap-2 animate-pulse\">\n                  <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0 mt-0.5\" />\n                  <div>\n                    <span className=\"font-bold block\">COLISI\303\223N DE RESERVA DETECTADA</span>\n                    <span className=\"text-[11px] leading-tight block mt-0.5\">{collisionWarning}</span>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-2.5 text-emerald-300 flex items-center gap-2\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                  <span className=\"text-[11px] font-medium\">\n                    Hardware disponible sin colisiones para el rango seleccionado.\n                  </span>\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-zinc-300 font-medium mb-1\">Notas de Producci\303\263n & Locaci\303\263n</label>\n                <textarea\n                  value={bookNotes}\n                  onChange={(e) => setBookNotes(e.target.value)}\n                  rows={2}\n                  placeholder=\"Ej: Rodaje en exteriores de pista atl\303\251tica en horario matutino...\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 text-xs\"\n                />\n              </div>\n\n              <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-zinc-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsBookModalOpen(false)}\n                  className=\"px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={!!collisionWarning}\n                  className={`px-5 py-2 rounded-lg text-white font-semibold shadow-md ${\n                    collisionWarning\n                      ? \'bg-zinc-700 cursor-not-allowed opacity-50\'\n                      : \'bg-amber-600 hover:bg-amber-500\'\n                  }`}\n                >\n                  Confirmar Reserva de Hardware\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );"
        replacement_content: "  const getStatusBadge = (status: EquipmentStatus) => {\n    switch (status) {\n      case \'available\':\n        return {\n          label: \'Disponible\',\n          className: \'bg-emerald-50 text-emerald-800 border-emerald-200\',\n        };\n      case \'reserved\':\n        return {\n          label: \'Reservado\',\n          className: \'bg-amber-50 text-amber-800 border-amber-200\',\n        };\n      case \'in_shoot\':\n        return {\n          label: \'En Rodaje Activo\',\n          className: \'bg-rose-50 text-rose-800 border-rose-200\',\n        };\n      case \'maintenance\':\n        return {\n          label: \'Mantenimiento / Calibraci\303\263n\',\n          className: \'bg-slate-100 text-slate-700 border-slate-200\',\n        };\n    }\n  };\n\n  const openBookingModal = (eq: HardwareEquipment) => {\n    setTargetEquipment(eq);\n    setBookStartDate(\'2026-08-25\');\n    setBookEndDate(\'2026-08-27\');\n    setBookNotes(\'\');\n    setCollisionWarning(null);\n    setIsBookModalOpen(true);\n  };\n\n  const handleDateChange = (start: string, end: string) => {\n    setBookStartDate(start);\n    setBookEndDate(end);\n    if (targetEquipment && start && end) {\n      const collision = checkEquipmentCollision(targetEquipment.id, start, end);\n      if (collision.hasCollision) {\n        setCollisionWarning(\n          `\302\241ALERTA DE COLISI\303\223N! Ya existe una reserva para \'${collision.collidingWith?.deliverableTitle}\' del ${collision.collidingWith?.startDate} al ${collision.collidingWith?.endDate}.`\n        );\n      } else {\n        setCollisionWarning(null);\n      }\n    }\n  };\n\n  const handleBookingSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!targetEquipment) return;\n\n    const chosenDel = deliverables.find((d) => d.id === selectedDeliverableId) || deliverables[0];\n    const brand = brands.find((b) => b.id === chosenDel.brandId);\n\n    const res = createEquipmentReservation({\n      equipmentId: targetEquipment.id,\n      deliverableId: chosenDel.id,\n      deliverableTitle: chosenDel.title,\n      brandName: brand?.name || \'Marca\',\n      startDate: bookStartDate,\n      endDate: bookEndDate,\n      reservedById: currentUser.id,\n      reservedByName: currentUser.name,\n      notes: bookNotes,\n    });\n\n    if (!res.success) {\n      alert(res.error);\n      return;\n    }\n\n    setIsBookModalOpen(false);\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      \n      {/* Header & Stats - High Density */}\n      <div className=\"bg-white border border-slate-200 rounded-lg p-3.5 shadow-2xs flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700 shrink-0\">\n            <Camera className=\"w-4.5 h-4.5\" />\n          </div>\n          <div>\n            <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n              <span>Inventario Audiovisual & Reservas</span>\n              <span className=\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 border border-slate-200 font-semibold\">\n                Detecci\303\263n de Colisiones\n              </span>\n            </h2>\n            <p className=\"text-[11px] text-slate-500\">\n              Hardware cinematogr\303\241fico, \303\263pticas cine, audio 32-bit float, iluminaci\303\263n LED y estaciones VFX.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2 text-xs font-mono\">\n          <div className=\"bg-slate-50 px-2.5 py-1 rounded-md border border-slate-200 text-center\">\n            <div className=\"text-slate-500 text-[9px] uppercase font-bold\">Total Equipos</div>\n            <div className=\"text-xs font-bold text-slate-900\">{equipment.length}</div>\n          </div>\n          <div className=\"bg-slate-50 px-2.5 py-1 rounded-md border border-slate-200 text-center\">\n            <div className=\"text-slate-500 text-[9px] uppercase font-bold\">En Rodaje / Reservados</div>\n            <div className=\"text-xs font-bold text-amber-700\">\n              {equipment.filter((e) => e.status !== \'available\').length}\n            </div>\n          </div>\n          <div className=\"bg-slate-50 px-2.5 py-1 rounded-md border border-slate-200 text-center\">\n            <div className=\"text-slate-500 text-[9px] uppercase font-bold\">Disponibles</div>\n            <div className=\"text-xs font-bold text-emerald-700\">\n              {equipment.filter((e) => e.status === \'available\').length}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Filters Bar */}\n      <div className=\"bg-white border border-slate-200 rounded-lg p-2.5 flex flex-wrap items-center justify-between gap-2 shadow-2xs\">\n        <div className=\"flex flex-wrap items-center gap-2\">\n          \n          <div className=\"relative min-w-[200px]\">\n            <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2\" />\n            <input\n              type=\"text\"\n              value={equipmentSearch}\n              onChange={(e) => setEquipmentSearch(e.target.value)}\n              placeholder=\"Buscar modelo, \303\263ptica, serial...\"\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-md pl-8 pr-2.5 py-1 text-xs text-slate-800 placeholder:text-slate-400 focus:ring-1 focus:ring-blue-500 focus:bg-white\"\n            />\n          </div>\n\n          <select\n            value={selectedCategory}\n            onChange={(e) => setSelectedCategory(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 text-xs text-slate-700 rounded-md px-2.5 py-1 focus:ring-1 focus:ring-blue-500 cursor-pointer\"\n          >\n            {categories.map((c) => (\n              <option key={c.id} value={c.id}>\n                {c.name}\n              </option>\n            ))}\n          </select>\n\n          <select\n            value={selectedStatus}\n            onChange={(e) => setSelectedStatus(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 text-xs text-slate-700 rounded-md px-2.5 py-1 focus:ring-1 focus:ring-blue-500 cursor-pointer\"\n          >\n            <option value=\"all\">Todos los Estados</option>\n            <option value=\"available\">Disponibles</option>\n            <option value=\"reserved\">Reservados</option>\n            <option value=\"in_shoot\">En Rodaje</option>\n            <option value=\"maintenance\">Mantenimiento</option>\n          </select>\n        </div>\n\n        <span className=\"text-[11px] text-slate-500 font-mono\">\n          {filteredEquipment.length} dispositivos mostrados\n        </span>\n      </div>\n\n      {/* Equipment Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3\">\n        {filteredEquipment.map((eq) => {\n          const statusBadge = getStatusBadge(eq.status);\n          const activeBookings = reservations.filter((r) => r.equipmentId === eq.id && r.status === \'confirmed\');\n\n          return (\n            <div\n              key={eq.id}\n              className=\"bg-white border border-slate-200 hover:border-slate-300 rounded-lg overflow-hidden shadow-2xs flex flex-col justify-between group transition-all\"\n            >\n              <div>\n                {/* Equipment Image with Category Overlay */}\n                <div className=\"relative h-36 bg-slate-100 overflow-hidden border-b border-slate-100\">\n                  <img\n                    src={eq.image}\n                    alt={eq.name}\n                    className=\"w-full h-full object-cover group-hover:scale-102 transition-transform duration-300\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-black/20\" />\n\n                  {/* Status Badge */}\n                  <div className=\"absolute top-2 right-2\">\n                    <span\n                      className={`text-[9px] font-bold px-2 py-0.5 rounded-full border shadow-2xs backdrop-blur-xs ${statusBadge.className}`}\n                    >\n                      {statusBadge.label}\n                    </span>\n                  </div>\n\n                  {/* Serial Number & Daily Rate Tag */}\n                  <div className=\"absolute bottom-2 left-2 right-2 flex items-center justify-between text-[10px] text-white\">\n                    <span className=\"bg-slate-900/80 px-1.5 py-0.2 rounded font-mono border border-white/20\">\n                      {eq.serialNumber}\n                    </span>\n                    <span className=\"font-bold text-amber-300 bg-slate-900/80 px-1.5 py-0.2 rounded border border-white/20\">\n                      ${eq.dailyRateUSD}/d\303\255a\n                    </span>\n                  </div>\n                </div>\n\n                {/* Body Content */}\n                <div className=\"p-3 space-y-2\">\n                  <div>\n                    <h3 className=\"text-xs font-bold text-slate-900 leading-snug group-hover:text-blue-600 transition-colors\">\n                      {eq.name}\n                    </h3>\n                    <p className=\"text-[10px] font-mono text-slate-500 mt-0.2\">{eq.model}</p>\n                  </div>\n\n                  <p className=\"text-[11px] text-slate-600 leading-relaxed bg-slate-50 p-2 rounded-md border border-slate-100\">\n                    {eq.specs}\n                  </p>\n\n                  {/* Upcoming Bookings on this device */}\n                  {activeBookings.length > 0 && (\n                    <div className=\"space-y-1 pt-1 border-t border-slate-100 text-[10px]\">\n                      <div className=\"text-[9px] uppercase font-bold text-slate-500 flex items-center gap-1\">\n                        <Clock className=\"w-3 h-3 text-slate-400\" />\n                        <span>Fechas Bloqueadas:</span>\n                      </div>\n                      {activeBookings.map((b) => (\n                        <div\n                          key={b.id}\n                          className=\"flex items-center justify-between bg-slate-50 px-2 py-0.5 rounded border border-slate-200 text-slate-700\"\n                        >\n                          <span className=\"truncate max-w-[130px] font-medium text-amber-800\">\n                            {b.deliverableTitle}\n                          </span>\n                          <span className=\"font-mono text-slate-500 text-[9px]\">\n                            {b.startDate} al {b.endDate}\n                          </span>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Card Footer: Action */}\n              <div className=\"p-3 pt-0\">\n                <button\n                  onClick={() => openBookingModal(eq)}\n                  className=\"w-full flex items-center justify-center gap-1.5 py-1.5 rounded-md bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-800 text-xs font-semibold transition-all border border-slate-200 hover:border-amber-300 cursor-pointer\"\n                >\n                  <Calendar className=\"w-3.5 h-3.5\" />\n                  <span>Reservar Hardware / Fechas</span>\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Modal: Reserva de Hardware con Detecci\303\263n de Colisiones */}\n      {isBookModalOpen && targetEquipment && (\n        <div className=\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4\">\n          <div className=\"bg-white border border-slate-200 rounded-xl max-w-lg w-full p-5 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 text-slate-800\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-2.5\">\n              <div>\n                <h3 className=\"text-sm font-bold text-slate-900\">Reserva de Hardware Audiovisual</h3>\n                <p className=\"text-[11px] text-slate-500\">Verificaci\303\263n autom\303\241tica de colisiones en tiempo real.</p>\n              </div>\n              <button\n                onClick={() => setIsBookModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-700 text-sm font-bold p-1 cursor-pointer\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleBookingSubmit} className=\"space-y-3 text-xs\">\n              \n              {/* Equipment Summary Banner */}\n              <div className=\"bg-slate-50 p-2.5 rounded-lg border border-slate-200 flex items-center gap-2.5\">\n                <img\n                  src={targetEquipment.image}\n                  alt={targetEquipment.name}\n                  className=\"w-10 h-10 rounded-md object-cover ring-1 ring-slate-200\"\n                />\n                <div>\n                  <h4 className=\"font-bold text-slate-900\">{targetEquipment.name}</h4>\n                  <p className=\"text-[10px] text-slate-500 font-mono\">{targetEquipment.model}</p>\n                  <span className=\"text-[10px] text-amber-700 font-bold font-mono\">\n                    ${targetEquipment.dailyRateUSD} USD / d\303\255a de rodaje\n                  </span>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-slate-700 font-semibold mb-1\">Entregable Asociado al Rodaje *</label>\n                <select\n                  value={selectedDeliverableId}\n                  onChange={(e) => setSelectedDeliverableId(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white cursor-pointer\"\n                >\n                  {deliverables.map((del) => {\n                    const brand = brands.find((b) => b.id === del.brandId);\n                    return (\n                      <option key={del.id} value={del.id}>\n                        [{del.code}] {del.title} ({brand?.name})\n                      </option>\n                    );\n                  })}\n                </select>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <div>\n                  <label className=\"block text-slate-700 font-semibold mb-1\">Fecha Inicio de Rodaje *</label>\n                  <input\n                    type=\"date\"\n                    value={bookStartDate}\n                    onChange={(e) => handleDateChange(e.target.value, bookEndDate)}\n                    className=\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-700 font-semibold mb-1\">Fecha Fin de Rodaje *</label>\n                  <input\n                    type=\"date\"\n                    value={bookEndDate}\n                    onChange={(e) => handleDateChange(bookStartDate, e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\"\n                    required\n                  />\n                </div>\n              </div>\n\n              {/* Collision Alert Banner */}\n              {collisionWarning ? (\n                <div className=\"bg-red-50 border border-red-200 rounded-lg p-2.5 text-red-900 flex items-start gap-2\">\n                  <AlertTriangle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n                  <div>\n                    <span className=\"font-bold block text-xs\">COLISI\303\223N DE RESERVA DETECTADA</span>\n                    <span className=\"text-[11px] leading-tight block mt-0.5\">{collisionWarning}</span>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"bg-emerald-50 border border-emerald-200 rounded-lg p-2 text-emerald-900 flex items-center gap-2\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span className=\"text-[11px] font-medium\">\n                    Hardware disponible sin colisiones para el rango seleccionado.\n                  </span>\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-slate-700 font-semibold mb-1\">Notas de Producci\303\263n & Locaci\303\263n</label>\n                <textarea\n                  value={bookNotes}\n                  onChange={(e) => setBookNotes(e.target.value)}\n                  rows={2}\n                  placeholder=\"Ej: Rodaje en exteriores de pista atl\303\251tica en horario matutino...\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-md px-2.5 py-1.5 text-slate-800 text-xs focus:ring-1 focus:ring-blue-500 focus:bg-white\"\n                />\n              </div>\n\n              <div className=\"flex items-center justify-end gap-2 pt-3 border-t border-slate-100\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsBookModalOpen(false)}\n                  className=\"px-3 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold cursor-pointer\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={!!collisionWarning}\n                  className={`px-4 py-1.5 rounded-md text-white font-semibold shadow-xs cursor-pointer ${\n                    collisionWarning\n                      ? \'bg-slate-400 cursor-not-allowed opacity-50\'\n                      : \'bg-amber-600 hover:bg-amber-700\'\n                  }`}\n                >\n                  Confirmar Reserva de Hardware\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
