# ==============================================================================
# N. Studios OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your Supabase credentials.
# On Vercel: Add these variables under Project Settings -> Environment Variables.

# Supabase URL & Public Anon Key (Required for client application)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Administrative Secret Key (Optional / Backend & Migrations only - NEVER expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
